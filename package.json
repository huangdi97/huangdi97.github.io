{
  "name": "haolei-personal-ai-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hao Lei — Personal AI Lab. Building intelligent systems for discovery, health, simulation and autonomous work.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "assets": "node scripts/generate-assets.mjs",
    "build": "npm run assets && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "verify": "node scripts/verify-build.mjs",
    "theme": "node scripts/check-theme-system.mjs",
    "artifacts": "node scripts/check-artifacts.mjs",
    "science": "node scripts/check-science-copy.mjs",
    "visual": "node scripts/check-visual-system.mjs",
    "identity": "node scripts/check-public-identity.mjs",
    "resume:pdf": "npm run build && node scripts/generate-resume-pdfs.mjs",
    "gate": "npm run lint && npm run typecheck && npm run build && npm run verify && npm run theme && npm run artifacts && npm run science && npm run visual && npm run identity && npm run test"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.50.0",
    "@resvg/resvg-js": "^2.6.2",
    "@typescript-eslint/parser": "^8.24.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^15.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.17.1"
  }
}
