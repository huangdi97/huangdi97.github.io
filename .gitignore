# Testing artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
.qa-screens/

# Works QA fixtures (v2.3)
# `npm run qa:works` generates these, builds under the `works-preview` mode, and
# deletes them again. They are scaffolding for the screenshot set, not content:
# §83 allows them for QA and forbids them from a production page. Ignoring them
# is the backstop for the case where the script is interrupted before cleanup —
# `scripts/check-works.mjs` is the other one.
src/content/works/*/_qa-*.md
public/images/works/qa-*.webp

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local scratch files (audit / build captures)
_*.log
_*.txt
_*.py
_*.mjs
# `chkver-*` is the established name for before/after comparison captures
# (`git show HEAD:<file> > chkver-<name>`, or a snapshot of `dist/`). They are
# evidence for one round, not source, so they stay out of the repository.
chkver-*.mjs
chkver-*/

# Workspace agent data
.workbuddy/
.workbuddy-ai/

