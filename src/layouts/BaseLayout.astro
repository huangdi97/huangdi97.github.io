---
import '../styles/global.css';
import { useT, type Lang } from '../i18n/ui';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ScientificEditorialBackground, {
  type BackgroundMode,
} from '../components/visual/ScientificEditorialBackground.astro';
import { ART_SIZES } from '../data/artwork';
import { artworkAsset, largestOf, srcsetFor, type ArtworkSlot } from '../lib/artworkAsset';

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  enPath: string;
  zhPath: string;
  ogImage?: string;
  /** Declared size of `ogImage`. Forwarded to `Seo`; see the note there. */
  ogImageWidth?: number;
  ogImageHeight?: number;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Verbatim <title> override, forwarded to Seo. */
  seoTitle?: string;
  /** Withhold the page from indexing. Used for print-only variants. */
  noindex?: boolean;
  /**
   * v2.3.1 §1/§8: keep following this page's links while it is withheld.
   *
   * Only the dormant Works index sets it. See `Seo.astro` for why the two are
   * separate flags rather than one.
   */
  follow?: boolean;
  /** Pages that should not show the footer CTA spacer. */
  mainClass?: string;
  /**
   * v1.7 prototype: the homepage footer carries identity, preferences and
   * copyright only. Inner pages keep the contact row, which is their only
   * contact surface.
   */
  minimalFooter?: boolean;
  /**
   * How much atmosphere this page gets (§33–§34, re-layered in v2.2.1).
   *
   * A mode is a whole variant, not just a density: the mark set, the placement
   * of every mark and the depth of the wash all move with it, because a site
   * whose pages differ only in opacity does not have a hierarchy — it has one
   * background with the dial nudged. `home` is the default, which is what the
   * homepage and the project case studies get.
   *
   *   home        medium       homepage and case studies
   *   projects    medium-low   the curated directory — /projects
   *   research    medium-high  the richest field — /research
   *   about       medium-low   quieter, notebook-leaning — /about
   *   resume      very low     one notation fragment — /resume
   *   opensource  low          reserved; no route mounts it today
   *   minimal     wash + grain only, no marks — 404
   */
  backgroundMode?: BackgroundMode;
  /**
   * The slot whose raster file is this page's LCP image, if any (§25).
   *
   * Only ever set to the one image that actually paints above the fold: the
   * homepage hero, and the /research and /about bands. Preloading anything
   * below the fold would spend bandwidth on a file the browser is going to
   * discover on its own — and the brief is explicit that the whole site must
   * not preload its artwork.
   *
   * The descriptor list and `sizes` come from the same data `Artwork.astro`
   * uses, so the preload and the `<img>` cannot disagree. A preload whose
   * candidate list differs from the image's by one descriptor makes the browser
   * fetch the picture twice, which is worse than not preloading.
   */
  preloadArtwork?: ArtworkSlot;
}

const {
  title,
  description,
  lang,
  path,
  enPath,
  zhPath,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  type,
  jsonLd,
  seoTitle,
  noindex = false,
  follow = false,
  mainClass,
  minimalFooter = false,
  backgroundMode = 'home',
  preloadArtwork,
} = Astro.props;

const t = useT(lang);
const htmlLang = lang === 'zh' ? 'zh-Hans' : 'en';

/* Resolved once, here, and used for both the preload and nothing else — the
   `<img>` builds its own list from the same helpers. */
const preloadAsset = preloadArtwork ? artworkAsset(preloadArtwork) : null;
const preloadSrcset = preloadAsset ? srcsetFor(preloadAsset.variants) : undefined;
const preloadHref = preloadAsset ? (largestOf(preloadAsset.variants)?.src ?? preloadAsset.src) : null;
const preloadSizes = preloadArtwork ? ART_SIZES[preloadArtwork] : undefined;
---

<!doctype html>
<html lang={htmlLang} data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F0EEE8" />

    <!-- Runs before any stylesheet: sets data-theme and, when the stored
         language preference disagrees with this path, swaps locale. -->
    <ThemeInit />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- §25: the page's own LCP image and nothing else. When the slot has a
         responsive set, the preload carries the same descriptors and the same
         `sizes` the `<img>` will, so the browser commits to one candidate
         instead of starting a second fetch when it reaches the markup. -->
    {
      preloadHref && (
        <link
          rel="preload"
          as="image"
          href={preloadHref}
          imagesrcset={preloadSrcset}
          imagesizes={preloadSrcset ? preloadSizes : undefined}
          type="image/webp"
          fetchpriority="high"
        />
      )
    }

    <Seo
      title={title}
      description={description}
      lang={lang}
      path={path}
      enPath={enPath}
      zhPath={zhPath}
      ogImage={ogImage}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      type={type}
      jsonLd={jsonLd}
      seoTitle={seoTitle}
      noindex={noindex}
      follow={follow}
    />

    <script is:inline>
      // Progressive enhancement flag: reveals only animate when JS is present.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- Atmosphere for the whole document: a gradient paper, a small tiling
         grain, and a few scientific fragments. Absolute, document-level, inert
         and decorative — it scrolls with the page and is hidden from assistive
         technology.

         v2.2 (§33–§34) mounts it on every route, the homepage included. The
         v1.7 canvas it replaces was mounted *except* on the homepage, which is
         how the owner ended up looking at a page whose only visual was a raster
         file that had not arrived yet. -->
    <ScientificEditorialBackground mode={backgroundMode} />

    <a href="#main" class="skip-link">{t('nav.skip')}</a>

    <Header lang={lang} />

    <main id="main" class:list={['flex-1', mainClass]}>
      <slot />
    </main>

    <Footer lang={lang} minimal={minimalFooter} />

    <script>
      // Language preference. The switch stays a plain link so it works with
      // JavaScript off; this only records the choice, so a later visit to the
      // root lands in the same locale instead of the default one.
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
        link.addEventListener('click', () => {
          const target = link.dataset.langTarget;
          if (target !== 'zh' && target !== 'en') return;
          try {
            localStorage.setItem('haoleilab-language', target);
          } catch {
            /* Storage blocked: the click still navigates. */
          }
        });
      });
    </script>

    <script>
      // Scroll reveal — opt-in, and inert under prefers-reduced-motion.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 200;
        background: var(--ink);
        color: var(--canvas);
        padding: 0.75rem 1.25rem;
        border-radius: 2px;
        font-size: 0.875rem;
        transition: top var(--dur-fast) var(--ease);
      }

      .skip-link:focus-visible {
        top: 1rem;
      }
    </style>
  </body>
</html>
