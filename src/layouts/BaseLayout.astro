---
import '../styles/global.css';
import { useT, type Lang } from '../i18n/ui';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ScientificAmbient from '../components/ScientificAmbient.astro';

export interface Props {
  title: string;
  description: string;
  lang: Lang;
  path: string;
  enPath: string;
  zhPath: string;
  ogImage?: string;
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Verbatim <title> override, forwarded to Seo. */
  seoTitle?: string;
  /** Withhold the page from indexing. Used for print-only variants. */
  noindex?: boolean;
  /** Pages that should not show the footer CTA spacer. */
  mainClass?: string;
}

const {
  title,
  description,
  lang,
  path,
  enPath,
  zhPath,
  ogImage,
  type,
  jsonLd,
  seoTitle,
  noindex = false,
  mainClass,
} = Astro.props;

const t = useT(lang);
const htmlLang = lang === 'zh' ? 'zh-Hans' : 'en';
---

<!doctype html>
<html lang={htmlLang} data-theme="paper">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F0EEE8" />

    <!-- Runs before any stylesheet: sets data-theme and, when the stored
         language preference disagrees with this path, swaps locale. -->
    <ThemeInit />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <Seo
      title={title}
      description={description}
      lang={lang}
      path={path}
      enPath={enPath}
      zhPath={zhPath}
      ogImage={ogImage}
      type={type}
      jsonLd={jsonLd}
      seoTitle={seoTitle}
      noindex={noindex}
    />

    <script is:inline>
      // Progressive enhancement flag: reveals only animate when JS is present.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- Atmosphere for the whole document: mathematics, biology and AI behind
         every section. Decorative only — hidden from assistive technology. -->
    <ScientificAmbient zone="page" />

    <a href="#main" class="skip-link">{t('nav.skip')}</a>

    <Header lang={lang} />

    <main id="main" class:list={['flex-1', mainClass]}>
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      // Language preference. The switch stays a plain link so it works with
      // JavaScript off; this only records the choice, so a later visit to the
      // root lands in the same locale instead of the default one.
      document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
        link.addEventListener('click', () => {
          const target = link.dataset.langTarget;
          if (target !== 'zh' && target !== 'en') return;
          try {
            localStorage.setItem('haoleilab-language', target);
          } catch {
            /* Storage blocked: the click still navigates. */
          }
        });
      });
    </script>

    <script>
      // Scroll reveal — opt-in, and inert under prefers-reduced-motion.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 200;
        background: var(--ink);
        color: var(--canvas);
        padding: 0.75rem 1.25rem;
        border-radius: 2px;
        font-size: 0.875rem;
        transition: top var(--dur-fast) var(--ease);
      }

      .skip-link:focus-visible {
        top: 1rem;
      }
    </style>
  </body>
</html>
