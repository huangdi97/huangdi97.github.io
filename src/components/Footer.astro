---
/**
 * Footer — theme-continuous, and minimal wherever the page carries its own
 * contact surface (v1.7, extended in v2.2.1).
 *
 * v1.6 removed the forced `night` class that made every page end in a black
 * block. v1.7 removes two more things from the foot of the page:
 *
 *   1. the scientific coda (∂x/∂t · gene → pathway → phenotype · z(t+1)).
 *      The global canvas already runs to the last line, so the coda was the
 *      same idea said twice, in the one place the page should be quietest;
 *   2. on the homepage, the contact row. The homepage already lists Gmail, QQ,
 *      GitHub and Resume in its contact band, and repeating four addresses
 *      inside one screen is not "more contact", it is noise.
 *
 * v2.2.1 (§49) asks the same question of the whole site, and the answer is that
 * three pages carry a contact surface of their own: the homepage, /about (which
 * closes on a contact section) and /resume (which prints the details in its
 * head and again in its contact block). On those three the footer row was a
 * third copy of the same four links, so all three now pass `minimal`.
 *
 * Everywhere else the contact row stays: on /projects, /research and the case
 * studies the footer is the only contact surface, and it is the reason the
 * identity gate can assert one fixed order everywhere.
 */
import { useT, type Lang } from '../i18n/ui';
import { SITE } from '../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import ContactLinks from './ContactLinks.astro';

export interface Props {
  lang: Lang;
  /**
   * Identity, preferences and copyright only — no contact row. Set on the three
   * pages that already carry their own contact surface (§49): `/`, `/about/`
   * and `/resume/`.
   */
  minimal?: boolean;
}

const { lang, minimal = false } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer no-print mt-auto">
  <div class="shell footer-inner">
    <div class="footer-band">
      <div class="footer-identity">
        <p class="footer-mark">HAO LEI</p>
        <p class="footer-tagline">{SITE.tagline}</p>
      </div>

      <div class="footer-prefs">
        <LanguageSwitcher lang={lang} variant="footer" />
        <span class="footer-divider" aria-hidden="true"></span>
        <ThemeSwitcher lang={lang} variant="inline" />
      </div>
    </div>

    <div class:list={['footer-band', 'footer-band-contact', minimal && 'footer-band-solo']}>
      {!minimal && <ContactLinks lang={lang} variant="row" />}

      <p class="footer-copy">
        © {year} Hao Lei — {t('footer.rights')}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Transparent on purpose: the canvas the page has been drawn on continues
       to the last line. A theme swap is the only thing that changes it. */
    background: transparent;
    border-top: 1px solid var(--line);
    color: var(--ink);
    position: relative;
  }

  .footer-inner {
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
  }

  .footer-band {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .footer-band-contact {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .footer-identity {
    min-width: 0;
  }

  .footer-mark {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer-tagline {
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .footer-prefs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .footer-divider {
    width: 1px;
    height: 1rem;
    background: var(--line-strong);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  /* Minimal footer: one rule, and the copyright alone on it. */
  .footer-band-solo {
    justify-content: flex-end;
  }

  @media (max-width: 640px) {
    .footer-copy {
      display: none;
    }

    /* The contact row is what makes the copyright droppable on a phone. When
       there is no contact row, the copyright is the whole band. */
    .footer-band-solo .footer-copy {
      display: block;
    }
  }
</style>
