---
/**
 * Selected Public Work — the one inverted block on the site, and a list.
 *
 * It used to be a five-tile mosaic of repository trees, terminal transcripts and
 * metric dumps. Every item in it was real and every item was checkable, and it
 * still did not belong on /projects: at 2,875px it was **44% of the page**, and
 * a visitor arriving at "what have you built" met a directory listing before
 * they met the four projects. The page's job is the work; the evidence is the
 * footnote, not the chapter.
 *
 * So the room is a list now — three entries, one line each, the same
 * provenance on every row (project, what the artifact is, one sentence of
 * context, the source file it was read from, and the day it was read), and one
 * link out to everything else. The `tree`, `terminal` and metric bodies are no
 * longer rendered anywhere on this page: a repository tree is not something a
 * visitor needs in order to decide whether to open the repository.
 *
 * Nothing was deleted from `src/data/artifacts.ts`. The table is the record and
 * it stays whole; what changed is how much of it the page prints. The ids below
 * are the selection, and they are listed here rather than flagged in the data
 * because which three are shown is a presentation decision that should be
 * visible in one place.
 */
import { useT, type Lang } from '../i18n/ui';
import { ARTIFACTS, ARTIFACT_TYPE_LABELS, type Artifact } from '../data/artifacts';
import { SITE } from '../config/site';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

/**
 * Three, not five: one acceptance artifact, one repository artifact and one
 * command artifact, across three different projects. Chosen so the three rows
 * answer three different questions — "is it reproducible", "is the code real",
 * "does it run" — rather than showing the same kind of evidence three times.
 */
const SELECTED_IDS = ['hycell-acceptance-contract', 'wennian-repository-index', 'biopulse-agent-gateway'];

const selected = SELECTED_IDS.map((id) => ARTIFACTS.find((a) => a.id === id)).filter(
  (a): a is Artifact => Boolean(a),
);
---

<section class="artifact-room ar-section" id="artifacts">
  <div class="shell">
    <div class="ar-head">
      <p class="eyebrow ar-eyebrow">{t('artifacts.eyebrow')}</p>
      <h2 class="h2 ar-heading">{t('artifacts.title')}</h2>
      <p class="ar-lead">{t('artifacts.lead')}</p>
    </div>

    <ul class="ar-list">
      {
        selected.map((artifact) => (
          <li class="ar-row" data-artifact={artifact.id}>
            <p class="ar-project">
              <span class="ar-project-name mono">{artifact.project[lang]}</span>
              <span class="ar-type mono">{ARTIFACT_TYPE_LABELS[artifact.type][lang]}</span>
            </p>
            <div class="ar-body">
              <h3 class="ar-title">{artifact.title[lang]}</h3>
              <p class="ar-caption">{artifact.caption[lang]}</p>
            </div>
            <div class="ar-meta">
              <a
                class="ar-meta-v ar-source"
                href={artifact.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {artifact.source[lang]}
                <span class="ar-ext" aria-hidden="true">↗</span>
                <span class="sr-only"> ({t('a11y.external')})</span>
              </a>
              <span class="ar-meta-row">
                <span class="ar-meta-k mono">{t('artifacts.date')}</span>
                <span class="ar-meta-v mono">{artifact.date}</span>
              </span>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="ar-foot">
      <a class="ar-all-link" href={SITE.github} target="_blank" rel="noopener noreferrer">
        {t('artifacts.all')}
        <span aria-hidden="true">→</span>
        <span class="sr-only"> ({t('a11y.external')})</span>
      </a>
      <p class="ar-footnote">{t('artifacts.footnote')}</p>
    </div>
  </div>
</section>

<style>
  .ar-section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .ar-head {
    max-width: 60ch;
  }

  /* The trailing rule on an inverted surface would read as a scratch. */
  .ar-eyebrow::after {
    display: none;
  }

  .ar-heading {
    margin-top: 0.75rem;
  }

  .ar-lead {
    margin-top: 0.875rem;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.55;
    color: var(--artifact-muted);
    max-width: 56ch;
  }

  /* A list, not a mosaic: three rows, one hairline each. The shape is borrowed
     from the "other work" index on the same page, so the page keeps one rhythm
     instead of two. */
  .ar-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .ar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--artifact-line);
  }

  .ar-row:last-child {
    border-bottom: 1px solid var(--artifact-line);
  }

  @media (min-width: 860px) {
    .ar-row {
      grid-template-columns: minmax(0, 12rem) minmax(0, 1fr) minmax(0, 20rem);
      gap: 0.5rem 2rem;
      align-items: start;
    }
  }

  .ar-project {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ar-project-name {
    font-size: 0.75rem;
    color: var(--artifact-ink);
    letter-spacing: 0.06em;
  }

  .ar-body {
    min-width: 0;
  }

  .ar-title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
    letter-spacing: -0.018em;
    font-weight: 500;
    color: var(--artifact-ink);
  }

  .ar-caption {
    margin: 0.375rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--artifact-muted);
    max-width: 62ch;
  }

  .ar-meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .ar-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    align-items: baseline;
  }

  .ar-meta-k {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--artifact-faint);
  }

  .ar-meta-v {
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--artifact-muted);
    min-width: 0;
  }

  .ar-source {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem;
    text-decoration: none;
  }

  .ar-source:hover {
    color: var(--artifact-ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .ar-ext {
    font-size: 0.75em;
  }

  .ar-type {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--artifact-faint);
  }

  .ar-foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
  }

  .ar-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--artifact-ink);
  }

  .ar-all-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .ar-footnote {
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--artifact-faint);
    max-width: 68ch;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
