---
import type { Lang } from '../i18n/ui';
import { localizedPath } from '../i18n/ui';
import type { ResearchArea } from '../data/research';
import { getProjectEvidence } from '../data/evidence';

/**
 * One research direction row.
 *
 * The small state next to each linked project is read from `evidence.ts` rather
 * than written here, so a direction that points at TaiYi cannot be decorated
 * with anything other than what that project's own truth table says.
 */

export interface Props {
  area: ResearchArea;
  lang: Lang;
}

const { area, lang } = Astro.props;

const stateOf = (href: string) => {
  const slug = href.replace(/\/+$/, '').split('/').pop() ?? '';
  return getProjectEvidence(slug)?.headline[lang] ?? null;
};
---

<li>
  <a href={`${localizedPath(lang, '/research')}#${area.slug}`} class="research-row">
    <span class="index-num">{area.index}</span>
    <span class="research-row-title">{area.title}</span>
    <span class="research-row-body">
      <span class="research-row-question">{area.question}</span>
      <span class="research-row-projects">
        {area.projects.map((project) => (
          <span class="rlink">
            <span class="rlink-label">{project.label}</span>
            {stateOf(project.href) && <span class="rlink-state">{stateOf(project.href)}</span>}
          </span>
        ))}
      </span>
    </span>
    <span class="research-row-arrow" aria-hidden="true">
      →
    </span>
  </a>
</li>

<style>
  .research-row {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    padding: 1.375rem 0;
    border-bottom: 1px solid var(--line);
    transition: background-color var(--dur-base) var(--ease);
  }

  @media (min-width: 900px) {
    .research-row {
      grid-template-columns: 3rem 16rem minmax(0, 1fr) 2rem;
      align-items: baseline;
      gap: 2rem;
    }
  }

  .research-row:hover {
    background: rgba(0, 0, 0, 0.015);
  }

  .research-row-title {
    font-size: 1.125rem;
    letter-spacing: -0.018em;
  }

  .research-row-question {
    display: block;
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 60ch;
  }

  .research-row-arrow {
    display: none;
    color: var(--faint);
    transition: transform var(--dur-base) var(--ease);
  }

  @media (min-width: 900px) {
    .research-row-arrow {
      display: block;
      grid-column: 4;
      text-align: right;
    }

    .research-row:hover .research-row-arrow {
      transform: translateX(4px);
      color: var(--ink);
    }
  }

  .research-row-body {
    grid-column: 2;
  }

  @media (min-width: 900px) {
    .research-row-body {
      grid-column: 3;
    }
  }

  .research-row-projects {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.625rem;
  }

  .rlink {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
  }

  .rlink-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .rlink-state {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .rlink-state::before {
    content: '· ';
  }
</style>
