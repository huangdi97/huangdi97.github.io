---
import { useT, type Lang } from '../i18n/ui';
import Tag from './Tag.astro';
import ProjectCover from './ProjectCover.astro';
import { projectHref, type ProjectEntry } from '../lib/projects';
import { getProjectEvidence } from '../data/evidence';

export interface Props {
  project: ProjectEntry;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useT(lang);
const d = project.data;

const href = projectHref(lang, d.slug);
const statusKey = `status.${d.status.toLowerCase()}`;

/** Keeps the index page honest about how finished each project really is. */
const evidence = getProjectEvidence(d.slug);
const realityLabel = evidence
  ? evidence.publicCode === 'open'
    ? t('publiccode.open')
    : t('publiccode.none')
  : null;
---

<article class="pcard" data-groups={d.groups.join(' ')} data-slug={d.slug}>
  <div class="pcard-cover">
    <ProjectCover project={project} lang={lang} layout="card" index={index} />
  </div>

  <div class="pcard-body">
    <p class="body-muted pcard-desc">{d.description}</p>

    {
      evidence && (
        <p class="pcard-reality">
          <span class="reality-pill" data-code={evidence.publicCode}>
            {evidence.headline[lang]}
          </span>
          <span class="reality-code">{realityLabel}</span>
        </p>
      )
    }

    {
      d.tags.length > 0 && (
        <ul class="pcard-tags">
          {d.tags.map((tag) => (
            <li>
              <Tag text={tag} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="pcard-actions">
      <a href={href} class="link-arrow">
        {t('work.case')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      {
        d.repo && (
          <a href={d.repo} class="link-arrow" target="_blank" rel="noopener noreferrer">
            {t('work.repo')}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        )
      }
      <span class="pcard-status">{t(statusKey)}</span>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    transition:
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .pcard:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }

  .pcard[hidden] {
    display: none;
  }

  .pcard-cover {
    padding: clamp(1.125rem, 2.5vw, 1.75rem);
    border-bottom: 1px solid var(--line);
  }

  .pcard-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.5rem;
  }

  .pcard-desc {
    margin: 0;
    font-size: 0.9375rem;
  }

  .pcard-reality {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 1.125rem 0 0;
  }

  .reality-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    border: 1px solid var(--line-strong);
    background: rgba(0, 0, 0, 0.035);
    color: var(--ink);
  }

  .reality-pill[data-code='none'] {
    border-style: dashed;
    background: transparent;
    color: var(--muted);
  }

  .reality-code {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .pcard-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .pcard-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .pcard-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
    margin-left: auto;
  }
</style>
