---
import { switchLocalePath, useT, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  /** `header` renders a compact control; `footer` renders a plain link. */
  variant?: 'header' | 'footer';
}

const { lang, variant = 'header' } = Astro.props;
const t = useT(lang);

const target: Lang = lang === 'zh' ? 'en' : 'zh';
const href = switchLocalePath(Astro.url.pathname, target);
const label = target === 'zh' ? '中文' : 'EN';
const ariaLabel = `${t('nav.language')}: ${target === 'zh' ? '中文' : 'English'}`;
---

<a
  href={href}
  hreflang={target === 'zh' ? 'zh-Hans' : 'en'}
  lang={target === 'zh' ? 'zh-Hans' : 'en'}
  aria-label={ariaLabel}
  data-lang-switch
  class:list={[
    'inline-flex items-center justify-center font-mono uppercase tracking-[0.12em] transition-colors duration-150',
    variant === 'header'
      ? 'min-h-[44px] min-w-[44px] px-2 text-[11px] text-muted hover:text-ink'
      : 'min-h-[44px] px-1 text-[11px] text-muted hover:text-ink',
  ]}
>
  {label}
</a>
