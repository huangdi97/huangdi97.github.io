---
/**
 * Language switcher.
 *
 * In the header this is a small cluster — the active locale marked, the other
 * one offered as a link — sitting next to the appearance control. In the footer
 * it collapses to a single link.
 *
 * Clicking it records the choice in localStorage so the next visit opens in
 * that language; the switch always keeps the current page, never returns the
 * visitor to a home page in the wrong section.
 */
import { switchLocalePath, useT, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
  /** `header` renders the 中文 / EN cluster; `footer` renders a plain link. */
  variant?: 'header' | 'footer';
}

const { lang, variant = 'header' } = Astro.props;
const t = useT(lang);

const target: Lang = lang === 'zh' ? 'en' : 'zh';
const href = switchLocalePath(Astro.url.pathname, target);
const label = target === 'zh' ? '中文' : 'EN';
const current = lang === 'zh' ? '中文' : 'EN';
const ariaLabel = `${t('nav.language')}: ${target === 'zh' ? '中文' : 'English'}`;
---

{
  variant === 'header' ? (
    <div class="inline-flex items-center gap-1 font-mono uppercase tracking-[0.12em] text-[11px]">
      <span class="inline-flex min-h-[44px] items-center px-1 text-ink" aria-current="true">
        {current}
      </span>
      <span class="text-faint" aria-hidden="true">
        /
      </span>
      <a
        href={href}
        hreflang={target === 'zh' ? 'zh-Hans' : 'en'}
        lang={target === 'zh' ? 'zh-Hans' : 'en'}
        aria-label={ariaLabel}
        data-lang-switch
        data-lang-target={target}
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center px-1 text-muted transition-colors duration-150 hover:text-ink"
      >
        {label}
      </a>
    </div>
  ) : (
    <a
      href={href}
      hreflang={target === 'zh' ? 'zh-Hans' : 'en'}
      lang={target === 'zh' ? 'zh-Hans' : 'en'}
      aria-label={ariaLabel}
      data-lang-switch
      data-lang-target={target}
      class="inline-flex min-h-[44px] items-center justify-center px-1 font-mono text-[11px] uppercase tracking-[0.12em] text-muted transition-colors duration-150 hover:text-ink"
    >
      {label}
    </a>
  )
}
