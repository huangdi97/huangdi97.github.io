---
/**
 * Gene × cell matrix — conceptual.
 *
 * An abstract rendering of what high-dimensional biological observation looks
 * like before any model touches it. No gene names, no colour scale, no
 * numbers: a reviewer should never be able to mistake this for a heatmap of a
 * real experiment.
 */
import { useT, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const COLS = 26;
const ROWS = 12;
const CELL = 12;
const X0 = 34;
const Y0 = 42;

/** Deterministic pseudo-intensity: a fixed pattern, not random per build. */
function intensity(col: number, row: number): number {
  const v = Math.sin((col + 1) * 0.7 + row * 0.45) * 0.5 + Math.cos((row + 1) * 0.9 - col * 0.3) * 0.5;
  return Math.min(1, Math.max(0.08, (v + 1) / 2));
}

const cells = Array.from({ length: ROWS }, (_, r) =>
  Array.from({ length: COLS }, (_, c) => ({
    x: X0 + c * CELL,
    y: Y0 + r * CELL,
    o: intensity(c, r).toFixed(3),
  })),
).flat();
---

<figure class="bio-fig">
  <svg
    class="diagram"
    viewBox="0 0 400 260"
    role="img"
    aria-label={t('a11y.expressionMatrix')}
    xmlns="http://www.w3.org/2000/svg"
  >
    <text class="dg-label" x="20" y="24">GENES × CELLS</text>

    {/* matrix brackets */}
    <path
      d={`M${X0 - 8},${Y0 - 6} h-6 v${ROWS * CELL + 12} h6`}
      fill="none"
      stroke="var(--dg-line)"
      stroke-width="1.25"
    />
    <path
      d={`M${X0 + COLS * CELL + 8},${Y0 - 6} h6 v${ROWS * CELL + 12} h-6`}
      fill="none"
      stroke="var(--dg-line)"
      stroke-width="1.25"
    />

    {
      cells.map((c) => (
        <rect
          x={c.x}
          y={c.y}
          width={CELL - 2}
          height={CELL - 2}
          fill="var(--ink)"
          opacity={c.o}
          class="mx-cell"
        />
      ))
    }

    <text class="dg-label" x={X0} y={Y0 + ROWS * CELL + 26}>CELLS  j = 1 … n</text>
    <text class="dg-label" x="20" y={Y0 + 9}>GENES</text>
    <text class="dg-var-sm" x={X0 + COLS * CELL + 8} y={Y0 + ROWS * CELL + 26} text-anchor="end">
      X ∈ ℝⁿˣᵖ
    </text>
  </svg>
</figure>

<style>
  .bio-fig {
    margin: 0;
  }
  .mx-cell {
    /* Keeps the grid legible in night, where --ink is near-white. */
    transition: opacity var(--dur-base) var(--ease);
  }
</style>
