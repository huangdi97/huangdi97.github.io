---
/**
 * Project Poster — a cover, not a diagram (v1.5 sample).
 *
 * The rule this component exists to enforce:
 *
 *   1 main visual metaphor · at most 3 light auxiliary marks ·
 *   at most 1 caption line · at most 1 status chip.
 *
 * A poster answers "what kind of thing is this project" in one glance. It does
 * not list capabilities, does not draw the pipeline, does not carry a formula
 * and does not explain the architecture — the words beside it do that, and the
 * scientific canvas behind it carries the mathematics and biology.
 *
 * What is shared across every poster is the *system*: hairline strokes, one
 * accent, generous white space, mono micro-labels, the same border and radius.
 * What differs is only the shape of the metaphor.
 *
 * If a metaphor ever needs five things explained, the answer is to delete
 * marks from this file — never to add them.
 */

import type { PosterVariant } from '../data/projectPosters';

export interface Props {
  variant: PosterVariant;
  /** One short line. Never a paragraph. */
  caption?: string;
  /** Reality label, taken from project content / the evidence layer. */
  status?: string;
  /** Concept projects get a dashed chip — a concept never wears a build's ink. */
  concept?: boolean;
  /** Screen-reader description of the metaphor. */
  label: string;
  href?: string;
}

const { variant, caption, status, concept = false, label, href } = Astro.props;

const STRONG = 'var(--dg-line-strong)';
const LINE = 'var(--dg-line)';
const SOFT = 'var(--dg-line-soft)';
const DOT = 'var(--dg-dot)';
const FILL = 'var(--dg-fill)';
const ACCENT = 'var(--accent)';
---

<figure class="poster" data-poster data-poster-variant={variant}>
  <div class="poster-plate">
    <svg viewBox="0 0 320 240" role="img" aria-label={label} focusable="false" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="poster-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill={STRONG} />
        </marker>
      </defs>

      {/* ── ZhiShen · WenNian — a biological state, and one direction out ── */}
      {
        variant === 'wennian' && (
          <g fill="none" stroke-linecap="round">
            {/* abstract human / biological state contour */}
            <circle cx="124" cy="54" r="19" stroke={STRONG} stroke-width="1.25" />
            <path d="M124,73 C102,77 90,94 88,116 C86,144 90,170 96,208" stroke={LINE} stroke-width="1.25" />
            <path d="M124,73 C146,77 158,94 160,116 C162,144 158,170 152,208" stroke={LINE} stroke-width="1.25" />

            {/* a few multi-dimensional state points, one of them dominant */}
            <circle cx="112" cy="100" r="3.5" fill={DOT} stroke="none" />
            <circle cx="140" cy="110" r="3" fill={DOT} stroke="none" />
            <circle cx="108" cy="132" r="4" fill={DOT} stroke="none" />
            <circle cx="142" cy="146" r="5.5" fill={FILL} stroke={ACCENT} stroke-width="1.25" />
            <circle cx="118" cy="168" r="3" fill={DOT} stroke="none" />
            <circle cx="146" cy="178" r="3.5" fill={DOT} stroke="none" />
            <polyline
              points="112,100 140,110 142,146 146,178"
              stroke={SOFT}
              stroke-width="1"
              stroke-dasharray="3 3"
            />

            {/* one light intervention direction */}
            <path
              d="M168,132 C192,126 210,110 232,94"
              stroke={ACCENT}
              stroke-width="1.5"
              marker-end="url(#poster-arrow)"
            />
          </g>
        )
      }

      {/* ── HyCell — a cell state, and one transition out of it ─────────── */}
      {
        variant === 'hycell' && (
          <g fill="none" stroke-linecap="round">
            {/* the cell */}
            <circle cx="126" cy="120" r="64" stroke={STRONG} stroke-width="1.25" />
            <circle cx="126" cy="120" r="54" stroke={SOFT} stroke-width="1" stroke-dasharray="4 4" />
            {/* the state core */}
            <circle cx="126" cy="120" r="17" fill="var(--accent-soft)" stroke={ACCENT} stroke-width="1.25" />

            {/* two or three state dots */}
            <circle cx="106" cy="102" r="4" fill={DOT} stroke="none" />
            <circle cx="148" cy="136" r="4.5" fill={DOT} stroke="none" />
            <circle cx="118" cy="148" r="3" fill={DOT} stroke="none" />

            {/* one transition trajectory toward a next state */}
            <circle cx="252" cy="92" r="26" stroke={SOFT} stroke-width="1" stroke-dasharray="4 4" />
            <path
              d="M182,112 C202,88 214,80 224,86"
              stroke={STRONG}
              stroke-width="1.25"
              marker-end="url(#poster-arrow)"
            />
          </g>
        )
      }
    </svg>

    {status && <span class="poster-chip mono" data-poster-chip data-poster-concept={concept ? 'true' : 'false'}>{status}</span>}

    {href && <a class="poster-hit" href={href} aria-hidden="true" tabindex="-1"></a>}
  </div>

  {caption && <figcaption class="poster-cap">{caption}</figcaption>}
</figure>

<style>
  .poster {
    margin: 0;
  }

  .poster-plate {
    position: relative;
    aspect-ratio: 4 / 3;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 2.5vw, 1.75rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    transition: border-color var(--dur-base) var(--ease);
  }

  .poster:hover .poster-plate {
    border-color: var(--line-strong);
  }

  .poster-plate svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The whole plate is clickable; the title beside it carries the real link
     text, so this overlay stays out of the tab order. */
  .poster-hit {
    position: absolute;
    inset: 0;
  }

  .poster-chip {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 0.2rem 0.5rem;
  }

  /* A concept is never allowed to acquire the visual weight of a build. */
  .poster-chip[data-poster-concept='true'] {
    border-style: dashed;
  }

  .poster-cap {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
</style>
