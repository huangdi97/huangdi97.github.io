---
import type { HowStep } from '../data/how';

/**
 * Process rail — the six-stage working method compressed into one line.
 *
 * The vertical timeline version is kept for the About page. Here the same six
 * stages occupy roughly one row on desktop and wrap naturally on mobile, so the
 * homepage gains the information without paying for its height.
 */

export interface Props {
  steps: HowStep[];
}

const { steps } = Astro.props;
---

<ol class="rail">
  {
    steps.map((step) => (
      <li class="rail-item">
        <span class="index-num rail-index">{step.index}</span>
        <span class="rail-title">{step.title}</span>
        <span class="rail-body">{step.body}</span>
      </li>
    ))
  }
</ol>

<style>
  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 700px) {
    .rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .rail {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .rail-item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.35rem 0.75rem;
    padding: 1.125rem 1rem 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 1100px) {
    .rail-item {
      border-bottom: 0;
      border-left: 1px solid var(--line);
      padding: 1rem 1rem 0 1.25rem;
    }

    .rail-item:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }

  .rail-index {
    grid-row: 1;
    padding-top: 0.25rem;
  }

  .rail-title {
    grid-column: 2;
    font-size: 1rem;
    letter-spacing: -0.016em;
    color: var(--ink);
  }

  .rail-body {
    grid-column: 2;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 32ch;
  }
</style>
