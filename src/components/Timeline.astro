---
import type { HowStep } from '../data/how';

export interface Props {
  steps: HowStep[];
}

const { steps } = Astro.props;
---

<ol class="timeline">
  {
    steps.map((step) => (
      <li class="timeline-item">
        <span class="timeline-dot" aria-hidden="true" />
        <span class="index-num">{step.index}</span>
        <div>
          <h3 class="h3">{step.title}</h3>
          <p class="body-muted timeline-body">{step.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 60ch;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 22px;
    bottom: 22px;
    width: 1px;
    background: var(--line);
  }

  .timeline-item {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 1rem;
    padding: 0.5rem 0 1.75rem 2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: 0;
    top: 0.75rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--canvas);
  }

  .timeline-item:first-child .timeline-dot {
    background: var(--accent);
    border-color: var(--accent);
  }

  .index-num {
    grid-column: 1;
    grid-row: 1;
    padding-top: 0.4rem;
  }

  .timeline-body {
    font-size: 0.9375rem;
    margin-top: 0.35rem;
  }
</style>
