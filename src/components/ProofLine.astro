---
import type { Lang } from '../i18n/ui';
import type { Bi } from '../data/bi';

/**
 * Proof line.
 *
 * Two or three tokens separated by micro-dots, set at 10–11px mono and always
 * uppercase. It exists to be *quieter* than the reality pill above it — if it
 * ever competes for attention, this component has failed.
 *
 * Content rule enforced upstream in `evidence.ts`: a token must describe
 * something checkable. No percentages, no rankings, no marketing adjectives.
 */

export interface Props {
  items: Bi[];
  lang: Lang;
}

const { items, lang } = Astro.props;
---

{items.length > 0 && (
  <p class="proof" data-proof>
    {items.map((item, i) => (
      <>
        {i > 0 && <span class="proof-dot" aria-hidden="true">·</span>}
        <span class="proof-token">{item[lang]}</span>
      </>
    ))}
  </p>
)}

<style>
  .proof {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    margin: 0.5rem 0 0;
  }

  .proof-token {
    font-family: var(--font-mono);
    font-size: 0.6875rem; /* 11px */
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .proof-dot {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--line-strong);
  }
</style>
