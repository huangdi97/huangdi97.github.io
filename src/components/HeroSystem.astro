---
/**
 * Hero field — a computational-biology / AI system loop.
 *
 * Observation → Representation → Dynamics → Decision, closed by a feedback
 * arc that returns a new observation. The formulas behind it are texture, not
 * claims: they sit at 3–9% opacity, they drift by a few pixels at most, and
 * they are completely still under prefers-reduced-motion.
 *
 * SVG only. No canvas, no WebGL, no runtime library, no cost to first paint.
 */
export interface Props {
  /** Screen-reader description. */
  label: string;
}

const { label } = Astro.props;

const steps = [
  { id: 'obs', label: 'OBSERVATION', expr: 'X', note: 'measurements' },
  { id: 'rep', label: 'REPRESENTATION', expr: 'z = E(X)', note: 'encoding' },
  { id: 'dyn', label: 'DYNAMICS', expr: 'zₜ₊₁ = Fθ(zₜ, aₜ, cₜ)', note: 'transition' },
  { id: 'dec', label: 'DECISION', expr: 'a*', note: 'intervention' },
];

const BOX_X = 18;
const BOX_W = 208;
const BOX_H = 54;
const BOX_TOP = 24;
const BOX_GAP = 92;
---

<div class="hero-system">
  <svg
    class="diagram"
    viewBox="0 0 480 452"
    role="img"
    aria-label={label}
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Formula field: texture, never content. -->
    <g class="hero-formulas" aria-hidden="true">
      <text class="formula" x="258" y="128" data-drift="1">P(H | D) ∝ P(D | H) P(H)</text>
      <text class="formula" x="258" y="176" data-drift="2">dx/dt = f(x, u, θ)</text>
      <text class="formula" x="258" y="224" data-drift="1">X ∈ ℝⁿˣᵖ</text>
      <text class="formula" x="258" y="272" data-drift="3">Δx = xₜ₊₁ − xₜ</text>
      <text class="formula" x="258" y="320" data-drift="2">Ĝ = argmin L(ŷ, y)</text>
    </g>

    <!-- Descending spine -->
    <g fill="none" stroke="var(--dg-line)" stroke-width="1">
      {
        steps.slice(0, -1).map((_, i) => (
          <line
            x1={BOX_X + BOX_W / 2}
            y1={BOX_TOP + BOX_H + i * BOX_GAP}
            x2={BOX_X + BOX_W / 2}
            y2={BOX_TOP + (i + 1) * BOX_GAP}
            stroke-dasharray="3 4"
          />
        ))
      }
    </g>

    {
      steps.map((step, i) => {
        const y = BOX_TOP + i * BOX_GAP;
        return (
          <g class="hero-step" style={`--step-delay:${(i * 0.55).toFixed(2)}s`}>
            <rect
              x={BOX_X}
              y={y}
              width={BOX_W}
              height={BOX_H}
              rx="2"
              fill="var(--dg-fill)"
              stroke={i === 2 ? 'var(--accent)' : 'var(--dg-line-soft)'}
              stroke-width={i === 2 ? '1.5' : '1'}
            />
            <text class="dg-label" x={BOX_X + 14} y={y + 19}>
              {step.label}
            </text>
            <text class="dg-var" x={BOX_X + 14} y={y + 40}>
              {step.expr}
            </text>
            <text class="dg-label" x={BOX_X + BOX_W - 14} y={y + 19} text-anchor="end">
              {String(i + 1).padStart(2, '0')}
            </text>
          </g>
        );
      })
    }

    <!-- Feedback arc: decision returns a new observation -->
    <path
      class="hero-feedback"
      d={`M${BOX_X + BOX_W},${BOX_TOP + 3 * BOX_GAP + BOX_H - 14} C 372 ${BOX_TOP + 3 * BOX_GAP + BOX_H - 14}, 392 ${BOX_TOP + 3 * BOX_GAP - 40}, 392 ${BOX_TOP + 2 * BOX_GAP} C 392 ${BOX_TOP + BOX_GAP - 10}, 372 ${BOX_TOP + 14}, ${BOX_X + BOX_W},${BOX_TOP + 14}`}
      fill="none"
      stroke="var(--dg-line)"
      stroke-width="1"
      stroke-dasharray="2 5"
    />
    <text class="dg-label hero-feedback-label" x="404" y="252" text-anchor="middle">
      FEEDBACK
    </text>
    <text class="dg-var-sm" x="404" y="272" text-anchor="middle">X′</text>

    <!-- Micro coordinate ticks: the kind of detail a notebook carries -->
    <g stroke="var(--dg-grid)" stroke-width="1">
      <line x1="240" y1="24" x2="240" y2="452" />
      <line x1="18" y1="404" x2="226" y2="404" />
    </g>
    <text class="dg-label" x="18" y="428">OBSERVATION SPACE</text>
    <text class="dg-label" x="226" y="428" text-anchor="end">t → t+1</text>
  </svg>

  <p class="hero-system-note">
    <span class="concept-note">CONCEPTUAL FIELD</span>
  </p>
</div>

<style>
  .hero-system {
    width: 100%;
    position: relative;
  }

  .formula {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--ink);
    opacity: var(--formula-opacity);
    letter-spacing: 0.01em;
  }

  .hero-formulas text {
    animation: drift 14s var(--ease) infinite alternate;
  }

  .hero-formulas text[data-drift='1'] {
    animation-duration: 17s;
  }
  .hero-formulas text[data-drift='2'] {
    animation-duration: 21s;
  }
  .hero-formulas text[data-drift='3'] {
    animation-duration: 13s;
  }

  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-5px, 6px, 0);
    }
  }

  .hero-step {
    animation: step-in 5.5s var(--ease) infinite;
    animation-delay: var(--step-delay, 0s);
  }

  @keyframes step-in {
    0%,
    62%,
    100% {
      opacity: 0.75;
    }
    74% {
      opacity: 1;
    }
  }

  .hero-feedback {
    stroke-dashoffset: 0;
    animation: flow 9s linear infinite;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -56;
    }
  }

  .hero-system-note {
    margin-top: 0.5rem;
    display: flex;
    justify-content: flex-end;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-formulas text,
    .hero-step,
    .hero-feedback {
      animation: none !important;
      opacity: 1;
    }
    .formula {
      opacity: var(--formula-opacity);
    }
  }
</style>
