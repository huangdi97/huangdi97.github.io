---
import { useT, type Lang } from '../i18n/ui';
import Tag from './Tag.astro';

export interface Props {
  lang: Lang;
  year: number;
  status: string;
  role: string;
  category: string;
  stack?: string[];
  /** Compact variant drops the category row — used inside cards. */
  compact?: boolean;
}

const { lang, year, status, role, category, stack = [], compact = false } = Astro.props;
const t = useT(lang);

const statusKey = `status.${status.toLowerCase()}`;
---

<dl class="meta">
  <div class="meta-row">
    <dt>{t('meta.year')}</dt>
    <dd>{year}</dd>
  </div>
  <div class="meta-row">
    <dt>{t('meta.status')}</dt>
    <dd>
      <span class="status-dot" aria-hidden="true" data-status={status.toLowerCase()}></span>
      {t(statusKey)}
    </dd>
  </div>
  <div class="meta-row">
    <dt>{t('meta.role')}</dt>
    <dd>{role}</dd>
  </div>
  {
    !compact && (
      <div class="meta-row">
        <dt>{t('meta.category')}</dt>
        <dd>{category}</dd>
      </div>
    )
  }
  {
    stack.length > 0 && (
      <div class="meta-row meta-stack">
        <dt>{t('meta.stack')}</dt>
        <dd>
          <ul>
            {stack.map((s) => (
              <li>
                <Tag text={s} />
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )
  }
</dl>

<style>
  .meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 0;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .meta-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
  }

  dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .meta-stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-right: 0.5rem;
    vertical-align: middle;
    background: var(--faint);
  }

  .status-dot[data-status='active'] {
    background: var(--accent);
  }
  .status-dot[data-status='prototype'],
  .status-dot[data-status='research'] {
    background: rgba(0, 0, 0, 0.45);
  }
  .status-dot[data-status='stable'] {
    background: var(--ink);
  }
  .status-dot[data-status='archived'] {
    background: rgba(0, 0, 0, 0.18);
  }
</style>
