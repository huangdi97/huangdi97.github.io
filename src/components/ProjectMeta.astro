---
import { useT, type Lang } from '../i18n/ui';
import Tag from './Tag.astro';

export interface Props {
  lang: Lang;
  year: number;
  status: string;
  role: string;
  category: string;
  stack?: string[];
  /** Compact variant drops the category row — used inside cards. */
  compact?: boolean;
  /**
   * Whether a repository can actually be inspected. 'none' is stated as a fact,
   * never softened into "coming soon".
   */
  publicCode?: 'open' | 'none';
  /** One factual sentence about what exists. Omitted when unavailable. */
  reality?: string;
}

const {
  lang,
  year,
  status,
  role,
  category,
  stack = [],
  compact = false,
  publicCode,
  reality,
} = Astro.props;
const t = useT(lang);

const statusKey = `status.${status.toLowerCase()}`;
---

<dl class="meta">
  <div class="meta-row">
    <dt>{t('meta.year')}</dt>
    <dd>{year}</dd>
  </div>
  <div class="meta-row">
    <dt>{t('meta.status')}</dt>
    <dd>
      <span class="status-dot" aria-hidden="true" data-status={status.toLowerCase()}></span>
      {t(statusKey)}
    </dd>
  </div>
  <div class="meta-row">
    <dt>{t('meta.role')}</dt>
    <dd>{role}</dd>
  </div>
  {
    !compact && (
      <div class="meta-row">
        <dt>{t('meta.category')}</dt>
        <dd>{category}</dd>
      </div>
    )
  }
  {
    stack.length > 0 && (
      <div class="meta-row meta-stack">
        <dt>{t('meta.stack')}</dt>
        <dd>
          <ul>
            {stack.map((s) => (
              <li>
                <Tag text={s} />
              </li>
            ))}
          </ul>
        </dd>
      </div>
    )
  }
  {
    publicCode && (
      <div class="meta-row">
        <dt>{t('meta.publicCode')}</dt>
        <dd>
          <span class="codeflag" data-open={publicCode === 'open'}>
            {t(publicCode === 'open' ? 'publiccode.open' : 'publiccode.none')}
          </span>
        </dd>
      </div>
    )
  }
  {
    reality && (
      <div class="meta-row">
        <dt>{t('meta.reality')}</dt>
        <dd class="meta-reality">{reality}</dd>
      </div>
    )
  }
</dl>

<style>
  .meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 0;
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .meta-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
  }

  dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .meta-stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .status-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin-right: 0.5rem;
    vertical-align: middle;
    background: var(--faint);
  }

  .status-dot[data-status='active'] {
    background: var(--accent);
  }
  .status-dot[data-status='prototype'],
  .status-dot[data-status='research'] {
    background: rgba(0, 0, 0, 0.45);
  }
  .status-dot[data-status='stable'] {
    background: var(--ink);
  }
  .status-dot[data-status='archived'] {
    background: rgba(0, 0, 0, 0.18);
  }

  .meta-reality {
    line-height: 1.6;
  }

  .codeflag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
  }

  .codeflag::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--faint);
  }

  .codeflag[data-open='true'] {
    border-color: rgba(49, 92, 255, 0.35);
    background: var(--accent-soft);
    color: var(--ink);
  }

  .codeflag[data-open='true']::before {
    background: var(--accent);
  }
</style>
