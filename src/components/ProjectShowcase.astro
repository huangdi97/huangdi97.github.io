---
/**
 * Homepage feature block.
 *
 * The cover says what the project *is* — name, type, one sentence, core
 * capabilities, real status. The body underneath carries the longer thesis and
 * the proof tokens, so the two never repeat the same sentence.
 */
import { useT, type Lang } from '../i18n/ui';
import Tag from './Tag.astro';
import ProjectCover from './ProjectCover.astro';
import ProofLine from './ProofLine.astro';
import { projectHref, type ProjectEntry } from '../lib/projects';
import { getProjectEvidence } from '../data/evidence';

export interface Props {
  project: ProjectEntry;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useT(lang);
const d = project.data;

const href = projectHref(lang, d.slug);
const statusKey = `status.${d.status.toLowerCase()}`;

/**
 * Card-level honesty pass: each project carries what it actually is, so five
 * projects never read as five equally finished systems.
 */
const evidence = getProjectEvidence(d.slug);
const realityLabel = evidence
  ? evidence.publicCode === 'open'
    ? t('publiccode.open')
    : t('publiccode.none')
  : null;
---

<article class="showcase reveal">
  <div class="showcase-cover">
    <div class="visual-panel">
      <ProjectCover project={project} lang={lang} layout="showcase" index={index} />
    </div>
  </div>

  <div class="showcase-body">
    <p class="showcase-thesis">{d.summary}</p>
    <p class="body-muted showcase-desc">{d.description}</p>

    {
      evidence && (
        <p class="showcase-reality">
          <span class="reality-pill" data-code={evidence.publicCode}>
            {evidence.headline[lang]}
          </span>
          <span class="reality-code">{realityLabel}</span>
        </p>
      )
    }

    {evidence && <ProofLine items={evidence.proof} lang={lang} />}

    {
      d.tags.length > 0 && (
        <ul class="showcase-tags">
          {d.tags.map((tag) => (
            <li>
              <Tag text={tag} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="showcase-actions">
      <a href={href} class="link-arrow showcase-cta">
        {t('work.case')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      {
        d.repo && (
          <a href={d.repo} class="link-arrow" target="_blank" rel="noopener noreferrer">
            {t('work.repo')}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        )
      }
      <span class="showcase-status">{t(statusKey)}</span>
    </div>
  </div>
</article>

<style>
  .showcase {
    display: grid;
    gap: 1.75rem;
  }

  .visual-panel {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(1.25rem, 3vw, 2rem);
    transition:
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .showcase:hover .visual-panel {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }

  .showcase-body {
    max-width: 68ch;
  }

  .showcase-thesis {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.018em;
    color: var(--ink);
    max-width: 46ch;
  }

  .showcase-desc {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  .showcase-reality {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 1.125rem 0 0;
  }

  .reality-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    border: 1px solid var(--line-strong);
    background: rgba(0, 0, 0, 0.035);
    color: var(--ink);
  }

  .reality-pill[data-code='none'] {
    border-style: dashed;
    background: transparent;
    color: var(--muted);
  }

  .reality-code {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .showcase-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .showcase-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .showcase-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
    margin-left: auto;
  }
</style>
