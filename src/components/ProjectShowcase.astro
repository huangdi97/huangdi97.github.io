---
import { useT, type Lang } from '../i18n/ui';
import Tag from './Tag.astro';
import ProjectVisual from './ProjectVisual.astro';
import { projectHref, type ProjectEntry } from '../lib/projects';
import { getProjectEvidence } from '../data/evidence';

export interface Props {
  project: ProjectEntry;
  lang: Lang;
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useT(lang);
const d = project.data;

const href = projectHref(lang, d.slug);
const statusKey = `status.${d.status.toLowerCase()}`;
const reversed = index % 2 === 1;

/**
 * Card-level honesty pass: each project carries what it actually is, so five
 * projects never read as five equally finished systems.
 */
const evidence = getProjectEvidence(d.slug);
const realityLabel = evidence
  ? evidence.publicCode === 'open'
    ? t('publiccode.open')
    : t('publiccode.none')
  : null;
---

<article class:list={['showcase reveal', reversed && 'showcase-reverse']}>
  <div class="showcase-visual">
    <div class="visual-panel">
      <ProjectVisual variant={d.visual} label={`${d.title} — ${d.category}`} />
    </div>
  </div>

  <div class="showcase-body">
    <div class="showcase-meta">
      <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
      <span class="mono">{d.category}</span>
    </div>

    <h3 class="h2 showcase-title">
      <a href={href}>{d.title}</a>
    </h3>

    <p class="showcase-thesis">{d.summary}</p>
    <p class="body-muted showcase-desc">{d.description}</p>

    {
      evidence && (
        <p class="showcase-reality">
          <span class="reality-pill" data-code={evidence.publicCode}>
            {evidence.headline[lang]}
          </span>
          <span class="reality-code">{realityLabel}</span>
        </p>
      )
    }

    {
      d.tags.length > 0 && (
        <ul class="showcase-tags">
          {d.tags.map((tag) => (
            <li>
              <Tag text={tag} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="showcase-actions">
      <a href={href} class="link-arrow showcase-cta">
        {t('work.case')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      {
        d.repo && (
          <a href={d.repo} class="link-arrow" target="_blank" rel="noopener noreferrer">
            {t('work.repo')}
            <span class="arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        )
      }
      <span class="showcase-status">{t(statusKey)}</span>
    </div>
  </div>
</article>

<style>
  .showcase {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .showcase {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 4rem;
    }

    .showcase-reverse .showcase-visual {
      order: 2;
    }
  }

  .visual-panel {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1rem;
    transition:
      border-color var(--dur-base) var(--ease),
      transform var(--dur-base) var(--ease);
  }

  .showcase:hover .visual-panel {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }

  .showcase-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .showcase-title a {
    display: inline-block;
  }

  .showcase-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  .showcase-thesis {
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.018em;
    color: var(--ink);
    max-width: 42ch;
  }

  .showcase-desc {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  /* Reality strip — restrained: one pill, one provenance word. */
  .showcase-reality {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: 1.125rem 0 0;
  }

  .reality-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    border: 1px solid var(--line-strong);
    background: rgba(0, 0, 0, 0.035);
    color: var(--ink);
  }

  .reality-pill[data-code='none'] {
    border-style: dashed;
    background: transparent;
    color: var(--muted);
  }

  .reality-code {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .showcase-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .showcase-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .showcase-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
    margin-left: auto;
  }
</style>
