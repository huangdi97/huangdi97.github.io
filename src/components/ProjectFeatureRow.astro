---
/**
 * Featured project row — one project as a piece of work, not a card (v2.0).
 *
 * What this replaces. v1.7 laid Selected Work out as a 2 × 2 mosaic of bordered
 * cards, each with a category eyebrow, an index number, a type line, a large
 * illustration, up to three keywords, a reality status, a case link and a
 * repository link. Individually restrained, together still a design system:
 * four boxes with eight labelled slots each. The owner's read was that the
 * projects looked like engineering cards rather than work.
 *
 * v2.0 makes four rows, stacked, alternating sides, and cuts the row down to
 * what a visitor actually uses to decide whether to click:
 *
 *   name · one line of positioning · one status · one link (plus the repository)
 *
 * v2.1 (§7–§8) removes one more block. The row used to print the project's own
 * type line *and* a second sentence explaining how the project works; §7 allows
 * exactly one line, and §8 fixes what it says. That line now lives in each
 * project's frontmatter as `publicLine`, so the homepage and /projects print
 * the same sentence rather than two paraphrases of it.
 *
 * Removed: the index number, the category eyebrow, the keyword list, the proof
 * line, the second copy of the public-code fact, the border, the card fill.
 * What is left is separated by whitespace, not by hairlines.
 *
 * Row 1 and 3 put the drawing on the left; rows 2 and 4 put it on the right, so
 * the eye zigzags down the page without the rows becoming a list of identical
 * bands. Every row is the same height — an alternating layout that also varied
 * in height would read as broken rather than as rhythm.
 */
import { useT, type Lang } from '../i18n/ui';
import { projectHref, type ProjectEntry } from '../lib/projects';
import { projectStatus } from '../lib/projectStatus';
import { ARTWORK_LABELS, ART_ALT } from '../data/artwork';
import Artwork, { type ArtworkName } from './Artwork.astro';

export interface Props {
  project: ProjectEntry;
  lang: Lang;
  /** Zero-based position in the featured list. Drives the side alternation. */
  index: number;
}

const { project, lang, index } = Astro.props;
const t = useT(lang);
const d = project.data;

/* One status, resolved from the evidence layer by `projectStatus`. The homepage
   and /projects call the same function, so the two surfaces cannot print two
   different words for one fact. */
const status = projectStatus(d.slug, lang, t);

const href = projectHref(lang, d.slug);
const label = ARTWORK_LABELS[d.slug]?.[lang] ?? d.title;
const flipped = index % 2 === 1;
---

<article
  class:list={['row', flipped && 'row--flipped']}
  data-featured-row
  data-slug={d.slug}
>
  <div class="row-art">
    <Artwork
      name={d.slug as ArtworkName}
      label={label}
      alt={ART_ALT[d.slug]?.[lang]}
    />
  </div>

  <div class="row-copy">
    <h3 class="row-name">
      <a href={href}>{d.title}</a>
    </h3>

    {/* One line of positioning and one status (§7–§8). v2.0 printed the
        project's own type line *and* a second sentence describing how it works;
        §7 keeps exactly one line per row, and it says what the project is. The
        line now lives in the project's own frontmatter (`publicLine`), so the
        homepage and /projects cannot disagree about it. */}
    <p class="row-position">{d.publicLine}</p>

    {status && <p class="row-status">{status}</p>}

    <p class="row-actions">
      <a href={href} class="row-link">
        {t('work.project')}
        <span aria-hidden="true">→</span>
      </a>

      {d.repo && (
        <a
          href={d.repo}
          class="row-repo"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </p>
  </div>
</article>

<style>
  /* Two blocks of a twelve-column field, with the empty column between them
     doing the separating. The drawing takes seven columns and the words four,
     so neither side is a caption for the other. */
  .row {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  /* §25: the drawing takes a little over half the row and the words about a
     third, with the remaining fourteenth left empty between them.
     An earlier version expressed this as a twelve-column grid with a 72px
     column gap, which technically produced the same two blocks but spent 73% of
     the row on gutters — eleven columns of about 25px each, separated by 72px of
     nothing. The percentages that came out were art 55.6% / copy 29%, and the
     copy fell below the 32–40% the brief asks for. Three explicit tracks say the
     same thing in one line and land where the brief says to land.
     The drawing's 59% is not arbitrary either: at the 3:2 frame ratio the
     artwork uses, it is what puts the row at 428px, inside §26's 420–520 band,
     without shrinking the image to get there. */
  @media (min-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 59fr) minmax(0, 7fr) minmax(0, 34fr);
      column-gap: 0;
    }

    .row-art {
      grid-column: 1;
    }

    .row-copy {
      grid-column: 3;
    }

    /* Rows 2 and 4 mirror: words left, drawing right. The tracks mirror with
       them, so the drawing keeps the wide track on both sides of the page —
       assigning it `grid-column: 3` without mirroring the template put it in the
       narrow 35fr track and gave the words 57%, which is the one thing §25 says
       not to do. */
    .row--flipped {
      grid-template-columns: minmax(0, 34fr) minmax(0, 7fr) minmax(0, 59fr);
    }

    .row--flipped .row-art {
      grid-column: 3;
      grid-row: 1;
    }

    .row--flipped .row-copy {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* On a phone the drawing still leads — it is what makes the row a piece of
     work rather than a line in an index. */
  .row-art {
    order: 0;
  }

  .row-copy {
    order: 1;
  }

  .row-name {
    font-size: clamp(1.5rem, 2.7vw, 2.125rem);
    line-height: 1.08;
    letter-spacing: -0.028em;
    font-weight: 500;
    margin: 0;
  }

  .row-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 7px;
  }

  /* The positioning line is the row's only sentence. It carries the ink; the
     status below it steps back to the mono faint face. Two levels, so the row
     has a reading order instead of two grey paragraphs. */
  .row-position {
    margin: 0.875rem 0 0;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.45;
    letter-spacing: -0.012em;
    color: var(--ink);
    max-width: 34ch;
  }

  /* One status, in the mono face but never shouted: no uppercase, no pill, no
     badge, no second code label beside it. §41 asks for a dot and plain text —
     the dot is a pseudo-element, so the accessible text stays the status alone
     and a screen reader never has to announce a bullet. */
  .row-status {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1.125rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .row-status::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    /* Optical alignment against the mono baseline rather than the em box. */
    transform: translateY(-1px);
    opacity: 0.7;
  }

  .row-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin: clamp(1.5rem, 2.6vw, 2rem) 0 0;
  }

  .row-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .row-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .row-repo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
    transition: color var(--dur-fast) var(--ease);
  }

  .row-repo:hover {
    color: var(--ink);
  }
</style>
