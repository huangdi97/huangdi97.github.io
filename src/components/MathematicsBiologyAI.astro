---
/**
 * Mathematics × Biology × AI — a statement band (v1.7).
 *
 * v1.6 gave this section a heading, three paragraphs, the concept-loop figure,
 * the state-transition expression and three numbered questions. It was a
 * research section: it asked the reader to study something on the way down the
 * page.
 *
 * The homepage only has to say what the person thinks, in one breath. So this is
 * a band, not a section — an eyebrow, one statement, the expression, and a way
 * out to /research where the argument is actually made:
 *
 *   MATHEMATICS × BIOLOGY × AI
 *   Living systems have state, change, noise and intervention.
 *   Mathematics supplies the structure.
 *   AI learns the parts that cannot be written down as an equation.
 *   zₜ₊₁ = F(zₜ, aₜ)                                    Research →
 *
 * The three questions and the concept-loop figure moved to /research, where a
 * reader who wants them has chosen to go.
 */
import { useT, localizedPath, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const spoken =
  lang === 'zh'
    ? 'z 下标 t+1 等于 F 下标 theta 作用于 z 下标 t 与 a 下标 t'
    : 'z sub t plus one equals F sub theta of z sub t and a sub t';
---

<section class="shell statement-band" id="mathbio">
  <p class="eyebrow">{t('mbai.eyebrow')}</p>

  <div class="band-grid">
    <p class="band-statement">{t('mbai.statement')}</p>

    <div class="band-side">
      <p class="band-formula">
        <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline" aria-label={spoken}>
          <mrow>
            <msub><mi>z</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub>
            <mo>=</mo>
            <msub><mi>F</mi><mi>θ</mi></msub>
            <mo>(</mo>
            <msub><mi>z</mi><mi>t</mi></msub>
            <mo>,</mo>
            <msub><mi>a</mi><mi>t</mi></msub>
            <mo>)</mo>
          </mrow>
        </math>
      </p>

      <a href={localizedPath(lang, '/research')} class="band-link">
        {t('research.all')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Desktop target: 260–420px, and 10–15% of the page. The band earns its space
     from padding rather than from more content: it is one statement, and it
     should feel like a breath between the work and the close.
     
     A desktop min-height keeps that deterministic. Without it the band's height
     depended on how the statement happened to wrap, which moved it by ~130px
     between a cold load and a warm one. */
  .statement-band {
    padding-block: clamp(2rem, 4vw, 3.25rem);
  }

  @media (min-width: 900px) {
    .statement-band {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 380px;
    }
  }

  .band-grid {
    display: grid;
    gap: 1.75rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (min-width: 900px) {
    .band-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 15rem);
      gap: 4rem;
      align-items: start;
    }
  }

  .band-statement {
    margin: 0;
    font-size: clamp(1.5rem, 2.9vw, 2.125rem);
    line-height: 1.42;
    letter-spacing: -0.024em;
    max-width: 44ch;
  }

  .band-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .band-formula {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--muted);
    overflow-x: auto;
  }

  .band-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .band-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
</style>
