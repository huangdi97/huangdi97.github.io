---
import { getContactLinks } from '../data/contact';
import type { Lang } from '../i18n/ui';

/**
 * Contact identity, rendered from one data source.
 *
 * Used by the footer, the About page, the Resume page and the mobile
 * navigation. Because every surface reads the same array, it is impossible for
 * one page to show the Gmail address while another still shows only QQ Mail.
 *
 * Every variant reads the active theme's tokens. None of them assumes the
 * surface is inverted — the v1.6 footer no longer is.
 *
 * Order is fixed: Gmail → QQ Mail → GitHub → Resume.
 */
export interface Props {
  lang: Lang;
  /**
   * `inline` = labelled links only, for the homepage contact band (the value
   * is still the accessible name, just not printed); `row` = label + value, for
   * the footer, which is the one contact surface the inner pages have;
   * `buttons` = CTA row; `list` = label + value rows.
   */
  variant?: 'inline' | 'row' | 'buttons' | 'list';
  /** Small mono heading rendered above the links. */
  heading?: string;
}

const { lang, variant = 'list', heading } = Astro.props;
const links = getContactLinks(lang);
---

{
  variant === 'inline' && (
    <div class="contact-inline">
      {heading && <p class="contact-heading">{heading}</p>}
      <ul class="contact-inline-list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              data-contact-id={link.id}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              title={link.value}
            >
              <span class="contact-label">{link.label}</span>
              {/* The address stays in the accessible name and in the tooltip,
                  but the homepage does not print it twice. */}
              <span class="vh">{link.value}</span>
              {link.external && (
                <span aria-hidden="true" class="contact-ext">
                  ↗
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  variant === 'row' && (
    <div class="contact-row">
      {heading && <p class="contact-heading">{heading}</p>}
      <ul class="contact-row-list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              data-contact-id={link.id}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              <span class="contact-label">{link.label}</span>
              <span class="contact-value">{link.value}</span>
              {link.external && (
                <span aria-hidden="true" class="contact-ext">
                  ↗
                </span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  variant === 'buttons' && (
    <div class="contact-buttons">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['btn', link.id === 'github' ? 'btn-primary' : 'btn-outline']}
          data-contact-id={link.id}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
          <span class="contact-btn-value">{link.value}</span>
          {link.external && <span aria-hidden="true">↗</span>}
        </a>
      ))}
    </div>
  )
}

{
  variant === 'list' && (
    <ul class="contact-list">
      {links.map((link) => (
        <li>
          <span class="contact-list-label">{link.label}</span>
          <a
            class="contact-list-value"
            href={link.href}
            data-contact-id={link.id}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.value}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .contact-heading {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .contact-row-list,
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* The homepage band: labelled links, one wrap row, no printed addresses —
     the footer directly below is the surface that prints them. This is the
     "or the other way around" arrangement the brief allows, and it stops the
     same four values appearing twice inside one screen. */
  .contact-inline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
  }

  .contact-inline a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .contact-inline a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* The footer row: one line on a wide screen, four on a phone. Reads the
     active theme — the footer no longer inverts, so neither does this. */
  .contact-row-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }

  .contact-list {
    gap: 0.625rem;
  }

  .contact-row a {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
  }

  .contact-row a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .contact-value {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .contact-row a:hover .contact-value {
    color: var(--ink);
  }

  .contact-ext {
    font-size: 0.75rem;
    color: var(--faint);
  }

  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .contact-btn-value {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  .contact-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
  }

  .contact-list-label {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .contact-list-value {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .contact-list-value:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
