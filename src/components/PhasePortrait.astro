---
/**
 * Phase portrait — conceptual.
 *
 * A vector field with two attractor basins and one trajectory. This is the
 * figure that best matches how the rest of the site thinks: a state, a field
 * that moves it, and somewhere it settles.
 *
 * It is a drawing. It is not the output of any fitted biological model.
 */
import { useT, type Lang } from '../i18n/ui';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const W = 400;
const H = 260;
const ORIGIN_X = 48;
const ORIGIN_Y = 208;
const AXIS_X = 336;
const AXIS_Y = 44;

const A = { x: 262, y: 96 };
const B = { x: 122, y: 168 };

/** Short field segments flowing toward both attractors. */
const field = Array.from({ length: 7 }, (_, r) =>
  Array.from({ length: 9 }, (_, c) => {
    const x = ORIGIN_X + 26 + c * 33;
    const y = AXIS_Y + 16 + r * 24;
    const va = { x: A.x - x, y: A.y - y };
    const vb = { x: B.x - x, y: B.y - y };
    const la = Math.hypot(va.x, va.y) || 1;
    const lb = Math.hypot(vb.x, vb.y) || 1;
    // Closer basin dominates — a plain distance-weighted blend.
    const wa = lb / (la + lb);
    const wb = la / (la + lb);
    const dx = (va.x / la) * wa + (vb.x / lb) * wb;
    const dy = (va.y / la) * wa + (vb.y / lb) * wb;
    const len = 11;
    const n = Math.hypot(dx, dy) || 1;
    return {
      x1: (x - (dx / n) * len * 0.5).toFixed(1),
      y1: (y - (dy / n) * len * 0.5).toFixed(1),
      x2: (x + (dx / n) * len * 0.5).toFixed(1),
      y2: (y + (dy / n) * len * 0.5).toFixed(1),
    };
  }),
).flat();
---

<figure class="bio-fig">
  <svg
    class="diagram"
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={t('a11y.phasePortrait')}
    xmlns="http://www.w3.org/2000/svg"
  >
    <text class="dg-label" x="20" y="24">PHASE PORTRAIT · (x₁, x₂)</text>

    {/* axes */}
    <line x1={ORIGIN_X} y1={ORIGIN_Y} x2={AXIS_X} y2={ORIGIN_Y} stroke="var(--dg-line)" stroke-width="1" />
    <line x1={ORIGIN_X} y1={ORIGIN_Y} x2={ORIGIN_X} y2={AXIS_Y} stroke="var(--dg-line)" stroke-width="1" />
    <text class="dg-label" x={AXIS_X} y={ORIGIN_Y + 16} text-anchor="end">x₁</text>
    <text class="dg-label" x={ORIGIN_X - 10} y={AXIS_Y + 4} text-anchor="end">x₂</text>

    {/* vector field */}
    <g stroke="var(--dg-line-soft)" stroke-width="1">
      {field.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />)}
    </g>

    {/* basins */}
    <circle cx={A.x} cy={A.y} r="26" fill="var(--accent-soft)" stroke="var(--accent)" stroke-width="1.25" />
    <circle cx={B.x} cy={B.y} r="20" fill="none" stroke="var(--dg-line)" stroke-width="1.25" stroke-dasharray="4 3" />
    <circle cx={A.x} cy={A.y} r="3" fill="var(--accent)" />
    <circle cx={B.x} cy={B.y} r="2.5" fill="var(--dg-dot)" />

    {/* trajectory */}
    <path
      d={`M${ORIGIN_X + 22},${ORIGIN_Y - 18} C 150 ${ORIGIN_Y - 40}, 150 ${A.y + 52}, ${A.x - 30} ${A.y + 26} C ${A.x + 4} ${A.y + 8}, ${A.x - 6} ${A.y - 8}, ${A.x} ${A.y}`}
      fill="none"
      stroke="var(--dg-line-strong)"
      stroke-width="1.25"
      marker-end="url(#pp-arrow)"
    />
    <defs>
      <marker
        id="pp-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="pp-head" d="M0,0 L10,5 L0,10 z" />
      </marker>
    </defs>

    <text class="dg-label" x={A.x + 32} y={A.y + 4}>TARGET BASIN</text>
    <text class="dg-label" x={B.x - 26} y={B.y + 34} text-anchor="end">AGED BASIN</text>
  </svg>
</figure>

<style>
  .bio-fig {
    margin: 0;
  }
  .pp-head {
    fill: var(--dg-line-strong);
  }
</style>
