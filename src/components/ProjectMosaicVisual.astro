---
/**
 * Project mosaic visual — one large illustration per homepage project (v1.7).
 *
 * v1.6 rendered each homepage project as a words-first cover with a 240 × 160
 * mark in the corner. The words carried the explanation and the drawing was
 * decoration, which is why the page read as a document: four blocks of text with
 * four small diagrams beside them.
 *
 * v1.7 inverts that ratio. The illustration is the subject of the card and the
 * words are reduced to identification — name, one line, status, one link. Each
 * drawing is one metaphor and at most three supporting elements:
 *
 *   ZhiShen   a biological state form, its four state nodes, and one
 *             intervention path leaving it
 *   HyCell    a large abstract cell, one state trajectory, one target state
 *   Morn      a central orchestration form with six nodes around it
 *   BioPulse  evidence converging on a single validation node
 *
 * The frames are near-square on purpose. A 640 × 300 frame left the marks
 * floating at roughly 40% of the card, which is the "small diagram beside some
 * text" problem this round exists to fix; a taller frame lets the drawing fill
 * the box and take 50–60% of the card (`npm run qa:mosaic`).
 *
 * These are UI illustrations, so they use the interface palette — never
 * `--science-bio-ink`, which is background-only by contract.
 */
import type { Lang } from '../i18n/ui';

export interface Props {
  /** Project slug. An unknown slug renders nothing rather than a placeholder. */
  slug: string;
  lang: Lang;
}

const { slug, lang } = Astro.props;

/** Spoken description per project — the drawing carries meaning, so it is labelled. */
const LABEL: Record<string, Record<Lang, string>> = {
  wennian: {
    en: 'Conceptual illustration: a biological state form with four measured state nodes around it and one intervention path leaving for a target state.',
    zh: '概念插图：一个生物状态形体，周围四个被测量的状态节点，以及一条通向目标状态的干预路径。',
  },
  hycell: {
    en: 'Conceptual illustration: a large abstract cell, a state trajectory crossing it, and one target state.',
    zh: '概念插图：一个大型抽象细胞、一条穿过它的状态轨迹，以及一个目标状态。',
  },
  morn: {
    en: 'Conceptual illustration: a central orchestration form with six connected nodes around it.',
    zh: '概念插图：一个中心编排形体，周围六个相互连接的节点。',
  },
  biopulse: {
    en: 'Conceptual illustration: three evidence sources converging on a single validation node.',
    zh: '概念插图：三路证据汇聚到一个校验节点。',
  },
};

const label = LABEL[slug]?.[lang] ?? '';

const LINE = 'var(--dg-line)';
const SOFT = 'var(--dg-line-soft)';
const STRONG = 'var(--dg-line-strong)';
const DOT = 'var(--dg-dot)';
const FILL = 'var(--dg-fill)';
const ACCENT = 'var(--accent)';

/* ── geometry shared by more than one drawing ────────────────────────────── */

/** A ring of nodes around a centre. */
const ring = (cx: number, cy: number, r: number, n = 6, phase = 0) =>
  Array.from({ length: n }, (_, i) => {
    const a = (Math.PI * 2 * i) / n + phase;
    return [Math.round(cx + Math.cos(a) * r), Math.round(cy + Math.sin(a) * r)] as [number, number];
  });

const MORN_CX = 250;
const MORN_CY = 216;
const MORN_NODES: Array<[number, number]> = [
  ...ring(MORN_CX, MORN_CY, 152, 4, -Math.PI / 4),
  [424, 160],
  [424, 272],
];
const MORN_EDGES: Array<[number, number]> = [
  [0, 1],
  [1, 2],
  [2, 3],
  [3, 0],
  [1, 4],
  [2, 5],
];

/** ZhiShen's four measured states, around the central form. */
const WENNIAN_NODES: Array<[number, number]> = [
  [344, 132],
  [404, 262],
  [344, 392],
  [58, 262],
];

/** BioPulse's triangle vertices. */
const PULSE_TRI: Array<[number, number]> = [
  [250, 66],
  [430, 372],
  [70, 372],
];

const VIEW_BOX: Record<string, string> = {
  wennian: '0 0 600 420',
  hycell: '10 20 420 390',
  morn: '60 56 380 320',
  biopulse: '30 30 450 370',
};
---

{
  label && (
    <figure class="mosaic-visual" data-mosaic-visual={slug}>
      <svg
        viewBox={VIEW_BOX[slug] ?? '0 0 600 420'}
        role="img"
        aria-label={label}
        preserveAspectRatio="xMidYMid meet"
        focusable="false"
        xmlns="http://www.w3.org/2000/svg"
      >
        {/* ── ZhiShen · a state form, its nodes, one way out ────────────── */}
        {slug === 'wennian' && (
          <g fill="none" stroke-linecap="round">
            <circle cx="196" cy="88" r="34" stroke={LINE} stroke-width="1.6" />
            <path d="M196,124 L196,142" stroke={SOFT} stroke-width="1.25" />
            <ellipse cx="196" cy="262" rx="60" ry="124" stroke={LINE} stroke-width="1.6" />

            {WENNIAN_NODES.map(([x, y]) => (
              <g>
                <line
                  x1="196"
                  y1="262"
                  x2={x}
                  y2={y}
                  stroke={SOFT}
                  stroke-width="1.25"
                  stroke-dasharray="5 7"
                />
                <circle cx={x} cy={y} r="8" fill={FILL} stroke={STRONG} stroke-width="1.3" />
              </g>
            ))}

            <path d="M404,262 L482,262" stroke={ACCENT} stroke-width="2.2" />
            <path d="M482,262 L468,254 L468,270 Z" fill={ACCENT} stroke="none" />
            <circle cx="534" cy="262" r="36" stroke={ACCENT} stroke-width="1.6" stroke-dasharray="6 7" />
            <circle cx="534" cy="262" r="9" fill={ACCENT} stroke="none" />
          </g>
        )}

        {/* ── HyCell · a cell, a trajectory, a target ──────────────────── */}
        {slug === 'hycell' && (
          <g fill="none" stroke-linecap="round">
            <circle cx="176" cy="182" r="120" stroke={LINE} stroke-width="1.6" />
            <path
              d="M176,68 C 246,76 288,116 282,180 C 276,248 226,294 168,290 C 108,286 74,238 80,178 C 86,116 118,72 176,68 Z"
              stroke={SOFT}
              stroke-width="1.3"
              stroke-dasharray="6 8"
            />
            <circle cx="144" cy="158" r="10" fill={DOT} stroke="none" />
            <circle cx="216" cy="222" r="7" fill={DOT} stroke="none" />

            <path d="M30,386 C 108,386 122,272 190,238 C 258,204 300,266 356,330" stroke={STRONG} stroke-width="2" />
            <circle cx="30" cy="386" r="8" fill={FILL} stroke={STRONG} stroke-width="1.6" />

            <circle cx="356" cy="330" r="50" stroke={ACCENT} stroke-width="1.6" stroke-dasharray="6 7" />
            <circle cx="356" cy="330" r="12" fill={ACCENT} stroke="none" />
          </g>
        )}

        {/* ── Morn · one orchestration form, six nodes ─────────────────── */}
        {slug === 'morn' && (
          <g fill="none" stroke-linecap="round">
            {MORN_EDGES.map(([a, b]) => (
              <line
                x1={MORN_NODES[a][0]}
                y1={MORN_NODES[a][1]}
                x2={MORN_NODES[b][0]}
                y2={MORN_NODES[b][1]}
                stroke={SOFT}
                stroke-width="1.3"
                stroke-dasharray="5 7"
              />
            ))}

            {MORN_NODES.map(([x, y], i) => (
              <circle
                cx={x}
                cy={y}
                r={i > 3 ? 12 : 9}
                fill={FILL}
                stroke={i > 3 ? ACCENT : STRONG}
                stroke-width={i > 3 ? 1.7 : 1.3}
              />
            ))}

            <rect x="165" y="131" width="170" height="170" rx="4" stroke={LINE} stroke-width="1.6" />
            <rect x="205" y="171" width="90" height="90" rx="3" stroke={ACCENT} stroke-width="1.6" />
            <line x1="226" y1="216" x2="274" y2="216" stroke={ACCENT} stroke-width="2.2" />
            <line x1="250" y1="192" x2="250" y2="240" stroke={ACCENT} stroke-width="2.2" />
          </g>
        )}

        {/* ── BioPulse · evidence converging on one check ──────────────── */}
        {slug === 'biopulse' && (
          <g fill="none" stroke-linecap="round">
            <path d={`M${PULSE_TRI[0][0]},${PULSE_TRI[0][1]} L${PULSE_TRI[1][0]},${PULSE_TRI[1][1]} L${PULSE_TRI[2][0]},${PULSE_TRI[2][1]} Z`} stroke={LINE} stroke-width="1.6" />

            {PULSE_TRI.map(([x, y]) => (
              <g>
                <circle cx={x} cy={y} r="8" fill={FILL} stroke={STRONG} stroke-width="1.6" />
                <line
                  x1={x}
                  y1={y}
                  x2="250"
                  y2="268"
                  stroke={SOFT}
                  stroke-width="1.3"
                  stroke-dasharray="6 8"
                />
              </g>
            ))}

            <circle cx="250" cy="268" r="46" stroke={ACCENT} stroke-width="1.8" />
            <path d="M232,268 L245,281 L268,254" stroke={ACCENT} stroke-width="2.6" />

            <line x1="140" y1="344" x2="176" y2="344" stroke={SOFT} stroke-width="1.3" />
            <line x1="324" y1="344" x2="360" y2="344" stroke={SOFT} stroke-width="1.3" />

            <rect x="344" y="96" width="136" height="112" rx="3" stroke={SOFT} stroke-width="1.3" />
            <line x1="362" y1="126" x2="462" y2="126" stroke={SOFT} stroke-width="1.3" />
            <line x1="362" y1="152" x2="440" y2="152" stroke={SOFT} stroke-width="1.3" />
            <line x1="362" y1="178" x2="452" y2="178" stroke={SOFT} stroke-width="1.3" />
          </g>
        )}
      </svg>
    </figure>
  )
}

<style>
  .mosaic-visual {
    margin: 0;
    display: block;
  }

  .mosaic-visual svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
</style>
