---
/**
 * Project Cover — what the project *is*.
 *
 * v1.4.1 split the site's visual language into three responsibilities, and
 * this component owns exactly one of them:
 *
 *   PROJECT COVER            — describes the project (this file)
 *   CONCEPTUAL SCIENCE VISUAL— explains a mathematical / biological idea
 *   AMBIENT SCIENCE LAYER    — carries page atmosphere
 *
 * A cover therefore leads with words: category, name, type, one sentence,
 * three to six capabilities, and the real status. The drawing beside them is
 * deliberately small, hairline and formula-free — hide every cover mark and
 * the page still explains each project completely.
 *
 * Every field comes from project content; status is re-checked against the
 * evidence layer by `scripts/check-visual-system.mjs`.
 */

import type { Lang } from '../i18n/ui';
import type { CoverVisualHint } from '../data/visualVariants';
import { projectHref, type ProjectEntry } from '../lib/projects';

let seq = 0;

export interface Props {
  project: ProjectEntry;
  lang: Lang;
  /** `showcase` is the homepage feature; `card` is the projects grid. */
  layout?: 'card' | 'showcase';
  /** Render the name as a plain heading instead of a link. */
  plainTitle?: boolean;
  /** Index number shown beside the category. */
  index?: number;
}

const { project, lang, layout = 'card', plainTitle = false, index } = Astro.props;

const d = project.data;
const uid = `cover${(seq += 1)}`;
const href = projectHref(lang, d.slug);

const hint = d.coverVisualHint as CoverVisualHint;
const isConcept = /concept|尚未开始|概念/i.test(d.coverStatus);

const CONCEPT_BAND: Record<Lang, string> = {
  en: 'Concept · Not Started',
  zh: '概念 · 尚未开始',
};

/* --- shared geometry for the auxiliary marks ---------------------------- */

const ACCENT = 'var(--accent)';
const LINE = 'var(--dg-line)';
const SOFT = 'var(--dg-line-soft)';
const STRONG = 'var(--dg-line-strong)';
const FILL = 'var(--dg-fill)';

const ARROW_NODES: Record<CoverVisualHint, Array<[number, number, number, number]>> = {
  'assessment-flow': [
    [78, 80, 96, 80],
    [146, 80, 164, 80],
  ],
  'cell-state': [
    [74, 80, 94, 80],
    [150, 80, 170, 80],
  ],
  'agent-dag': [],
  'compliance-triangle': [],
  'dependency-graph': [],
  'discovery-loop': [],
  'care-flow': [],
};

const HEX = (cx: number, cy: number, r: number, k = 1) =>
  Array.from({ length: 6 }, (_, i) => {
    const a = (Math.PI * 2 * i) / 6 - Math.PI / 2;
    return `${(cx + Math.cos(a) * r * k).toFixed(1)},${(cy + Math.sin(a) * r * k).toFixed(1)}`;
  }).join(' ');
---

<div class:list={['cover', `cover-${layout}`]} data-cover data-cover-slug={d.slug} data-cover-concept={isConcept ? 'true' : 'false'}>
  <div class="cover-main">
    <p class="cover-cat mono">
      {index !== undefined && <span class="cover-index">{String(index + 1).padStart(2, '0')}</span>}
      <span>{d.category}</span>
    </p>

    {
      plainTitle ? (
        <h3 class="cover-title" data-cover-title>
          {d.title}
        </h3>
      ) : (
        <h3 class="cover-title" data-cover-title>
          <a href={href}>{d.title}</a>
        </h3>
      )
    }

    {d.subtitle && <p class="cover-sub">{d.subtitle}</p>}

    <p class="cover-type" data-cover-type>{d.coverType}</p>
    <p class="cover-desc" data-cover-desc>{d.coverDescription}</p>

    <ul class="cover-caps" data-cover-caps>
      {d.coverCapabilities.map((cap) => <li>{cap}</li>)}
    </ul>
  </div>

  <div class="cover-visual" aria-hidden="true" data-cover-visual>
    <svg viewBox="0 0 240 160" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" focusable="false">
      <defs>
        <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--dg-line-strong)" />
        </marker>
      </defs>

      {ARROW_NODES[hint].map(([x1, y1, x2, y2]) => (
        <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={STRONG} stroke-width="1.25" marker-end={`url(#${uid}-a)`} />
      ))}

      {/* assessment → driver → intervention priority */}
      {
        hint === 'assessment-flow' && (
          <g>
            <polygon points={HEX(40, 80, 30)} fill="none" stroke={SOFT} stroke-width="1" />
            <polygon points={HEX(40, 80, 30, 0.6)} fill="var(--accent-soft)" stroke={ACCENT} stroke-width="1.25" />
            <circle cx="116" cy="62" r="3.5" fill="var(--dg-dot)" />
            <circle cx="134" cy="72" r="5" fill="var(--dg-fill)" stroke={ACCENT} stroke-width="1.25" />
            <circle cx="118" cy="92" r="3.5" fill="var(--dg-dot)" />
            <circle cx="102" cy="84" r="3.5" fill="var(--dg-dot)" />
            <line x1="170" y1="62" x2="222" y2="62" stroke={ACCENT} stroke-width="4" />
            <line x1="170" y1="80" x2="208" y2="80" stroke={LINE} stroke-width="4" />
            <line x1="170" y1="98" x2="194" y2="98" stroke={LINE} stroke-width="4" />
          </g>
        )
      }

      {/* cell state → changed state → target */}
      {
        hint === 'cell-state' && (
          <g>
            <circle cx="44" cy="80" r="24" fill={FILL} stroke={LINE} stroke-width="1.25" />
            <circle cx="44" cy="80" r="7" fill="var(--dg-dot)" />
            <circle cx="120" cy="80" r="24" fill={FILL} stroke={ACCENT} stroke-width="1.5" />
            <circle cx="120" cy="80" r="7" fill="var(--dg-dot)" />
            <circle cx="130" cy="70" r="2.5" fill="var(--dg-dot)" />
            <circle cx="112" cy="90" r="2.5" fill="var(--dg-dot)" />
            <circle cx="196" cy="80" r="24" fill="none" stroke={SOFT} stroke-width="1.25" stroke-dasharray="4 4" />
            <circle cx="196" cy="80" r="7" fill="none" stroke={SOFT} stroke-width="1" />
          </g>
        )
      }

      {/* small execution DAG */}
      {
        hint === 'agent-dag' && (
          <g>
            {[
              [0, 1],
              [0, 2],
              [1, 2],
              [2, 3],
              [2, 4],
              [3, 5],
              [4, 5],
            ].map(([a, b]) => {
              const nodes = [
                [30, 40],
                [30, 120],
                [120, 80],
                [210, 40],
                [210, 120],
                [120, 20],
              ];
              return <line x1={nodes[a][0]} y1={nodes[a][1]} x2={nodes[b][0]} y2={nodes[b][1]} stroke={a === 2 ? ACCENT : LINE} stroke-width={a === 2 ? '1.5' : '1'} />;
            })}
            {[
              [30, 40],
              [30, 120],
              [120, 80],
              [210, 40],
              [210, 120],
              [120, 20],
            ].map(([x, y], i) => (
              <circle cx={x} cy={y} r={i === 2 ? 11 : 8} fill={FILL} stroke={i === 2 ? ACCENT : STRONG} stroke-width={i === 2 ? '1.5' : '1.25'} />
            ))}
          </g>
        )
      }

      {/* cross-audit triangle */}
      {
        hint === 'compliance-triangle' && (
          <g>
            <polygon points="120,26 206,134 34,134" fill="none" stroke={LINE} stroke-width="1.25" />
            <line x1="120" y1="32" x2="120" y2="96" stroke={SOFT} stroke-width="1" stroke-dasharray="3 3" />
            <line x1="146" y1="110" x2="94" y2="110" stroke={SOFT} stroke-width="1" stroke-dasharray="3 3" />
            <circle cx="120" cy="100" r="16" fill={FILL} stroke={ACCENT} stroke-width="1.5" />
            <circle cx="120" cy="100" r="4" fill="var(--dg-dot)" />
            <circle cx="120" cy="26" r="4.5" fill={FILL} stroke={STRONG} stroke-width="1.25" />
            <circle cx="206" cy="134" r="4.5" fill={FILL} stroke={STRONG} stroke-width="1.25" />
            <circle cx="34" cy="134" r="4.5" fill={FILL} stroke={STRONG} stroke-width="1.25" />
          </g>
        )
      }

      {/* dependency graph */}
      {
        hint === 'dependency-graph' && (
          <g>
            <path d="M46,46 L110,76" stroke={ACCENT} stroke-width="1.5" marker-end={`url(#${uid}-a)`} />
            <path d="M46,114 L110,84" stroke={LINE} stroke-width="1" marker-end={`url(#${uid}-a)`} />
            <path d="M130,76 L194,46" stroke={LINE} stroke-width="1" marker-end={`url(#${uid}-a)`} />
            <path d="M130,84 L194,114" stroke={LINE} stroke-width="1" marker-end={`url(#${uid}-a)`} />
            <path d="M46,114 C90,150 150,150 194,114" fill="none" stroke={SOFT} stroke-width="1" stroke-dasharray="3 3" />
            {[
              [36, 42],
              [36, 118],
              [120, 80],
              [204, 42],
              [204, 118],
            ].map(([x, y], i) => (
              <circle cx={x} cy={y} r={i === 2 ? 12 : 8} fill={FILL} stroke={i === 2 ? ACCENT : STRONG} stroke-width={i === 2 ? '1.5' : '1.25'} />
            ))}
          </g>
        )
      }

      {/* proposed discovery loop */}
      {
        hint === 'discovery-loop' && (
          <g>
            <polygon points={HEX(120, 80, 52)} fill="none" stroke={SOFT} stroke-width="1.25" stroke-dasharray="5 4" />
            {HEX(120, 80, 52)
              .split(' ')
              .map((p) => {
                const [x, y] = p.split(',');
                return <circle cx={x} cy={y} r="5" fill={FILL} stroke={STRONG} stroke-width="1.25" />;
              })}
            <circle cx="120" cy="80" r="2.5" fill="var(--dg-dot)" />
          </g>
        )
      }

      {/* observation → assessment → consultation → care, with escalation */}
      {
        hint === 'care-flow' && (
          <g>
            <path d="M36,120 C70,120 62,64 96,64 C130,64 122,120 156,120 C186,120 184,72 208,72" fill="none" stroke={LINE} stroke-width="1" stroke-dasharray="4 3" />
            <line x1="156" y1="120" x2="156" y2="40" stroke={ACCENT} stroke-width="1.25" marker-end={`url(#${uid}-a)`} />
            {[
              [36, 120],
              [96, 64],
              [156, 120],
              [208, 72],
              [156, 30],
            ].map(([x, y], i) => (
              <circle cx={x} cy={y} r={i === 4 ? 6 : 9} fill={FILL} stroke={i === 4 ? ACCENT : STRONG} stroke-width={i === 4 ? '1.5' : '1.25'} />
            ))}
          </g>
        )
      }
    </svg>
  </div>

  <div class="cover-status" data-cover-status>
    <span class="cover-status-k mono">REALITY</span>
    <span class="cover-pill" data-cover-reality>{d.coverStatus}</span>
    <span class="cover-status-2 mono">{d.coverStatusSecondary}</span>
  </div>

  {isConcept && <p class="cover-concept mono">{CONCEPT_BAND[lang]}</p>}
</div>

<style>
  .cover {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: end;
  }

  @media (min-width: 720px) {
    .cover {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 1.75rem;
      align-items: end;
    }
  }

  .cover-status,
  .cover-concept {
    grid-column: 1 / -1;
  }

  /* ── text ────────────────────────────────────────────────────────────── */

  .cover-cat {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .cover-index {
    color: var(--ink);
  }

  .cover-title {
    margin-top: 0.75rem;
    font-size: 1.25rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .cover-showcase .cover-title {
    font-size: clamp(1.375rem, 2.1vw, 1.75rem);
  }

  .cover-title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .cover-sub {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .cover-type {
    margin-top: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cover-desc {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 46ch;
  }

  .cover-caps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .cover-caps li {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.2rem 0.5rem;
  }

  /* ── auxiliary mark ──────────────────────────────────────────────────── */

  .cover-visual {
    justify-self: start;
    width: 100%;
    max-width: 15rem;
  }

  @media (min-width: 720px) {
    .cover-visual {
      justify-self: end;
      max-width: 17rem;
    }
  }

  .cover-visual svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── reality ─────────────────────────────────────────────────────────── */

  .cover-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1.125rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
  }

  .cover-status-k {
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .cover-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }

  .cover-status-2 {
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  /* A concept is never allowed to acquire the visual weight of a build. */
  .cover[data-cover-concept='true'] .cover-pill {
    border-style: dashed;
    color: var(--muted);
  }

  .cover-concept {
    margin: 0;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px dashed var(--line-strong);
    border-radius: 2px;
    padding: 0.35rem 0.6rem;
    align-self: start;
    justify-self: start;
  }
</style>
