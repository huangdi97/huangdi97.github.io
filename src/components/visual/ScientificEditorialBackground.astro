---
/**
 * Scientific Editorial Background — the site's base visual (v2.2, re-layered in
 * v2.2.1).
 *
 * Why this exists. v2.1 gave every page a large raster artwork and the site
 * looked good *once the bytes arrived*. The owner's report from a real visit
 * was the opposite of that: the images visibly "load in", and the page reads as
 * a picture with some text under it. The brief's first principle is the
 * inversion — **the page is good first, the image only adds**.
 *
 * So this component is the layer that is already there when nothing else is.
 *
 * ── What v2.2.1 changed, and why ────────────────────────────────────────────
 *
 * v2.2 mounted one composition on every route and varied only the *number* of
 * fragments a mode was allowed. The owner's review found three problems, and
 * all three were structural rather than cosmetic:
 *
 *   1. **The fragments were scattered, not composed.** A formula group was six
 *      glyphs at six unrelated positions; each page's marks read as separate
 *      watermarks drifting past the text. §7–§8 ask for a *composition*: two to
 *      four groups that relate to each other and to the page's own layout.
 *   2. **Every page had roughly the same field.** Density changed by a factor
 *      of two across the whole site, which is not a hierarchy. §50–§52 ask for
 *      a real per-page variant: different marks, different positions, different
 *      density.
 *   3. **The four mark kinds were not separable.** Curve and network shared one
 *      weight token, so two of §18's four bands collapsed into one.
 *
 * So the variant is now a first-class thing. `VARIANTS` names, per route, which
 * groups mount, how heavy the page is, and where each group sits; `LAYOUT`
 * turns that into CSS. Nothing here is random — every position is a constant.
 *
 * ── The four layers, and only four ─────────────────────────────────────────
 *
 *   A  base colour     `--canvas`, the warm paper the theme already defines
 *   B  radial depth    three fixed-size radials — never a page-wide sweep
 *   C  paper grain     one 128×128 lossless tile, isotropic by measurement
 *   D  scientific marks two to four inline SVG groups, composed
 *
 * §6 is explicit that there is no fifth and no sixth. There is no blur, no
 * backdrop-filter, no repeating gradient and no second raster.
 *
 * ── Hard constraints this file holds ───────────────────────────────────────
 *
 *   · no JavaScript, no animation, no transition, no scroll effect;
 *   · `aria-hidden`, `pointer-events: none`, nothing focusable, nothing in the
 *     accessibility tree;
 *   · deterministic — no `Math.random`, no time, no per-render variation;
 *   · opacity is read from the theme's `--bg-*` tokens and scaled per variant,
 *     so no component ever hard-codes a weight;
 *   · inline SVG only — no second image request beyond the texture.
 */
export type BackgroundMode = 'home' | 'projects' | 'works' | 'research' | 'about' | 'resume' | 'opensource' | 'minimal';

export interface Props {
  /**
   * Which variant this page gets (§50–§52). Density, mark set and mark
   * placement all move together — never the palette, never the layout.
   *
   *   home        medium       hero right edge · lower left · the projects band
   *   projects    medium-low   one curve, one node group, faintest notation
   *   works       low          one curve and one notation fragment, nothing else
   *   research    medium-high  the richest field: neural · notation · curve · cell
   *   about       medium-low   a margin note, a ruled grid, a tiny node group
   *   resume      very low     one notation fragment, nothing else
   *   opensource  low          a curve and a node group
   *   minimal     wash + grain only, no marks
   */
  mode?: BackgroundMode;
}

const { mode = 'home' } = Astro.props;

/**
 * The variant table (§50–§52). Density is the only axis the owner's table
 * names, but a variant is more than a multiplier, so the set of groups travels
 * with it. No variant mounts more than four (§8's desktop ceiling); `minimal`
 * mounts none, which is the whole of what it means.
 *
 * v2.3 (§34–§37) adds `works`. It is not a copy of `projects` under a new name:
 * §36 rules out the cell, the large network and the DNA on /works — the posters
 * are the page's visual — so the set is exactly one curve and one notation
 * fragment. That is a different mark set, which is the condition §37 sets for
 * adding a variant instead of reusing one.
 */
const VARIANTS: Record<BackgroundMode, readonly string[]> = {
  home: ['formula', 'curve', 'neural'],
  projects: ['formula', 'curve', 'neural'],
  works: ['formula', 'curve'],
  research: ['neural', 'formula', 'cell', 'curve'],
  about: ['formula', 'grid', 'neural'],
  resume: ['formula'],
  opensource: ['curve', 'neural'],
  minimal: [],
};

const groups = VARIANTS[mode];
const has = (group: string) => groups.includes(group);

/* -------------------------------------------------------------------------- */
/* Geometry. Computed here rather than hand-written so the rungs of the grid   */
/* actually sit on the rules, and the network's edges actually reach its nodes.*/
/* Deterministic by construction: the only inputs are the constants below.     */
/* -------------------------------------------------------------------------- */

/**
 * A 5 × 5 ruled-grid fragment — the "notebook hint" of §27.
 *
 * v2.2 drew a 5 × 5 dot matrix here. A field of dots reads as a data matrix,
 * which is a figure; §27 asks for the *hint of ruled paper* behind a personal
 * research note, so the group is now six vertical and four horizontal
 * hairlines, unevenly spaced, and it stops before the edge of its box rather
 * than closing into a table.
 */
const GRID_COLS = [16, 54, 88, 126, 160, 198];
const GRID_ROWS = [34, 78, 122, 166];

/** One strand of the cell contour — three arcs, never a closed outline. */
const CELL_ARCS = [
  'M 58 138 C 58 58, 148 18, 218 44',
  'M 248 68 C 318 108, 318 198, 238 238',
  'M 188 252 C 118 260, 60 214, 58 138',
];

/**
 * Neural fragment: three layers, ten nodes, seven edges.
 *
 * Seven rather than all thirty-six pairs, because §17 asks for a fragment and a
 * fully connected graph is a diagram. The cobalt accent lands on two nodes and
 * one edge only — the accent is the one colour that is allowed to be *noticed*,
 * so it has to stay rare.
 */
const NEURAL_LAYERS = [
  [44, [58, 158, 258]],
  [200, [30, 118, 206, 292]],
  [356, [70, 160, 250]],
] as const;

const NEURAL_EDGES: ReadonlyArray<readonly [number, number, number, number]> = [
  [44, 58, 200, 30],
  [44, 158, 200, 118],
  [44, 258, 200, 206],
  [200, 30, 356, 70],
  [200, 118, 356, 160],
  [200, 206, 356, 250],
  [200, 292, 356, 250],
];

/** The two nodes and the one edge that carry the cobalt. */
const NEURAL_ACCENT_NODES = new Set(['44:158', '356:160']);
const NEURAL_ACCENT_EDGE = 4;

/**
 * The notation block (§17).
 *
 * Three lines, left-aligned on a shared origin with tight leading, so the group
 * reads as a margin note someone wrote down rather than as six symbols thrown
 * at the page. v2.2 spread six glyphs over a 420 × 300 box at six unrelated
 * offsets; that is the "scattered watermark" §7 names as the failure.
 */
const NOTATION = [
  { x: 6, y: 44, size: 26, text: '∂u/∂t' },
  { x: 6, y: 92, size: 24, text: '∇L(θ)' },
  { x: 6, y: 138, size: 22, text: 'p(z|x)' },
];
---

<div class="editorial-bg" data-editorial-background data-bg-mode={mode} aria-hidden="true">
  <!-- Layer A/B — the paper is a gradient field, never a flat fill (§4). -->
  <div class="ebg-wash"></div>

  <!-- Layer C — one 6.5 KB tile, repeated. Alpha-only: it can darken the paper
       but never tint it, which is why Night inverts it instead of shipping a
       second file. Isotropic by measurement, not by intent (§3). -->
  <div class="ebg-texture"></div>

  <!-- Layer D — the composition. Two to four groups, placed relative to each
       other; see LAYOUT below for what each variant draws. -->
  <div class="ebg-marks">
    {
      has('formula') && (
        <svg
          class="ebg-group ebg-formula"
          viewBox="0 0 240 168"
          data-bg-group="formula"
          data-bg-kind="math"
        >
          {NOTATION.map((line) => (
            <text x={line.x} y={line.y} font-size={line.size}>
              {line.text}
            </text>
          ))}
        </svg>
      )
    }

    {
      has('curve') && (
        <svg
          class="ebg-group ebg-curve"
          viewBox="0 0 460 240"
          data-bg-group="curve"
          data-bg-kind="math"
        >
          <path class="ebg-curve-line" d="M 12 196 C 108 196, 132 42, 236 42 S 372 186, 448 196" />
          <path class="ebg-curve-axis" d="M 12 216 H 448" />
        </svg>
      )
    }

    {
      has('neural') && (
        <svg
          class="ebg-group ebg-neural"
          viewBox="0 0 400 320"
          data-bg-group="neural"
          data-bg-kind="ai"
        >
          {NEURAL_EDGES.map(([x1, y1, x2, y2], i) => (
            <line
              class:list={['ebg-edge', i === NEURAL_ACCENT_EDGE && 'ebg-accent-stroke']}
              x1={x1}
              y1={y1}
              x2={x2}
              y2={y2}
            />
          ))}
          {NEURAL_LAYERS.flatMap(([x, ys]) =>
            ys.map((y) => (
              <circle
                class:list={[
                  'ebg-node',
                  NEURAL_ACCENT_NODES.has(`${x}:${y}`) && 'ebg-accent-fill',
                ]}
                cx={x}
                cy={y}
                r="6"
              />
            )),
          )}
        </svg>
      )
    }

    {
      has('cell') && (
        <svg
          class="ebg-group ebg-cell"
          viewBox="0 0 360 280"
          data-bg-group="cell"
          data-bg-kind="biology"
        >
          {/* Three arcs, not a closed outline: a contour that closes is a cell
              drawing, and §17 asks for a fragment of one. */}
          {CELL_ARCS.map((d) => (
            <path class="ebg-contour" d={d} />
          ))}
          <ellipse class="ebg-nucleus" cx="156" cy="140" rx="27" ry="24" />
        </svg>
      )
    }

    {
      has('grid') && (
        <svg
          class="ebg-group ebg-grid"
          viewBox="0 0 216 200"
          data-bg-group="grid"
          data-bg-kind="math"
        >
          {GRID_COLS.map((x) => (
            <line class="ebg-rule" x1={x} y1="14" x2={x} y2="186" />
          ))}
          {GRID_ROWS.map((y) => (
            <line class="ebg-rule" x1="8" y1={y} x2="208" y2={y} />
          ))}
        </svg>
      )
    }
  </div>
</div>

<style>
  /* ------------------------------------------------------------------------
     The host layer.

     Absolute, not fixed. A viewport-fixed layer stops being a sheet of paper
     the page sits on and becomes wallpaper the page slides over. `z-index: -1`
     puts the whole system above the body background and below every word.
     `overflow: hidden` crops the fragments that deliberately run past the page
     edge — which is how the cell contour stays a fragment on /research.
     ------------------------------------------------------------------------ */
  .editorial-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;

    /* Two independent dials, multiplied: one says how dense *this page* is, the
       other how dense *this viewport* is. Keeping them separate is what stops
       the phone rule from overwriting the page rule — an earlier version tried
       to derive one from the other with a self-referencing `var()`, which
       silently resolved to the fallback and gave every mode the same weight. */
    --ebg-mobile: 1;
  }

  /* ── The variant table (§50) ─────────────────────────────────────────────
     One block per route. `--ebg-scale` is the owner's density word turned into
     a number; `--ebg-wash-scale` moves the depth layer with it, because a page
     that is quiet in its marks and loud in its glow is not quiet. */
  .editorial-bg[data-bg-mode='home'] {
    --ebg-scale: 1;
    --ebg-wash-scale: 1;
  }

  .editorial-bg[data-bg-mode='projects'] {
    --ebg-scale: 0.85;
    --ebg-wash-scale: 0.9;
  }

  /* v2.3 (§35): /works is quieter than /projects. The posters on that page are
     the visual, so the field has to lose the argument — which is a density the
     table did not have. The gate asserts every variant's density is distinct,
     so this is a new rung rather than a nudge of `projects`. */
  .editorial-bg[data-bg-mode='works'] {
    --ebg-scale: 0.72;
    --ebg-wash-scale: 0.82;
  }

  .editorial-bg[data-bg-mode='research'] {
    --ebg-scale: 1.4;
    --ebg-wash-scale: 1.05;
  }

  .editorial-bg[data-bg-mode='about'] {
    --ebg-scale: 0.78;
    --ebg-wash-scale: 0.85;
  }

  .editorial-bg[data-bg-mode='resume'] {
    --ebg-scale: 0.5;
    --ebg-wash-scale: 0.6;
  }

  .editorial-bg[data-bg-mode='opensource'] {
    --ebg-scale: 0.62;
    --ebg-wash-scale: 0.8;
  }

  .editorial-bg[data-bg-mode='minimal'] {
    --ebg-scale: 0;
    --ebg-wash-scale: 0.5;
  }

  /* ── Layer B · wash ────────────────────────────────────────────────────── */

  /* Three radials with **fixed radii in rem**, not percentages of the document.
     This is the v2.2.1 correction and it is about banding rather than taste: a
     percentage-sized ellipse on a 4,000px page is a 1,200px-tall gradient, and
     a 4.8%-alpha ramp spread over 1,200px quantises on an 8-bit canvas into a
     dozen visible steps — which is a set of wide horizontal arcs, i.e. exactly
     the artefact this round was asked to remove. A fixed-size glow cannot do
     that: it stays a glow whatever the page length.
     The stops are also fully transparent well before the next gradient begins,
     so no coloured patch can become visible (§4). */
  .ebg-wash {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(40rem 28rem at 78% 1rem, var(--bg-blue), transparent 72%),
      radial-gradient(36rem 30rem at 2% 22rem, var(--bg-green), transparent 74%),
      radial-gradient(52rem 26rem at 46% 100%, var(--bg-warm), transparent 78%);
    background-repeat: no-repeat;
    opacity: var(--ebg-wash-scale);
  }

  /* ── Layer C · texture ─────────────────────────────────────────────────── */

  .ebg-texture {
    position: absolute;
    inset: 0;
    background-image: url('/texture/paper.webp');
    background-repeat: repeat;
    background-size: 128px 128px;
    opacity: var(--bg-texture);
  }

  /* The tile is black-with-alpha, so on a dark canvas it would simply vanish.
     Inverting flips the RGB and leaves the alpha alone, which turns the same
     file into light grain — no second asset, no second request (§7). */
  [data-theme='night'] .ebg-texture {
    filter: invert(1);
  }

  /* ── Layer D · the composition ─────────────────────────────────────────── */

  .ebg-marks {
    position: absolute;
    inset: 0;
  }

  .ebg-group {
    position: absolute;
    display: block;
    height: auto;
    overflow: visible;
  }

  /* ------------------------------------------------------------------------
     Placement, per variant.

     Two anchoring modes, and which one a group uses is a statement about what
     it belongs to:

       `top: <rem>`  the mark belongs to the top of the page — the hero, or the
                     band under the title. A length keeps it there when the page
                     below it grows.
       `top: <n>%`   the mark belongs to a *region* of a long page (the projects
                     band, the body of an essay). A percentage is what keeps it
                     attached to that region rather than to the first screen.

     v2.2 used percentages for everything, which is why the fragments drifted
     away from the part of the page they were drawn for.
     ------------------------------------------------------------------------ */

  /* ── home (§9) ───────────────────────────────────────────────────────────
     Three marks, and the hero's own raster artwork already carries the DNA, the
     biology and the network (§10), so nothing biological is added here.
       1  very faint notation at the hero's right edge
       2  one probability curve, lower left, clear of the hero's own subject
       3  one node group, down in the projects band                                  */
  .ebg-formula {
    top: 4.5rem;
    right: 3%;
    width: min(15rem, 21vw);
  }

  .ebg-curve {
    top: 25rem;
    left: -3%;
    width: min(22rem, 31vw);
  }

  .ebg-neural {
    top: 54%;
    left: 1%;
    width: min(16rem, 22vw);
  }

  /* ── projects (§11) ──────────────────────────────────────────────────────
     The four project drawings are the page's subject, so the field drops to
     three quiet marks and every one of them is pushed to an edge. */
  .editorial-bg[data-bg-mode='projects'] .ebg-formula {
    top: 3.5rem;
    right: 2%;
    width: min(13rem, 18vw);
  }

  .editorial-bg[data-bg-mode='projects'] .ebg-curve {
    top: 34%;
    left: -4%;
    width: min(21rem, 29vw);
  }

  .editorial-bg[data-bg-mode='projects'] .ebg-neural {
    top: 70%;
    left: auto;
    right: 1%;
    width: min(14rem, 19vw);
  }

  /* ── works (§36) ─────────────────────────────────────────────────────────
     Two marks, and neither is a figure. §36 allows one curve and one subtle
     formula fragment on this page and rules out the cell, the network and the
     DNA outright — the works' own posters are the visual, and a background that
     competed with them would be the thing §35 is guarding against.

     Both sit at the outer edges of the page for the same reason: the gallery is
     a tall single column of large images, so the only space the field can
     occupy without sitting behind a poster is the margin. */
  .editorial-bg[data-bg-mode='works'] .ebg-formula {
    top: 3rem;
    right: 3%;
    width: min(12rem, 16vw);
  }

  .editorial-bg[data-bg-mode='works'] .ebg-curve {
    top: 46%;
    left: -5%;
    width: min(20rem, 27vw);
  }

  /* ── research (§13–§18) ──────────────────────────────────────────────────
     The one page whose background is meant to be read as a composition. The
     hero puts its copy in the left 46%, so the right half is the canvas and the
     four groups are placed against each other inside it:

       neural    upper centre-right — the anchor
       formula   top right corner — the margin note beside it
       cell      right edge, running off it, so it stays a fragment
       curve     below the network, sweeping back towards the centre

     They overlap in no place and share one diagonal, which is what makes them a
     composition rather than four watermarks. */
  .editorial-bg[data-bg-mode='research'] .ebg-neural {
    top: 3.5rem;
    left: 50%;
    width: min(18rem, 24vw);
  }

  .editorial-bg[data-bg-mode='research'] .ebg-formula {
    top: 2.75rem;
    left: auto;
    right: 5%;
    width: min(13rem, 17vw);
  }

  .editorial-bg[data-bg-mode='research'] .ebg-cell {
    top: 12rem;
    left: auto;
    right: -4%;
    width: min(20rem, 27vw);
  }

  .editorial-bg[data-bg-mode='research'] .ebg-curve {
    top: 17rem;
    left: 47%;
    width: min(23rem, 32vw);
  }

  /* ── about (§25–§27) ─────────────────────────────────────────────────────
     A personal research environment, not a second /research. One margin note,
     the ruled-paper hint, and a small node group — no cell, no helix, no large
     network. */
  .editorial-bg[data-bg-mode='about'] .ebg-formula {
    top: 3.5rem;
    right: 4%;
    width: min(12rem, 16vw);
  }

  .editorial-bg[data-bg-mode='about'] .ebg-grid {
    top: 11rem;
    left: auto;
    right: 7%;
    width: min(11rem, 15vw);
  }

  .editorial-bg[data-bg-mode='about'] .ebg-neural {
    top: 34%;
    left: 1%;
    width: min(12rem, 16vw);
  }

  /* ── resume (§29–§31) ────────────────────────────────────────────────────
     A professional document. One notation fragment in the top right, at half
     weight, and nothing else anywhere on the page. */
  .editorial-bg[data-bg-mode='resume'] .ebg-formula {
    top: 3rem;
    right: 4%;
    width: min(11rem, 15vw);
  }

  /* ── opensource (§52) ────────────────────────────────────────────────────
     Declared and reserved. The repository's open-source surface is a section of
     /projects rather than a route of its own, so nothing mounts this today; it
     exists so that the day it becomes a page it gets its own field instead of
     inheriting /projects' one. */
  .editorial-bg[data-bg-mode='opensource'] .ebg-curve {
    top: 30%;
    left: -3%;
    width: min(20rem, 28vw);
  }

  .editorial-bg[data-bg-mode='opensource'] .ebg-neural {
    top: 62%;
    left: auto;
    right: 2%;
    width: min(14rem, 19vw);
  }

  /* ── grid ──────────────────────────────────────────────────────────────── */

  .ebg-grid {
    top: 48%;
    left: auto;
    right: 5%;
    width: min(12rem, 16vw);
  }

  /* ── Weight ──────────────────────────────────────────────────────────────
     One token per mark kind, scaled by the variant. §18 asks for the four kinds
     to be separable, and on /research they are: notation 0.059, curve 0.070,
     cell 0.073, network 0.081 — four distinct values inside the four bands the
     owner named. Notation is the lightest thing on the page and the network the
     heaviest, which is the same hierarchy the artwork uses. */
  .ebg-formula {
    opacity: calc(var(--bg-mark) * var(--ebg-scale) * var(--ebg-mobile));
  }

  .ebg-curve {
    opacity: calc(var(--bg-curve) * var(--ebg-scale) * var(--ebg-mobile));
  }

  .ebg-neural {
    opacity: calc(var(--bg-graph) * var(--ebg-scale) * var(--ebg-mobile));
  }

  .ebg-cell {
    opacity: calc(var(--bg-bio) * var(--ebg-scale) * var(--ebg-mobile));
  }

  .ebg-grid {
    opacity: calc(var(--bg-grid) * var(--ebg-scale) * var(--ebg-mobile));
  }

  /* ── Ink ───────────────────────────────────────────────────────────────── */

  /* Notation is set in the mono face everywhere on this site, and a background
     fragment is not the exception. */
  .ebg-formula text {
    font-family: var(--font-mono);
    fill: var(--bg-ink);
  }

  .ebg-curve-line {
    fill: none;
    stroke: var(--bg-ink);
    stroke-width: 1.6;
  }

  .ebg-curve-axis {
    fill: none;
    stroke: var(--bg-ink);
    stroke-width: 0.8;
    /* `stroke-opacity` rather than `opacity`: this is a drawing property, not a
       weight. Every `opacity` in this file is a theme dial, and the gate asserts
       that none of them is hard-coded. */
    stroke-opacity: 0.6;
  }

  .ebg-edge {
    stroke: var(--bg-ink);
    stroke-width: 1;
  }

  .ebg-node {
    fill: var(--bg-ink);
  }

  /* The accent is the site's cobalt, never a new colour. */
  .ebg-accent-fill {
    fill: var(--bg-accent);
  }

  .ebg-accent-stroke {
    stroke: var(--bg-accent);
  }

  .ebg-contour {
    fill: none;
    stroke: var(--bg-bio-ink);
    stroke-width: 1.5;
  }

  .ebg-nucleus {
    fill: none;
    stroke: var(--bg-bio-ink);
    stroke-width: 1.1;
    stroke-opacity: 0.8;
  }

  .ebg-rule {
    stroke: var(--bg-ink);
    stroke-width: 0.9;
    stroke-opacity: 0.55;
  }

  /* ── Mobile (§54) ────────────────────────────────────────────────────────
     "Fewer, not smaller." The owner's rule is a phone keeps at most two groups,
     and per page: /research one, /about one, /home one, /projects and /resume
     none. This is a *hide* list rather than a shrink list, because a mark that
     has been shrunk to fit is still a mark competing with the text.

     The density dial drops with it, so the groups that survive are also lighter
     than their desktop selves. */
  @media (max-width: 899px) {
    .editorial-bg {
      --ebg-mobile: 0.7;
    }

    /* /projects: the four drawings are the page; the field gets out of the way
       entirely. */
    .editorial-bg[data-bg-mode='projects'] .ebg-group {
      display: none;
    }

    /* /works (v2.3, §36): same argument as /projects, and stronger — a phone
       shows one poster at a time at nearly full width, so there is no margin
       for a mark to live in at all. */
    .editorial-bg[data-bg-mode='works'] .ebg-group {
      display: none;
    }

    /* /resume: a professional document carries no scientific marks at all. */
    .editorial-bg[data-bg-mode='resume'] .ebg-group {
      display: none;
    }

    /* /research: one group survives — the network, which is the one that says
