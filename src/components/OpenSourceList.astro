---
/**
 * Open Source list — the public repositories, reduced (v2.2.1, §45–§48).
 *
 * What it was. A repository *table*: name, description, and a four-row metadata
 * block per entry carrying role, language, licence and last-update date, under
 * a snapshot line that announced when the metadata had been captured. Every
 * field was real and every field was checkable, and together they made the page
 * read like a repo database rather than like someone's work — §45's complaint.
 *
 * What §46 leaves is four things per repository:
 *
 *     repo name · one-line description · language · GitHub →
 *
 * §47 is explicit about the rest: licence, update date, the metadata snapshot
 * date and the hand-written "role" all go, because "GitHub 自己会显示这些".
 * Nothing was deleted from `src/data/oss.ts` — the fields are still there and
 * still hand-checked; the page simply stops printing what the repository's own
 * page already says better.
 *
 * §48 is about the copy above the list. v1.6 explained the implementation —
 * "语言、许可证与更新日期来自已签入 GitHub 元数据……不做运行时 API 调用" — which
 * is a note to a maintainer, not to a visitor. It is now one line that says what
 * the list is.
 */
import { useT, type Lang } from '../i18n/ui';
import { OSS_HIGHLIGHTS } from '../data/oss';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
---

<ul class="oss-list">
  {
    OSS_HIGHLIGHTS.map((repo) => (
      <li>
        <a href={repo.url} class="oss-item" target="_blank" rel="noopener noreferrer">
          <span class="oss-name">{repo.name}</span>
          <span class="oss-desc">{lang === 'zh' ? repo.descriptionZh : repo.descriptionEn}</span>
          <span class="oss-lang mono">{repo.language ?? '—'}</span>
          <span class="oss-go mono">
            GitHub
            <span aria-hidden="true">↗</span>
            <span class="sr-only"> ({t('a11y.external')})</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .oss-list {
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  /* Four columns, and no metadata block: the row is a line of the list, not a
     card of facts. */
  .oss-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .oss-item {
      grid-template-columns: 13rem minmax(0, 1fr) 6rem auto;
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .oss-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--ink);
  }

  .oss-desc {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .oss-lang {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .oss-go {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
    transition: color var(--dur-fast) var(--ease);
  }

  .oss-item:hover .oss-go {
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .oss-go {
      justify-self: end;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
