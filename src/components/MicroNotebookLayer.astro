    data-sci-mobile="drop"
    style="--sci-top:19%;--sci-right:11%;--sci-w:150px"
  >
    <svg viewBox="0 0 150 44" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <text x="4" y="30" font-size="22" fill="currentColor">θ ∈ ℝⁿ</text>
    </svg>
  </div>

  <div
    class="sci-plaque sci-micro"
    data-sci-mobile="drop"
    style="--sci-top:41%;--sci-left:22%;--sci-w:120px"
