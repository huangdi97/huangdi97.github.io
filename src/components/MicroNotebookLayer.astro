---
/**
 * Micro Notebook Layer — Layer B of the Global Scientific Canvas (v1.6).
 *
 * This is the v1.4.1 ambient repertoire, kept: small notation, ticks,
 * coordinates, matrix fragments, arrows, axis labels and two-node links. In
 * v1.6 it is explicitly the *second* layer — detail around the macro plaques,
 * never the whole story. It is inked at `--science-micro` (0.02–0.07), roughly
 * a third of the macro layer, so it reads as pencil in the margin rather than
 * as a competing composition.
 *
 * Same discipline as the macro layer: inline SVG, aria-hidden, pointer
 * events off, every colour a theme token, and most marks dropped on a phone.
 */

/** Deterministic pseudo-random — identical marks on every build. */
const rnd = (i: number) => {
  const v = Math.sin(i * 12.9898 + 78.233) * 43758.5453;
  return v - Math.floor(v);
};

/** A 3×3 matrix fragment, the smallest legible expression block. */
const miniMatrix = (x0: number, y0: number, cols: number, rows: number, cell: number) =>
  Array.from({ length: cols * rows }, (_, k) => {
    const v = rnd(k * 2.31 + 17);
    const o = v > 0.86 ? 0.9 : v > 0.7 ? 0.55 : v > 0.55 ? 0.28 : 0.1;
    return { x: x0 + (k % cols) * cell, y: y0 + Math.floor(k / cols) * cell, o };
  });

const MINI_A = miniMatrix(16, 16, 3, 3, 11);
const MINI_B = miniMatrix(16, 14, 1, 4, 11);

const TICKS = [0, 1, 2, 3, 4];
---

<div class="micro">
  <!-- ── notation fragments ─────────────────────────────────────────────── -->
  <div
    class="sci-plaque sci-micro"
    data-sci-mobile="keep"
    style="--sci-top:6%;--sci-left:42%;--sci-w:180px"
