      <text x="4" y="30" font-size="22" fill="currentColor">X ∈ ℝⁿˣᵖ</text>
    </svg>
  </div>

  <div
    class="sci-plaque sci-micro"
    data-sci-mobile="drop"
    style="--sci-top:66%;--sci-left:11%;--sci-w:180px"
  >
    <svg viewBox="0 0 180 44" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <text x="4" y="30" font-size="20" fill="currentColor">P(H | D)</text>
    </svg>
  </div>

  <div
    class="sci-plaque sci-micro"
    data-sci-mobile="keep"
    style="--sci-top:94%;--sci-left:17%;--sci-w:230px"
  >
    <svg viewBox="0 0 230 44" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <text x="4" y="30" font-size="21" fill="currentColor">zₜ → zₜ₊₁</text>
    </svg>
  </div>

  <!-- ── coordinates and ticks ──────────────────────────────────────────── -->
  <div
    class="sci-plaque sci-micro"
    data-sci-mobile="drop"
    style="--sci-top:9%;--sci-right:29%;--sci-w:130px"
  >
    <svg viewBox="0 0 130 90" focusable="false" xmlns="http://www.w3.org/2000/svg">
