  >
    <svg viewBox="0 0 110 72" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M22,10 L10,10 L10,62 L22,62" />
        <path d="M88,10 L100,10 L100,62 L88,62" />
      </g>
      <text x="42" y="44" font-size="16" fill="currentColor">∂/∂t</text>
    </svg>
  </div>
</div>
