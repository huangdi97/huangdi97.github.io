      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M12,12 L6,12 L6,52 L12,52" />
        <path d="M62,12 L68,12 L68,52 L62,52" />
      </g>
    </svg>
  </div>

  <div
    class="sci-plaque sci-micro"
    data-sci-mobile="keep"
    style="--sci-top:70%;--sci-right:37%;--sci-w:70px"
  >
    <svg viewBox="0 0 70 70" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <g fill="currentColor" stroke="none">
        {MINI_B.map((c) => <rect x={c.x} y={c.y} width="9" height="9" fill-opacity={c.o} />)}
      </g>
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <path d="M12,10 L6,10 L6,62 L12,62" />
        <path d="M34,10 L40,10 L40,62 L34,62" />
