    data-sci-mobile="drop"
    style="--sci-top:57%;--sci-left:30%;--sci-w:140px"
  >
    <svg viewBox="0 0 140 56" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke="currentColor" stroke-width="1.5">
