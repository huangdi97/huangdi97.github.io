    data-sci-mobile="keep"
    style="--sci-top:23%;--sci-left:54%;--sci-w:150px"
  >
    <svg viewBox="0 0 150 54" focusable="false" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="6" y1="34" x2="144" y2="34" />
        {TICKS.map((i) => <line x1={6 + i * 34} y1="34" x2={6 + i * 34} y2="42" />)}
      </g>
      <text x="6" y="20" font-size="14" fill="currentColor">t → t + 1</text>
    </svg>
  </div>

  <div
    class="sci-plaque sci-micro"
    data-sci-mobile="drop"
    style="--sci-top:84%;--sci-right:21%;--sci-w:150px"
  >
    <svg viewBox="0 0 150 54" focusable="false" xmlns="http://www.w3.org/2000/svg">
