---
/**
 * Project entry — one project on /projects (v2.2.1, §34–§35).
 *
 * What this is now, and what it stopped being. v2.1 cut the entry from a
 * bordered card with eight labelled slots down to a name, a positioning line,
 * two or three lines of intro, a status and two links. That was the right
 * direction and not far enough: the owner's v2.2.1 review found the intro
 * paragraph had grown back into a project description — "把分散的健康信息整理
 * 成…", "研究如何用模型表示细胞状态…" — and a public directory page is not the
 * place for it. §34 gives the ceiling, and it is five fields:
 *
 *   Project Name · one-line positioning · status · View project → ·
 *   GitHub ↗ (optional)
 *
 * So the intro paragraph is gone from this page. Nothing was deleted from the
 * data: `description` is still in every project file, and it still supplies the
 * case page's meta and OG description. The case page's own body was always the
 * fuller account, which is where §35 says the longer text belongs.
 * The page keeps the project's own artwork — the same file the homepage shows —
 * because §37 is explicit that the image carries the visual and the words carry
 * the identification.
 */
import { useT, type Lang } from '../i18n/ui';
import { projectHref, type ProjectEntry as Entry } from '../lib/projects';
import { projectStatus } from '../lib/projectStatus';
import { ARTWORK_LABELS, ART_ALT, ENTRY_SIZES } from '../data/artwork';
import Artwork, { type ArtworkName } from './Artwork.astro';

export interface Props {
  project: Entry;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useT(lang);
const d = project.data;

const href = projectHref(lang, d.slug);
const status = projectStatus(d.slug, lang, t);

/* Only the four projects with a real artwork get an entry. §36 and §51 both
   rule out standing a drawing in for a project that has none, and §39 hides the
   three unfinished ones from this page entirely rather than listing them in a
   text index — the data is untouched, the public page simply stops publishing
   work the owner does not want shown yet. */
const artwork = ARTWORK_LABELS[d.slug] ? (d.slug as ArtworkName) : null;
---

<article class="entry" data-project-entry data-slug={d.slug}>
  {
    artwork && (
      <div class="entry-art">
        <Artwork
          name={artwork}
          label={ARTWORK_LABELS[artwork][lang]}
          alt={ART_ALT[artwork]?.[lang]}
          sizes={ENTRY_SIZES}
        />
      </div>
    )
  }

  <div class="entry-copy">
    <h2 class="entry-name">
      <a href={href}>{d.title}</a>
    </h2>

    <p class="entry-line">{d.publicLine}</p>

    {status && <p class="entry-status">{status}</p>}

    <p class="entry-actions">
      <a href={href} class="entry-link">
        {t('work.project')}
        <span aria-hidden="true">→</span>
      </a>

      {
        d.repo && (
          <a href={d.repo} class="entry-repo" target="_blank" rel="noopener noreferrer">
            GitHub
            <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </p>
  </div>
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
  }

  .entry-art {
    min-width: 0;
  }

  .entry-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .entry-name {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.026em;
    font-weight: 500;
    margin: 0;
  }

  .entry-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  /* The positioning line carries the ink. v2.2.1 removed the paragraph that
     used to sit under it (§35); what is left is one line, so it is set as the
     entry's second voice rather than as a lead-in to a block. */
  .entry-line {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    letter-spacing: -0.012em;
    color: var(--muted);
  }

  /* One status, in the mono face but never shouted: no pill, no badge, no
     second code label beside it (§13). The dot is a pseudo-element, so the
     accessible text stays the status alone. */
  .entry-status {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .entry-status::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    transform: translateY(-1px);
    opacity: 0.7;
  }

  .entry-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin: auto 0 0;
    padding-top: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .entry-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .entry-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .entry-repo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
    transition: color var(--dur-fast) var(--ease);
  }

  .entry-repo:hover {
    color: var(--ink);
  }
</style>
