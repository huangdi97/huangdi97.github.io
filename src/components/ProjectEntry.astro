---
/**
 * Project entry — one project on /projects (v2.1, §10–§14).
 *
 * What this replaces. v1.6–v2.0 rendered /projects as a filterable grid of
 * cards. Each card carried a words-first cover, a category eyebrow, a type
 * line, a description, a reality pill, a second code label, a keyword list, a
 * case link, a repository link and a status word — eight labelled slots, seven
 * cards, and no image anywhere on the page. The owner's read was that the page
 * had become a project manual rather than a portfolio.
 *
 * v2.1 gives the entry a real image — the project's own artwork, the same file
 * the homepage shows (§11, §43) — and cuts the copy to what §13 allows:
 *
 *   name · one line of positioning · two or three lines of public intro ·
 *   one status · one project link (plus the repository)
 *
 * Removed: the category eyebrow, the capability list, the keyword pills, the
 * second code label, the card border, the card fill and the hover lift. Entries
 * are separated by whitespace, and the image is not a thumbnail placed on a
 * panel — it is the drawing itself, in the same frame the homepage uses.
 *
 * The positioning line and the intro both come from the project's own
 * frontmatter, so this page cannot drift from the homepage row or from the
 * project file.
 */
import { useT, type Lang } from '../i18n/ui';
import { projectHref, type ProjectEntry as Entry } from '../lib/projects';
import { projectStatus } from '../lib/projectStatus';
import { ARTWORK_LABELS, ART_ALT } from '../data/artwork';
import Artwork, { type ArtworkName } from './Artwork.astro';

export interface Props {
  project: Entry;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useT(lang);
const d = project.data;

const href = projectHref(lang, d.slug);
const status = projectStatus(d.slug, lang, t);

/* Only the four projects with a real artwork get an entry; the rest are listed
   in the light "other work" index below, because §36 and §51 both rule out
   standing in a drawing for a project that has none. */
const artwork = ARTWORK_LABELS[d.slug] ? (d.slug as ArtworkName) : null;
---

<article class="entry" data-project-entry data-slug={d.slug}>
  {
    artwork && (
      <div class="entry-art">
        <Artwork name={artwork} label={ARTWORK_LABELS[artwork][lang]} alt={ART_ALT[artwork]?.[lang]} />
      </div>
    )
  }

  <div class="entry-copy">
    <h2 class="entry-name">
      <a href={href}>{d.title}</a>
    </h2>

    <p class="entry-line">{d.publicLine}</p>
    <p class="entry-intro">{d.description}</p>

    {status && <p class="entry-status">{status}</p>}

    <p class="entry-actions">
      <a href={href} class="entry-link">
        {t('work.project')}
        <span aria-hidden="true">→</span>
      </a>

      {
        d.repo && (
          <a href={d.repo} class="entry-repo" target="_blank" rel="noopener noreferrer">
            GitHub
            <span aria-hidden="true">↗</span>
          </a>
        )
      }
    </p>
  </div>
</article>

<style>
  .entry {
    display: flex;
    flex-direction: column;
  }

  .entry-art {
    min-width: 0;
  }

  .entry-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-top: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .entry-name {
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    letter-spacing: -0.026em;
    font-weight: 500;
    margin: 0;
  }

  .entry-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }

  /* The positioning line carries the ink; the intro steps back to muted. Two
     levels, so the entry has a reading order rather than two grey paragraphs. */
  .entry-line {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  .entry-intro {
    margin: 0.625rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--muted);
  }

  /* One status, in the mono face but never shouted: no pill, no badge, no
     second code label beside it (§13). The dot is a pseudo-element, so the
     accessible text stays the status alone. */
  .entry-status {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .entry-status::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    transform: translateY(-1px);
    opacity: 0.7;
  }

  .entry-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin: auto 0 0;
    padding-top: clamp(1.25rem, 2.2vw, 1.75rem);
  }

  .entry-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .entry-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .entry-repo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
    transition: color var(--dur-fast) var(--ease);
  }

  .entry-repo:hover {
    color: var(--ink);
  }
</style>
