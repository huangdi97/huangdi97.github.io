---
/**
 * Vertical architecture flow. Rendered as real HTML text rather than an image
 * so it stays selectable, translatable and readable on small screens.
 */

export interface Props {
  steps: string[];
  title?: string;
}

const { steps, title } = Astro.props;
---

{
  steps.length > 0 && (
    <div class="arch">
      {title && <p class="eyebrow mb-6">{title}</p>}
      <ol class="arch-list">
        {steps.map((step, i) => (
          <li class="arch-item">
            <span class="arch-dot" aria-hidden="true" />
            <span class="arch-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="arch-label">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .arch-list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Continuous rail behind the nodes */
  .arch-list::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 18px;
    bottom: 18px;
    width: 1px;
    background: var(--line);
  }

  .arch-item {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0 0.55rem 2rem;
  }

  .arch-dot {
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 11px;
    height: 11px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--canvas);
  }

  .arch-item:first-child .arch-dot {
    border-color: var(--accent);
    background: var(--accent);
  }

  .arch-num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--faint);
    min-width: 1.75rem;
  }

  .arch-label {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }

  .night .arch-list::before {
    background: var(--artifact-line);
  }
  .night .arch-dot {
    background: var(--artifact-bg);
    border-color: rgba(255, 255, 255, 0.3);
  }
  .night .arch-label {
    color: var(--artifact-ink);
  }
</style>
