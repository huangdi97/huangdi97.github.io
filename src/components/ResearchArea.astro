---
/**
 * One research direction (v2.1).
 *
 * What this replaces. v1.6 rendered a direction as a small specification: the
 * index, the title, a "Core question" block, a "Current interests" block with
 * four bulleted items naming techniques, and a "Related projects" block. The
 * four bullets are the part §22–§24 removes — they described how the work would
 * be done, and a public research page states what the question is.
 *
 * What is left is the index, the title, one paragraph and the projects the
 * direction touches. The paragraph carries the ink; the index and the project
 * states stay in the quiet mono face.
 *
 * The project states are still read from the evidence layer and never written
 * here, so TaiYi Lingjing reads "Concept / Not Started" on the link itself
 * rather than inheriting the weight of the four directions around it (§28).
 */
import { useT, type Lang } from '../i18n/ui';
import type { ResearchArea as Area } from '../data/research';
import { getProjectEvidence } from '../data/evidence';

export interface Props {
  area: Area;
  lang: Lang;
  /** Heading level for the area title. */
  headingLevel?: 'h2' | 'h3';
}

const { area, lang, headingLevel = 'h3' } = Astro.props;
const t = useT(lang);
const Heading = headingLevel;

const stateOf = (href: string) => {
  const slug = href.replace(/\/+$/, '').split('/').pop() ?? '';
  return getProjectEvidence(slug)?.headline[lang] ?? null;
};
---

<article class="research-area">
  <div class="area-head">
    <span class="index-num">{area.index}</span>
    <Heading class="h3 area-title" id={area.slug}>{area.title}</Heading>
  </div>

  <div class="area-body">
    <p class="area-summary">{area.summary}</p>

    {
      area.projects.length > 0 && (
        <div class="area-block">
          <p class="mono">{t('research.projects')}</p>
          <ul class="area-links">
            {area.projects.map((p) => (
              <li>
                <a href={p.href} class="link-arrow">
                  {p.label}
                  {stateOf(p.href) && <span class="area-state">{stateOf(p.href)}</span>}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</article>

<style>
  .research-area {
    display: grid;
    gap: 1.25rem 3rem;
    padding-block: 2.25rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1024px) {
    .research-area {
      grid-template-columns: 18rem 1fr;
      gap: 3rem;
    }
  }

  .area-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .area-title {
    max-width: 20ch;
  }

  .area-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* The direction's only paragraph. Larger than body text and set at a reading
     measure, because it is the whole of what the row says. */
  .area-summary {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    letter-spacing: -0.012em;
    color: var(--ink);
    max-width: 58ch;
  }

  .area-block {
    max-width: 62ch;
  }

  .area-links {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  /* The project's own evidence headline, read-only. A concept never wears a
     build's ink here either. */
  .area-state {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .area-state::before {
    content: '· ';
  }
</style>
