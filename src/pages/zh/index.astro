---
/**
 * Homepage (Chinese) — v1.6: reduction.
 *
 * v1.5 had twelve blocks. Hero, NOW, Selected Work, Selected Artifacts,
 * Background, Mathematical Biology, Equation, Research, How I Work, Open
 * Source, Lab Notes, About/Contact. Read top to bottom it answered "who are
 * you" five times and "what have you built" twice, and it had stopped being a
 * personal scientific portfolio and become a table of contents for the whole
 * site.
 *
 * v1.6 keeps six, and every one of them answers a different question:
 *
 *   Hero                    who are you?
 *   Selected Work           what have you built?
 *   Mathematics × Biology × AI   how do you read a problem?
 *   Research & Notes        what are you thinking about now?
 *   About / Contact         how do I find out more?
 *   Footer                  — continuity, not a section
 *
 * Everything removed from this page still exists — it was relocated, not
 * deleted. See the v1.6 report for the full move list; the short version:
 *
 *   NowStrip              → /projects
 *   SelectedArtifacts     → /projects  (it is an evidence room, and evidence
 *                                       belongs beside the case studies)
 *   BackgroundTimeline    → /about
 *   ProcessRail           → /about     (already there as the approach timeline)
 *   Open Source table     → /projects
 *   Full research list    → /research
 *   Lab Notes log         → /research
 *   EquationNote          → /research, and fused once into Math × Bio × AI
 *
 * The scientific background is no longer per-section: BaseLayout mounts one
 * GlobalScientificCanvas behind the whole document, so the field runs from the
 * first line to the footer without a single opaque block interrupting it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import HeroSystem from '../../components/HeroSystem.astro';
import MathematicsBiologyAI from '../../components/MathematicsBiologyAI.astro';
import ResearchNotesPreview from '../../components/ResearchNotesPreview.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import { SITE } from '../../config/site';
import { useT, localizedPath } from '../../i18n/ui';
import { getFeaturedProjects, projectsHref } from '../../lib/projects';
import { personSchema } from '../../data/profile';

const lang = 'zh' as const;
const t = useT(lang);

/** Four, not five. PDIG and TaiYi keep full pages under /projects. */
const featured = await getFeaturedProjects(lang, 4);

const path = '/zh/';
const enPath = '/';
const zhPath = '/zh/';

const personLd = personSchema(lang);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.nameEn} — Personal AI Lab`,
  url: SITE.url,
  inLanguage: 'zh-Hans',
  description: SITE.description.zh,
  author: { '@type': 'Person', name: SITE.nameEn },
};
---

<BaseLayout
  title={`${SITE.nameZh} — 个人 AI 实验室`}
  description={SITE.description.zh}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/home.png"
  type="profile"
  jsonLd={[personLd, websiteLd]}
>
  <!-- ───────────────────────────── 首屏 / HERO ────────────────────────── -->
  <section class="shell hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t('hero.eyebrow')}</p>
        <h1 class="display hero-title">{t('hero.title')}</h1>
        <p class="hero-sub">{t('hero.subtitle')}</p>
        <p class="hero-statement">{t('hero.statement')}</p>
        <p class="lead hero-support">{t('hero.support')}</p>

        <div class="hero-actions">
          <a href={projectsHref(lang)} class="btn btn-primary">{t('hero.cta.work')}</a>
          <a href={SITE.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
            {t('hero.cta.github')}
          </a>
          <a href={localizedPath(lang, '/resume')} class="btn btn-outline">
            {t('hero.cta.resume')}
          </a>
        </div>
      </div>

      <div class="hero-figure">
        <div class="hero-field field-grid">
          <HeroSystem label={t('a11y.heroField')} />
        </div>
      </div>
    </div>

    <div class="hero-capabilities">
      <p class="mono">{t('hero.capabilities')}</p>
      <ul>
        {SITE.focusAreas.map((area) => <li>{area.zh}</li>)}
      </ul>
    </div>
  </section>

  <!-- ─────────────────────── 精选项目 / SELECTED WORK ──────────────────── -->
  <section class="shell section" id="work">
    <SectionHeading
      eyebrow={t('work.eyebrow')}
      title={t('work.title')}
      lead={t('work.lead')}
      href={projectsHref(lang)}
      linkLabel={t('work.all')}
    />

    <div class="showcase-list">
      {featured.map((project, i) => <ProjectShowcase project={project} lang={lang} index={i} />)}
    </div>
  </section>

  <!-- ─────────────────── 数学 × 生物 × AI / MATHEMATICS × BIOLOGY × AI ─── -->
  <MathematicsBiologyAI lang={lang} />

  <!-- ───────────────────── 研究与札记 / RESEARCH & NOTES ──────────────── -->
  <ResearchNotesPreview lang={lang} />

  <!-- ───────────────────── 关于 / 联系 / ABOUT & CONTACT ──────────────── -->
  <section class="shell section-tight" id="contact">
    <div class="contact-band">
      <div class="contact-copy">
        <p class="eyebrow">{t('home.contact.eyebrow')}</p>
        <h2 class="h2 contact-name">{SITE.nameZh}</h2>
        <p class="lead contact-line">{t('home.contact.line')}</p>
        <a href={localizedPath(lang, '/about')} class="link-arrow contact-more">
          {t('home.contact.more')}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="contact-links">
        <ContactLinks lang={lang} variant="inline" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }
  }

  .hero-title {
    margin-top: 1.25rem;
  }

  .hero-sub {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .hero-statement {
    margin-top: 1.75rem;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.38;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }

  .hero-support {
    margin-top: 1.25rem;
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-figure {
    display: none;
  }

  .hero-field {
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  @media (min-width: 900px) {
    .hero-figure {
      display: block;
    }
  }

  .hero-capabilities {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero-capabilities ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .hero-capabilities li {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .showcase-list {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 6rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* No surface, no border, no card: the closing band is part of the page, and
     a large white box here would cut the scientific canvas in half — which is
     the same mistake the old footer made in black. */
  .contact-band {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .contact-band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .contact-name {
    margin-top: 0.75rem;
  }

  .contact-line {
    margin-top: 0.5rem;
    max-width: 40ch;
  }

  .contact-more {
    display: inline-flex;
    margin-top: 1.25rem;
  }

  .contact-links {
    padding-top: 0.25rem;
  }
</style>
