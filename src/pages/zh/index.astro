---
/**
 * Homepage (Chinese) — v2.0-P0 visual reset.
 *
 * NOT A RELEASE. Paper only, /zh reviewed, awaiting owner visual approval.
 *
 * This page is not an improvement on v1.7. It abandons the v1.7 visual paradigm.
 *
 * What was wrong. v1.7 answered "make the homepage shorter" and "stop it reading
 * as a document" by rearranging the same ingredients: a hero that was a text
 * column beside the page-wide scientific canvas, Selected Work as a 2 × 2 mosaic
 * of bordered cards, and a statement band. It was shorter. It was still built
 * out of one hairline-geometry language used everywhere — background contour,
 * background formula, card borders, project diagrams — and the owner's verdict
 * was that it was not beautiful.
 *
 * The reset (§3–§7):
 *
 *   · the page-wide canvas is gone from the homepage. It was the reason every
 *     screen carried the same texture;
 *   · the hero is one complete editorial artwork, not a field of marks. It is
 *     the strongest visual on the page, and the only one in the first screen;
 *   · the four featured projects are four stacked rows, alternating sides, each
 *     with its own drawing, its name, one line of type, one status and one link.
 *     No cards, no index numbers, no keyword pills, no proof lines;
 *   · Mathematics × Biology × AI is no longer on the homepage (§32 of the v2.0-P1
 *     brief). The component and its copy still exist, and /research still carries
 *     the argument; the homepage simply closes from the work to the contact band;
 *   · the close is a name, a positioning line and four links. No card, no
 *     eyebrow, no second content block.
 *
 * The visual rhythm is deliberate (§9): strong (hero) → clear (work) → close.
 * It is not one texture all the way down.
 *
 * Page order (§34): Header · Hero · Featured Projects · Contact · Footer.
 * Research & Notes stays off the homepage; the component and its data are
 * untouched.
 *
 * See V2_0_P1_FINAL_ARTWORK_INTEGRATION_REPORT.md for what is deliberately
 * unfinished, and src/pages/index.astro for the English mirror.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Artwork from '../../components/Artwork.astro';
import ProjectFeatureRow from '../../components/ProjectFeatureRow.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import { SITE } from '../../config/site';
import { useT, localizedPath } from '../../i18n/ui';
import { getFeaturedProjects, projectsHref } from '../../lib/projects';
import { ARTWORK_LABELS, ART_ALT } from '../../data/artwork';
import { personSchema } from '../../data/profile';

const lang = 'zh' as const;
const t = useT(lang);

/** Four, not five. PDIG and TaiYi keep full pages under /projects. */
const featured = await getFeaturedProjects(lang, 4);

const path = '/zh/';
const enPath = '/';
const zhPath = '/zh/';

const personLd = personSchema(lang);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.nameEn} — Personal AI Lab`,
  url: SITE.url,
  inLanguage: 'zh-Hans',
  description: SITE.description.zh,
  author: { '@type': 'Person', name: SITE.nameEn },
};
---

<BaseLayout
  title={`${SITE.nameZh} — 个人 AI 实验室`}
  description={SITE.description.zh}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/home.png"
  type="profile"
  jsonLd={[personLd, websiteLd]}
  minimalFooter={true}
  canvas={false}
>
  <!-- ───────────────────────────── 首屏 / HERO ──────────────────────────
       The name first, then the drawing beside it (§8). One artwork, no figure,
       no panel, no border, and no background canvas behind either half. -->
  <section class="shell hero">
    <div class="hero-copy">
      <h1 class="hero-name">{t('hero.title')}</h1>
      <p class="hero-role">{t('hero.subtitle')}</p>
      <p class="hero-statement">{t('hero.statement')}</p>

      <div class="hero-actions">
        <a href={projectsHref(lang)} class="btn btn-primary">{t('hero.cta.work')}</a>
        <a href={SITE.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          {t('hero.cta.github')}
        </a>
        <a href={localizedPath(lang, '/resume')} class="btn btn-outline">
          {t('hero.cta.resume')}
        </a>
      </div>
    </div>

    <div class="hero-art">
      <Artwork name="hero" label={ARTWORK_LABELS.hero[lang]} alt={ART_ALT.hero[lang]} />
    </div>
  </section>

  <!-- ────────────────────── 精选项目 / FEATURED PROJECTS ─────────────────
       Four rows, stacked, alternating sides (§10–§12). The heading is a plain
       one: no eyebrow, no hairline, no lead paragraph and no "view all" beside
       it. The work is the argument. -->
  <section class="shell section" id="work">
    <h2 class="work-title">{t('work.title')}</h2>

    <div class="work-list">
      {featured.map((project, i) => <ProjectFeatureRow project={project} lang={lang} index={i} />)}
    </div>

    <p class="work-more">
      <a href={projectsHref(lang)} class="link-arrow">
        {t('work.all')}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </section>

  <!-- ─────────────────────────── 联系 / CONTACT ──────────────────────────
       A name, one line and four links (§29). The /about route is in the header;
       repeating it here would make this band a second content block. -->
  <section class="shell section-tight" id="contact">
    <h2 class="contact-name">{SITE.nameZh}</h2>
    <p class="contact-line">{t('home.contact.line')}</p>
    <div class="contact-links">
      <ContactLinks lang={lang} variant="inline" />
    </div>
  </section>
</BaseLayout>

<style>
  /* The first screen is 76vh rather than a full one: the page should hand the
     eye on to the work instead of insisting on filling itself. */
  .hero {
    min-height: 76vh;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vh, 4.5rem);
  }

  @media (min-width: 900px) {
    .hero {
      /* §8: the copy takes roughly two fifths of the row and the artwork the
         rest — close to 39% / 56% of the shell once the column gap is taken
         out, which keeps the image in the 55–62% band without letting it crowd
         the words. Not an even split: an even split would make the artwork read
         as an illustration beside an article rather than as the page's face. */
      grid-template-columns: minmax(0, 0.76fr) minmax(0, 1.08fr);
      column-gap: clamp(2rem, 4vw, 3.5rem);
    }
  }

  .hero-copy {
    min-width: 0;
    max-width: 34rem;
  }

  .hero-name {
    margin: 0;
    font-size: clamp(2.75rem, 5.4vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.038em;
    font-weight: 500;
  }

  .hero-role {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.3vw, 0.9375rem);
    letter-spacing: 0.07em;
    color: var(--muted);
  }

  .hero-statement {
    margin: 1.75rem 0 0;
    font-size: clamp(1.25rem, 2.3vw, 1.6875rem);
    line-height: 1.42;
    letter-spacing: -0.022em;
    max-width: 22ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
  }

  .hero-art {
    min-width: 0;
  }

  /* ── the work ─────────────────────────────────────────────────────────── */

  .work-title {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.028em;
    font-weight: 500;
    margin: 0;
  }

  /* Whitespace, not hairlines: four rules across four rows is the "borders
     everywhere" problem §26 names. The gap is the separator. */
  .work-list {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6.5vw, 5.5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .work-more {
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
  }

  /* ── the close ────────────────────────────────────────────────────────── */

  .contact-name {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: -0.028em;
    font-weight: 500;
    margin: 0;
  }

  .contact-line {
    margin: 0.625rem 0 0;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    color: var(--muted);
  }

  .contact-links {
    margin-top: 1.25rem;
  }
</style>
