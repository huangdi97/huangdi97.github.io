---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectShowcase from '../../components/ProjectShowcase.astro';
import HeroSystem from '../../components/HeroSystem.astro';
import NowStrip from '../../components/NowStrip.astro';
import BackgroundTimeline from '../../components/BackgroundTimeline.astro';
import ProcessRail from '../../components/ProcessRail.astro';
import ResearchRow from '../../components/ResearchRow.astro';
import { SITE } from '../../config/site';
import { useT, localizedPath } from '../../i18n/ui';
import { getFeaturedProjects, projectsHref } from '../../lib/projects';
import { getResearch } from '../../data/research';
import { getBackground } from '../../data/background';
import { getHow } from '../../data/how';
import { OSS_CAPTURED_AT, OSS_HIGHLIGHTS } from '../../data/oss';
import { personSchema } from '../../data/profile';

const lang = 'zh' as const;
const t = useT(lang);

const featured = await getFeaturedProjects(lang, 5);
const research = getResearch(lang);
const how = getHow(lang);
const background = getBackground(lang);

/**
 * Research is split by tier, not by taste: a direction tied to inspectable code
 * is never rendered as the twin of a written concept.
 */
const activeResearch = research.filter((area) => area.tier === 'active');
const conceptResearch = research.filter((area) => area.tier === 'concept');

const path = '/zh/';
const enPath = '/';
const zhPath = '/zh/';

const personLd = personSchema(lang);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.nameEn} — Personal AI Lab`,
  url: SITE.url,
  inLanguage: 'zh-Hans',
  description: SITE.description.zh,
  author: { '@type': 'Person', name: SITE.nameEn },
};
---

<BaseLayout
  title={`${SITE.nameZh} — 个人 AI 实验室`}
  description={SITE.description.zh}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/home.png"
  type="profile"
  jsonLd={[personLd, websiteLd]}
>
  <section class="shell hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t('hero.eyebrow')}</p>
        <h1 class="display hero-title">{t('hero.title')}</h1>
        <p class="hero-sub">{t('hero.subtitle')}</p>
        <p class="hero-statement">{t('hero.statement')}</p>
        <p class="lead hero-support">{t('hero.support')}</p>

        <div class="hero-actions">
          <a href={projectsHref(lang)} class="btn btn-primary">{t('hero.cta.work')}</a>
          <a href={SITE.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
            {t('hero.cta.github')}
          </a>
          <a href={localizedPath(lang, '/resume')} class="btn btn-outline">
            {t('hero.cta.resume')}
          </a>
        </div>
      </div>

      <div class="hero-figure">
        <HeroSystem />
      </div>
    </div>

    <div class="hero-capabilities">
      <p class="mono">{t('hero.capabilities')}</p>
      <ul>
        {SITE.focusAreas.map((area) => <li>{area.zh}</li>)}
      </ul>
    </div>
  </section>

  <!-- ──────────────────── 当前关注 / NOW ──────────────────────── -->
  <NowStrip lang={lang} />

  <section class="shell section" id="work">
    <SectionHeading
      eyebrow={t('work.eyebrow')}
      title={t('work.title')}
      lead={t('work.lead')}
      href={projectsHref(lang)}
      linkLabel={t('work.all')}
    />

    <div class="showcase-list">
      {featured.map((project, i) => <ProjectShowcase project={project} lang={lang} index={i} />)}
    </div>
  </section>

  <!-- ───────────────────────── 背景 / BACKGROUND ──────────────── -->
  <section class="shell section">
    <SectionHeading
      eyebrow={t('background.eyebrow')}
      title={background.title}
      lead={t('background.intro')}
    />

    <div class="bg-copy">
      {background.paragraphs.map((paragraph) => <p class="body-muted">{paragraph}</p>)}
    </div>

    <BackgroundTimeline lang={lang} />
  </section>

  <!-- ─────────────────────── 研究方向 / RESEARCH ──────────────── -->
  <section class="shell section">
    <SectionHeading
      eyebrow={t('research.eyebrow')}
      title={t('research.title')}
      lead={t('research.lead')}
      href={localizedPath(lang, '/research')}
      linkLabel={t('research.all')}
    />

    <div class="research-tier">
      <p class="research-tier-label mono">{t('research.active')}</p>
      <ul class="research-list">
        {activeResearch.map((area) => <ResearchRow area={area} lang={lang} />)}
      </ul>
    </div>

    <div class="research-tier">
      <p class="research-tier-label mono">{t('research.concepts')}</p>
      <ul class="research-list">
        {conceptResearch.map((area) => <ResearchRow area={area} lang={lang} />)}
      </ul>
    </div>
  </section>

  <section class="shell section">
    <SectionHeading eyebrow={t('how.eyebrow')} title={t('how.title')} lead={t('how.lead')} />
    <ProcessRail steps={how} />
  </section>

  <section class="shell section">
    <SectionHeading
      eyebrow={t('oss.eyebrow')}
      title={t('oss.title')}
      lead={t('oss.lead')}
      href={SITE.github}
      linkLabel={t('oss.all')}
    />

    <ul class="oss-list">
      {
        OSS_HIGHLIGHTS.map((repo) => (
          <li>
            <a href={repo.url} class="oss-item" target="_blank" rel="noopener noreferrer">
              <span class="oss-name">{repo.name}</span>
              <span class="oss-desc">{repo.descriptionZh}</span>
              <span class="oss-facts">
                <span class="oss-fact">
                  <span class="oss-fact-k">{t('oss.role')}</span>
                  <span class="oss-fact-v" data-role={repo.role}>
                    {t(`oss.role.${repo.role}`)}
                  </span>
                </span>
                <span class="oss-fact">
                  <span class="oss-fact-k">{t('oss.language')}</span>
                  <span class="oss-fact-v">{repo.language ?? '—'}</span>
                </span>
                <span class="oss-fact">
                  <span class="oss-fact-k">{t('oss.license')}</span>
                  <span class="oss-fact-v" data-nolicense={repo.license === null}>
                    {repo.license ?? t('oss.nolicense')}
                  </span>
                </span>
                <span class="oss-fact">
                  <span class="oss-fact-k">{t('oss.updated')}</span>
                  <span class="oss-fact-v">{repo.updatedAt}</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="oss-snapshot mono">{t('oss.snapshot')} — {OSS_CAPTURED_AT}</p>
  </section>

  <section class="shell section-tight">
    <div class="cta">
      <div class="cta-copy">
        <p class="eyebrow cta-eyebrow">{t('about.context.eyebrow')}</p>
        <h2 class="h2 cta-name">{SITE.nameZh}</h2>
        <p class="lead cta-body">{t('about.context.line')}</p>

        <ul class="cta-links">
          {SITE.emails.map((email) => (
            <li>
              <a href={`mailto:${email.value}`} class="cta-link">
                <span class="cta-link-k">{email.label[lang]}</span>
                <span class="cta-link-v">{email.value}</span>
              </a>
            </li>
          ))}
          <li>
            <a href={SITE.github} class="cta-link" target="_blank" rel="noopener noreferrer">
              <span class="cta-link-k">GitHub</span>
              <span class="cta-link-v">{SITE.githubHandle}</span>
            </a>
          </li>
          <li>
            <a href={localizedPath(lang, '/resume')} class="cta-link">
              <span class="cta-link-k">{t('nav.resume')}</span>
              <span class="cta-link-v">PDF</span>
            </a>
          </li>
        </ul>
      </div>

      <a href={localizedPath(lang, '/about')} class="btn btn-primary cta-btn">
        {t('about.cta.link')}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }
  }

  .hero-title {
    margin-top: 1.25rem;
  }

  .hero-sub {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .hero-statement {
    margin-top: 1.75rem;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.38;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }

  .hero-support {
    margin-top: 1.25rem;
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-figure {
    display: none;
  }

  @media (min-width: 900px) {
    .hero-figure {
      display: block;
    }
  }

  .hero-capabilities {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero-capabilities ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .hero-capabilities li {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .showcase-list {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 6rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* 背景段落与时间线 */
  .bg-copy {
    display: grid;
    gap: 0.875rem;
    max-width: 68ch;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .bg-copy + :global(.bt) {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .research-tier + .research-tier {
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }

  .research-tier-label {
    font-size: 0.6875rem;
    color: var(--faint);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .research-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .oss-list {
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .oss-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .oss-item {
      grid-template-columns: 14rem minmax(0, 1fr) 15rem;
      gap: 2rem;
      align-items: baseline;
    }
  }

  .oss-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .oss-desc {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .oss-facts {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .oss-fact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .oss-fact-k {
    color: var(--faint);
  }

  .oss-fact-v {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  /* 缺失许可证是事实，就按事实呈现，而不是悄悄省略。 */
  .oss-fact-v[data-nolicense='true'] {
    color: var(--faint);
    border-bottom: 1px dotted var(--line-strong);
  }

  @media (min-width: 900px) {
    .oss-facts {
      text-align: right;
    }
  }

  .oss-snapshot {
    margin-top: 1.25rem;
  }

  /* 定位由人工标注；主项目与研究类会被优先读到。 */
  .oss-fact-v[data-role='flagship'] {
    color: var(--ink);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .cta-copy {
    min-width: 0;
  }

  /* 共享 eyebrow 带尾线；放在面板内部只是噪声。 */
  .cta-eyebrow::after {
    display: none;
  }

  .cta-name {
    margin-top: 0.5rem;
  }

  .cta-body {
    margin-top: 0.5rem;
    max-width: 52ch;
  }

  .cta-links {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
  }

  .cta-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
  }

  .cta-link-k {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cta-link-v {
    font-size: 0.875rem;
    color: var(--ink);
  }

  .cta-link:hover .cta-link-v {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .cta-btn {
    flex-shrink: 0;
  }
</style>
