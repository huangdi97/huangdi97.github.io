---
/**
 * Project page (Chinese) — v2.1, a public case study.
 *
 * What changed. The page used to be a build report: a breadcrumb, a category
 * eyebrow, the meta block, a conceptual figure, a sticky sidebar with a table of
 * contents, an architecture diagram and a tag list, the full Markdown body with
 * ten to thirteen sections, the implementation-status matrix, and a next-project
 * link. Every part was true; together they documented how the system is built
 * and where it is going, which is internal design rather than public surface.
 *
 * v2.1 (§15–§21) keeps six questions and stops:
 *
 *   What it is · Why it matters · Current public status ·
 *   What is publicly available · Notes
 *
 * — authored in the project's own Markdown, so the page cannot grow a section
 * nobody decided to publish. Around it the page keeps exactly three things:
 *
 *   · the meta block, which states year, status, role, stack and the two
 *     evidence facts (public code, reality) — §16.3;
 *   · the conceptual figure, which is this page type's one drawing and the only
 *     place a formula may be the subject;
 *   · the implementation-status matrix, which is the evidence layer rendered —
 *     §16.3 and §16.5, and the reason the page can claim what it claims.
 *
 * Removed: the table of contents, the architecture diagram, the tag list and the
 * links sidebar (its links are already the header actions). The page is now a
 * single column, because a case study is read in order.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectScientificVisual from '../../../components/ProjectScientificVisual.astro';
import ProjectMeta from '../../../components/ProjectMeta.astro';
import ProjectReality from '../../../components/ProjectReality.astro';
import { SITE } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { projectsHref, projectHref, nextProject, getProjects } from '../../../lib/projects';
import { getProjectEvidence } from '../../../data/evidence';

export async function getStaticPaths() {
  const entries = await getCollection('projectsZh');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { slug: entry.data.slug },
  }));
}

const { slug } = Astro.props;

const lang = 'zh' as const;
const t = useT(lang);

const all = await getProjects(lang);
const entry = all.find((e) => e.data.slug === slug);
if (!entry) throw new Error(`Unknown project: ${slug}`);

const { Content } = await render(entry);
const d = entry.data;
const upNext = nextProject(all, d.slug);

const path = `/zh/projects/${d.slug}/`;
const enPath = `/projects/${d.slug}/`;
const zhPath = path;

const evidence = getProjectEvidence(d.slug);

const ld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': d.repo ? 'SoftwareSourceCode' : 'CreativeWork',
    name: d.title,
    headline: d.summary,
    description: d.description,
    url: new URL(path, SITE.url).href,
    inLanguage: 'zh-Hans',
    datePublished: String(d.year),
    keywords: d.tags.join(', '),
    author: { '@type': 'Person', name: SITE.nameEn, url: SITE.url },
    ...(d.repo ? { codeRepository: d.repo, programmingLanguage: d.stack } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: '项目',
        item: new URL('/zh/projects/', SITE.url).href,
      },
      { '@type': 'ListItem', position: 3, name: d.title, item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout
  title={d.title}
  seoTitle={d.seoTitle}
  description={d.description}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage={`/og/${d.slug}.png`}
  type="article"
  jsonLd={ld}
>
  <article class="shell case">
    <nav class="case-back" aria-label="面包屑">
      <a href={projectsHref(lang)} class="link-arrow">
        <span class="arrow" aria-hidden="true">←</span>
        {t('project.back')}
      </a>
    </nav>

    <header class="case-head">
      <p class="eyebrow">{t('case.eyebrow')}</p>
      <h1 class="h1 case-title">{d.title}</h1>
      {d.subtitle && <p class="case-subtitle">{d.subtitle}</p>}
      <p class="case-thesis">{d.summary}</p>

      <div class="case-meta">
        <ProjectMeta
          lang={lang}
          year={d.year}
          status={d.status}
          role={d.role}
          category={d.category}
          stack={d.stack}
          publicCode={evidence?.publicCode}
          reality={evidence ? evidence.reality[lang] : undefined}
          headline={evidence ? evidence.headline[lang] : undefined}
        />
      </div>

      {
        d.statusNote && (
          <p class="case-note">
            <span class="mono">{t('meta.status')}</span>
            {d.statusNote}
          </p>
        )
      }

      <div class="case-actions">
        {
          d.repo && (
            <a href={d.repo} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              {t('work.repo')}
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          !d.repo && (
            <span class="case-no-repo">
              {t('work.repo')} — {t('project.noRepo')}
            </span>
          )
        }
        {
          d.demo && (
            <a href={d.demo} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              Demo
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          evidence && (
            <a href="#reality" class="btn btn-outline">
              {t('evidence.title')}
              <span aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
    </header>

    <div class="case-visual">
      <ProjectScientificVisual variant={d.visual} label={`${d.title} — ${d.category}`} />
    </div>

    <div class="prose-editorial case-prose">
      <Content />
    </div>

    {evidence && <ProjectReality evidence={evidence} lang={lang} idPrefix={d.slug} />}

    {
      upNext && (
        <nav class="case-next" aria-label={t('project.next')}>
          <hr class="rule" />
          <a href={projectHref(lang, upNext.data.slug)} class="next-link">
            <span class="mono">{t('project.next')}</span>
            <span class="next-title">{upNext.data.title}</span>
            <span class="next-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .case {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .case-back {
    padding-block: 1rem 2rem;
  }

  .case-head {
    max-width: 60ch;
  }

  .case-title {
    margin-top: 1rem;
  }

  .case-subtitle {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .case-thesis {
    margin-top: 1.25rem;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.5;
    letter-spacing: -0.018em;
    color: var(--ink);
  }

  .case-meta {
    margin-top: 2.5rem;
  }

  .case-note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 2rem;
  }

  /* §16.4: a project with no repository says so in the same place a project with
     one shows its link, rather than quietly omitting the row. */
  .case-no-repo {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }

  .case-visual {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  /* A case study is read in order, so the body is one column. 68ch is the
     measure the rest of the site's prose uses. */
  .case-prose {
    max-width: 68ch;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .case-next {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .next-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding-top: 1.5rem;
    align-items: baseline;
  }

  .next-title {
    grid-column: 1;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    letter-spacing: -0.024em;
  }

  .next-arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: 1.25rem;
    color: var(--faint);
    transition: transform var(--dur-base) var(--ease);
  }

  .next-link:hover .next-arrow {
    transform: translateX(5px);
    color: var(--ink);
  }

  .case-prose :global(h2) {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.018em;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink);
  }

  .case-prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .case-prose :global(h3) {
    font-size: 1.0625rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
    color: var(--ink);
  }

  .case-prose :global(pre) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    margin-block: 1.5rem;
  }

  .case-prose :global(p code),
  .case-prose :global(li code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: rgba(0, 0, 0, 0.045);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  .case-prose :global(ul) {
    margin-block: 1rem;
    padding-left: 1.25rem;
    list-style: none;
  }

  .case-prose :global(ul li) {
    position: relative;
    margin-bottom: 0.6rem;
    color: var(--muted);
    line-height: 1.72;
  }

  .case-prose :global(ul li)::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 0.78em;
    width: 10px;
    height: 1px;
    background: var(--ink);
  }

  .case-prose :global(ol) {
    margin-block: 1rem;
    padding-left: 1.35rem;
  }

  .case-prose :global(ol li) {
    margin-bottom: 0.5rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .case-prose :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }

  .case-prose :global(p) {
    margin-block: 1rem;
    color: var(--muted);
    line-height: 1.78;
  }
</style>
