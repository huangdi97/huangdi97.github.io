---
/**
 * Projects index (Chinese) — v2.2.1.
 *
 * 本轮改了什么，为什么。v2.2 的 /projects 又长回了 Owner 明确要求去掉的两样东西：
 *
 *   1. **「其他工作」索引。** 它把三个尚未完成的项目（Pet AI Health、PDIG、
 *      太一·灵境）摊在公开目录页上。Owner 的原话是「很多项目还没做完，不想全部
 *      表露」。§39–§41 的处理方式是**只从公开渲染里隐藏，不删数据**：三个项目的
 *      frontmatter、案例页、证据层全部原样保留，只是首页与 /projects 不再列出它们。
 *   2. **黑色「公开成果精选」区块。** 它原本是本站唯一的反色面，而反色面在纸面
 *      editorial 版式里读起来像「另一个网站被贴了上来」，同时把工程细节重新放大。
 *      §42 要求整块从 /projects 移除；§43 明确数据不删——`src/data/artifacts.ts`
 *      一字未动，`SelectedArtifacts.astro` 也仍在仓库里，只是**当前没有任何页面
 *      mount 它**（这一点由 artifacts 门禁断言，而不是靠推断）。§44 只允许保留
 *      **一行文字链接**作为出口，所以底部现在就是一行。
 *
 * 项目条目本身再收一次（§34–§35）：每个项目最多五个字段——名称、一行定位、状态、
 * 「查看项目 →」、（可选）GitHub ↗。v2.1 留下的两三段介绍移出目录页；frontmatter 的
 * `description` 一字未动，仍是案例页的 meta / OG 描述，而案例页正文本来就是更完整的
 * 那一份——这正是 §35 说的「移到 case page」。
 *
 * 开源列表同样减重（§45–§48）：只留仓库名、一行描述、语言和 GitHub 入口；许可证、
 * 更新日期、元数据快照日期与「定位」列全部去掉——GitHub 自己会显示这些。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ProjectEntry from '../../../components/ProjectEntry.astro';
import OpenSourceList from '../../../components/OpenSourceList.astro';
import { SITE } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { getProjects } from '../../../lib/projects';

const lang = 'zh' as const;
const t = useT(lang);

const all = await getProjects(lang);
const featured = all.filter((project) => project.data.featured);

const path = '/zh/projects/';
const enPath = '/projects/';
const zhPath = '/zh/projects/';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `项目 — ${SITE.nameZh}`,
  url: new URL(path, SITE.url).href,
  inLanguage: 'zh-Hans',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: featured.length,
    itemListElement: featured.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.data.title,
      url: new URL(`/zh/projects/${p.data.slug}/`, SITE.url).href,
    })),
  },
};
---

<BaseLayout
  title="项目"
  description="AI 健康、计算生物学、智能体与本地优先基础设施方向的精选项目。每条只说明它是什么，以及当前公开到什么程度。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/projects.png"
  backgroundMode="projects"
  jsonLd={collectionLd}
>
  <section class="shell section">
    <SectionHeading as="h1" eyebrow={t('work.eyebrow')} title="项目" lead={t('work.public.lead')} />

    <div class="entry-grid">
      {featured.map((project) => <ProjectEntry project={project} lang={lang} />)}
    </div>
  </section>

  <section class="shell section">
    <SectionHeading
      eyebrow={t('oss.eyebrow')}
      title={t('oss.title')}
      lead={t('oss.lead')}
      href={SITE.github}
      linkLabel={t('oss.all')}
    />

    <OpenSourceList lang={lang} />
  </section>

  <!-- §44：页面唯一的出口，而且是一行，不是一块。证据本身仍在
       `src/data/artifacts.ts`，仍在各项目自己的案例页上渲染。 -->
  <p class="shell work-exit">
    <a class="link-arrow" href={SITE.github} target="_blank" rel="noopener noreferrer">
      {t('artifacts.title')}
      <span class="arrow" aria-hidden="true">→</span>
      <span class="sr-only"> ({t('a11y.external')})</span>
    </a>
  </p>
</BaseLayout>

<style>
  .entry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 760px) {
    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2.5rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem);
    }
  }

  .work-exit {
    margin: 0 auto clamp(3rem, 6vw, 5rem);
  }
</style>
