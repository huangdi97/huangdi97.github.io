---
/**
 * Projects index (Chinese) — v1.6.
 *
 * This page took on the evidence half of the homepage in v1.6. The rule the
 * owner set is: the homepage answers "what have you built?", and this page
 * answers "show me the evidence". So three blocks moved here from /:
 *
 *   NowStrip          current project status, in one rail
 *   SelectedArtifacts the inverted evidence room — it keeps its dark surface,
 *                     because here the inversion is semantic (an evidence
 *                     room), not a decorative footer accident
 *   Open Source       the full repository table with role, license and dates
 *
 * The grid itself is unchanged: all seven projects, filterable.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import NowStrip from '../../../components/NowStrip.astro';
import SelectedArtifacts from '../../../components/SelectedArtifacts.astro';
import OpenSourceList from '../../../components/OpenSourceList.astro';
import { SITE } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { getProjects, FILTER_LABELS, PROJECT_FILTERS } from '../../../lib/projects';

const lang = 'zh' as const;
const t = useT(lang);

const projects = await getProjects(lang);

const path = '/zh/projects/';
const enPath = '/projects/';
const zhPath = '/zh/projects/';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `项目 — ${SITE.nameZh}`,
  url: new URL(path, SITE.url).href,
  inLanguage: 'zh-Hans',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: projects.length,
    itemListElement: projects.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.data.title,
      url: new URL(`/zh/projects/${p.data.slug}/`, SITE.url).href,
    })),
  },
};
---

<BaseLayout
  title="项目"
  description="AI 健康、计算生物学、仿真与本地优先基础设施方向的精选系统，均附完整案例研究。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/projects.png"
  jsonLd={collectionLd}
>
  <!-- 当前关注：项目页是它唯一合适的家。首页已不再展示。 -->
  <NowStrip lang={lang} />

  <section class="shell section">
    <SectionHeading
      as="h1"
      eyebrow={t('work.eyebrow')}
      title="项目"
      lead="以下每个项目都配有完整案例：问题定义、架构设计、技术决策，以及真正完成了什么。"
    />

    <div class="filter-bar" role="group" aria-label={t('filter.label')}>
      <button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">
        {t('filter.all')}
      </button>
      {
        PROJECT_FILTERS.map((key) => (
          <button type="button" class="filter-btn" data-filter={key} aria-pressed="false">
            {FILTER_LABELS[key].zh}
          </button>
        ))
      }
      <p class="filter-count" aria-live="polite" data-filter-count data-unit={t('filter.count')}>
        {projects.length} {t('filter.count')}
      </p>
    </div>

    <div class="project-grid" data-project-grid>
      {projects.map((project, i) => <ProjectCard project={project} lang={lang} index={i} />)}
    </div>

    <p class="filter-empty" data-filter-empty hidden>{t('filter.empty')}</p>
  </section>

  <!-- 证据室：从首页迁来。深色区块在这里是有语义的。 -->
  <SelectedArtifacts lang={lang} />

  <section class="shell section">
    <SectionHeading
      eyebrow={t('oss.eyebrow')}
      title={t('oss.title')}
      lead={t('oss.lead')}
      href={SITE.github}
      linkLabel={t('oss.all')}
    />

    <OpenSourceList lang={lang} />
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-groups]');
  const count = document.querySelector<HTMLElement>('[data-filter-count]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  function apply(filter: string) {
    let visible = 0;

    cards.forEach((card) => {
      const groups = (card.dataset.groups ?? '').split(' ').filter(Boolean);
      const show = filter === 'all' || groups.includes(filter);
      card.hidden = !show;
      if (show) visible += 1;
    });

    buttons.forEach((btn) => {
      const active = btn.dataset.filter === filter;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    if (count) count.textContent = `${visible} ${count.dataset.unit ?? ''}`.trim();
    if (empty) empty.hidden = visible !== 0;
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => apply(btn.dataset.filter ?? 'all'));
  });
</script>

<style>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .filter-btn {
    min-height: 44px;
    padding: 0 0.875rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: transparent;
    font-size: 0.875rem;
    color: var(--muted);
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .filter-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .filter-btn.is-active {
    color: var(--canvas);
    background: var(--ink);
    border-color: var(--ink);
  }

  .filter-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  @media (min-width: 700px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .filter-empty {
    margin-top: 2.5rem;
    color: var(--muted);
  }
</style>
