---
/**
 * Projects index (Chinese) — v2.1.
 *
 * What changed and why. v1.6 moved the evidence half of the homepage here and
 * the page then grew into a project manual: a NOW strip, a five-way filter bar,
 * seven bordered cards with capability lists and keyword pills, a dark artifact
 * room, and the full open-source metadata table. Every individual piece was
 * defensible; together they answered "how much is there?" instead of "what is
 * worth looking at?".
 *
 * v2.1 (§10–§14) makes it a curated directory of public entries:
 *
 *   1. a short lead that says how to read the list;
 *   2. four entries, each with the project's own artwork — the same file the
 *      homepage shows, not a second design (§11, §43) — its name, one line of
 *      positioning, two or three lines of public intro, one status and two
 *      links;
 *   3. a light "other work" index for the three projects that have no public
 *      repository and therefore no artwork: a name, a line and a status. No
 *      drawing is invented for them (§36, §51);
 *   4. the evidence stays, because everything in it is real and externally
 *      checkable — but as a footnote, not a chapter. v2.1's final closure cut
 *      the artifact room from a five-tile mosaic of repository trees, terminal
 *      transcripts and metric dumps to a three-row "Selected Public Work" list.
 *      The room had reached 2,875px, 44% of the page, so a visitor asking "what
 *      have you built" met a directory listing before they met the four
 *      projects. It is now 751px, 17%. The table in `src/data/artifacts.ts` is
 *      untouched; only the amount of it the page prints changed. The
 *      open-source table below it is checked-in GitHub metadata and stays.
 *
 * Removed: the NOW strip (its information is each entry's status line, and a
 * "what I am working on" rail is roadmap-adjacent), the filter bar and the
 * `groups` frontmatter it read, the card grid, and the ProjectCover component
 * with its six `cover*` fields.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeading from '../../../components/SectionHeading.astro';
import ProjectEntry from '../../../components/ProjectEntry.astro';
import SelectedArtifacts from '../../../components/SelectedArtifacts.astro';
import OpenSourceList from '../../../components/OpenSourceList.astro';
import { SITE } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { getProjects, projectHref } from '../../../lib/projects';
import { projectStatus } from '../../../lib/projectStatus';

const lang = 'zh' as const;
const t = useT(lang);

const all = await getProjects(lang);
const featured = all.filter((project) => project.data.featured);
const others = all.filter((project) => !project.data.featured);

const path = '/zh/projects/';
const enPath = '/projects/';
const zhPath = '/zh/projects/';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `项目 — ${SITE.nameZh}`,
  url: new URL(path, SITE.url).href,
  inLanguage: 'zh-Hans',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: all.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.data.title,
      url: new URL(`/zh/projects/${p.data.slug}/`, SITE.url).href,
    })),
  },
};
---

<BaseLayout
  title="项目"
  description="AI 健康、计算生物学、智能体与本地优先基础设施方向的精选项目。每条只说明它是什么、用来做什么，以及当前公开到什么程度。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/projects.png"
  jsonLd={collectionLd}
>
  <section class="shell section">
    <SectionHeading as="h1" eyebrow={t('work.eyebrow')} title="项目" lead={t('work.public.lead')} />

    <div class="entry-grid">
      {featured.map((project) => <ProjectEntry project={project} lang={lang} />)}
    </div>
  </section>

  <!-- 其他工作：没有公开仓库、也没有正式主视觉的项目，只做一份很轻的索引。 -->
  <section class="shell section-tight">
    <h2 class="other-title">{t('work.other')}</h2>
    <p class="other-lead">{t('work.other.lead')}</p>

    <ul class="other-list">
      {
        others.map((project) => {
          const status = projectStatus(project.data.slug, lang, t);
          return (
            <li class="other-item">
              <a class="other-name" href={projectHref(lang, project.data.slug)}>
                {project.data.title}
              </a>
              <span class="other-line">{project.data.publicLine}</span>
              {status && <span class="other-status">{status}</span>}
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- 已公开内容：每件实物都引用自公开仓库。 -->
  <SelectedArtifacts lang={lang} />

  <section class="shell section">
    <SectionHeading
      eyebrow={t('oss.eyebrow')}
      title={t('oss.title')}
      lead={t('oss.lead')}
      href={SITE.github}
      linkLabel={t('oss.all')}
    />

    <OpenSourceList lang={lang} />
  </section>
</BaseLayout>

<style>
  .entry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 760px) {
    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2.5rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem);
    }
  }

  .other-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.022em;
    font-weight: 500;
    margin: 0;
  }

  .other-lead {
    margin: 0.625rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 62ch;
  }

  .other-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* A light index, not a second grid of cards: one hairline per row, the name
     in ink, the line muted, the status quiet in the mono face. */
  .other-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .other-item {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto;
      gap: 0.25rem 1.5rem;
      align-items: baseline;
    }
  }

  .other-name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
  }

  .other-name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .other-line {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .other-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    white-space: nowrap;
  }
</style>
