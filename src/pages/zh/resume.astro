---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResumeDocument from '../../components/ResumeDocument.astro';
import { SITE } from '../../config/site';
import { profilePageJsonLd } from '../../data/profile';

const lang = 'zh' as const;

const path = '/zh/resume/';
const enPath = '/resume/';
const zhPath = '/zh/resume/';

const profileLd = profilePageJsonLd(lang, path, `${SITE.nameZh} — 简历`);
---

<BaseLayout
  title="简历"
  seoTitle="郝磊 — 简历 | AI 系统、智能体与生命科学"
  description="郝磊的简历 — AI 系统、智能体系统、计算生物学、数字健康与仿真；起点为生命科学实验研究，并有 IVD 与疫苗产业经历。可通过浏览器直接打印为 PDF。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/resume.png"
  type="profile"
  jsonLd={profileLd}
  minimalFooter={true}
  backgroundMode="resume"
>
  <ResumeDocument lang={lang} />
</BaseLayout>
