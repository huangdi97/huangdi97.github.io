---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getResume } from '../../data/resume';

const lang = 'zh' as const;
const t = useT(lang);
const resume = getResume(lang);

const path = '/zh/resume/';
const enPath = '/resume/';
const zhPath = '/zh/resume/';

const profileLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: `${SITE.nameZh} — 简历`,
  url: new URL(path, SITE.url).href,
  inLanguage: 'zh-Hans',
  mainEntity: {
    '@type': 'Person',
    name: SITE.nameEn,
    alternateName: SITE.nameZh,
    url: SITE.url,
    sameAs: [SITE.github],
    knowsAbout: SITE.focusAreas.map((a) => a.zh),
  },
};
---

<BaseLayout
  title="简历"
  description="简历 — AI 系统、智能体系统、计算生物学、数字健康与仿真。可通过浏览器直接打印为 PDF。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/resume.png"
  type="profile"
  jsonLd={profileLd}
>
  <article class="shell resume">
    <div class="resume-bar no-print">
      <p class="mono">{t('resume.note')}</p>
      <div class="resume-bar-actions">
        {
          /* A download button appears only once a real PDF exists. */
          SITE.resumePdf && (
            <a href={SITE.resumePdf} class="btn btn-outline" download>
              {t('resume.download')}
              <span aria-hidden="true">&darr;</span>
            </a>
          )
        }
        <button type="button" class="btn btn-primary" data-print>{t('resume.print')}</button>
      </div>
    </div>

    <header class="resume-head">
      <p class="eyebrow">简历</p>
      <h1 class="h1 resume-name">{resume.name}</h1>
      <p class="resume-headline">{resume.headline}</p>
      <ul class="resume-contact">
        <li>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">
            {SITE.github.replace('https://', '')}
          </a>
        </li>
        {SITE.email && <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>}
      </ul>
    </header>

    {
      resume.blocks.map((block) => (
        <section class="resume-block">
          <h2 class="resume-block-title">{block.title}</h2>

          {block.kind === 'text' &&
            block.paragraphs?.map((p) => <p class="resume-text">{p}</p>)}

          {block.kind === 'list' && block.items && (
            <ul class="resume-list">
              {block.items.map((item) => (
                <li>
                  {item.href ? (
                    <a href={item.href} target="_blank" rel="noopener noreferrer">
                      <span class="resume-label">{item.label}</span>
                      {item.value && <span class="resume-value">{item.value}</span>}
                    </a>
                  ) : (
                    <>
                      <span class="resume-label">{item.label}</span>
                      {item.value && <span class="resume-value">{item.value}</span>}
                    </>
                  )}
                </li>
              ))}
            </ul>
          )}

          {block.kind === 'projects' && block.items && (
            <ul class="resume-projects">
              {block.items.map((item) => (
                <li>
                  <a href={item.href}>
                    <span class="resume-label">{item.label}</span>
                  </a>
                  {item.value && <p class="resume-value">{item.value}</p>}
                </li>
              ))}
            </ul>
          )}

          {block.kind === 'contact' && block.items && (
            <ul class="resume-list">
              {block.items.map((item) => (
                <li>
                  <span class="resume-label">{item.label}</span>
                  {item.href && (
                    <a class="resume-value" href={item.href}>
                      {item.value}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          )}

        </section>
      ))
    }
  </article>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .resume {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    max-width: 60rem;
  }

  .resume-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .resume-bar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .resume-head {
    padding-top: clamp(2rem, 4vw, 3rem);
    max-width: 52ch;
  }

  .resume-name {
    margin-top: 1rem;
  }

  .resume-headline {
    margin-top: 1rem;
    font-size: clamp(1.0625rem, 1.8vw, 1.25rem);
    line-height: 1.6;
    color: var(--muted);
  }

  .resume-contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .resume-contact a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .resume-block {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    break-inside: avoid;
  }

  .resume-block-title {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--faint);
    margin-bottom: 1.25rem;
  }

  .resume-text {
    font-size: 0.9375rem;
    line-height: 1.78;
    color: var(--muted);
    max-width: 66ch;
    margin-bottom: 0.875rem;
  }


  .resume-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .resume-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  .resume-label {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .resume-list a:hover .resume-label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .resume-value {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .resume-projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .resume-projects a:hover .resume-label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .resume-projects .resume-value {
    margin-top: 0.25rem;
    max-width: 62ch;
    line-height: 1.7;
  }
</style>
