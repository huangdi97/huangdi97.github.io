---
/**
 * About (Chinese) — v2.1, an introduction rather than a method statement.
 *
 * What changed. v1.6 ran this page as a statement of working method: after the
 * introduction it printed a six-card "我在做什么" grid in which each card named a
 * technique family and described how it is applied, then a "我如何工作" section
 * rendering the six-stage process rail, then an expanded background chain, then
 * scope and contact (§29–§33).
 *
 * v2.1 keeps the page a person page:
 *
 *   · 你是谁 — the name and one headline sentence;
 *   · a page artwork band — the same paper and ink as the homepage, without the
 *     hero's profile and without a product screen (§30);
 *   · 当前关注方向 — five directions, one line each, stated as areas rather than
 *     as methods;
 *   · 来路 — one lead sentence and the five-node path rail, whose nodes map
 *     one-to-one onto owner-confirmed résumé fact (`data/background.ts`);
 *   · 边界 and 联系.
 *
 * Removed: the six-card method grid, the "我如何工作" stages and their process
 * rail, the design-philosophy paragraph, and the portrait branch — `SITE.portrait`
 * is still null, so the branch rendered nothing, and the page now has a visual of
 * its own.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackgroundTimeline from '../../components/BackgroundTimeline.astro';
import ContactLinks from '../../components/ContactLinks.astro';
import Artwork from '../../components/Artwork.astro';
import { ARTWORK_LABELS, ART_ALT } from '../../data/artwork';
import { SITE } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getAbout } from '../../data/about';
import { profilePageJsonLd } from '../../data/profile';

const lang = 'zh' as const;
const t = useT(lang);
const about = getAbout(lang);

const path = '/zh/about/';
const enPath = '/about/';
const zhPath = '/zh/about/';

const profileLd = profilePageJsonLd(lang, path, `${SITE.nameZh} — 关于`);
---

<BaseLayout
  title="关于"
  seoTitle="郝磊 — 关于 | AI 系统、智能体与生命科学"
  description="郝磊 —— 以生命科学实验研究、计算生物学与 IVD / 疫苗产业经历为底的 AI 系统工程。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/about.png"
  type="profile"
  jsonLd={profileLd}
  minimalFooter={true}
  backgroundMode="about"
  preloadArtwork="about"
>
  <article class="shell section">
    <header class="about-head">
      <p class="eyebrow">关于</p>
      <h1 class="display about-name">{t('hero.title')}</h1>
      <p class="about-headline">{about.headline}</p>
    </header>

    <!-- §26：书桌是「环境」，不是「一块板」。位置沿用 v2.1——右对齐放在标题
         之下——但不再是矩形：`art--accent` 把左缘溶进纸面并降到 0.18，
         读起来是「页面所处的房间」，而不是「页面上贴的一张图」。 -->
    <div class="about-band">
      <Artwork name="about" label={ARTWORK_LABELS.about[lang]} alt={ART_ALT.about[lang]} />
    </div>

    <div class="about-intro">
      {about.intro.map((p) => <p>{p}</p>)}
    </div>

    <section class="about-section">
      <h2 class="h2">{about.focusTitle}</h2>
      <ul class="focus-list">
        {about.focus.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.backgroundTitle}</h2>
      <p class="lead about-section-lead">{about.backgroundIntro}</p>

      <div class="about-path">
        <BackgroundTimeline lang={lang} />
      </div>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.scopeTitle}</h2>
      <ul class="scope-list">
        {about.scope.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.contactTitle}</h2>
      <p class="lead about-section-lead">{about.contactIntro}</p>
      <div class="about-actions">
        <ContactLinks lang={lang} variant="buttons" />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-head {
    max-width: 44ch;
  }

  .about-name {
    margin-top: 1.25rem;
  }

  .about-headline {
    margin-top: 1.75rem;
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    line-height: 1.4;
    letter-spacing: -0.02em;
    max-width: 28ch;
  }

  /* §26：右侧环境，而不是居中的矩形。v2.1 把它限制在 56rem 并右对齐；本轮
     放宽一点并向页面右缘外溢，溶接与 0.18 的权重由 `art--accent` 提供。
     画框比例与 object-position 未动，裁切窗口仍是源图 25%–100%，
     变的只是「有多少被着墨」。 */
  .about-band {
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
    max-width: 62rem;
    margin-left: auto;
  }

  @media (min-width: 1024px) {
    .about-band {
      margin-right: calc(-1 * clamp(1rem, 3vw, 3.5rem));
    }
  }

  .about-intro {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-intro p {
    font-size: 1.0625rem;
    line-height: 1.78;
    color: var(--muted);
  }

  .about-section {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .about-section-lead {
    margin-top: 1rem;
  }

  /* 当前关注方向：五行短句，不是六张方法卡片。 */
  .focus-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 68ch;
  }

  .focus-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .focus-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--ink);
  }

  /* The five-node path rail. */
  .about-path {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .scope-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 68ch;
  }

  .scope-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  .scope-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--ink);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
