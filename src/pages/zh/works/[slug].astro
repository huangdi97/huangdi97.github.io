---
/**
 * 作品详情页（中文）— v2.3。
 *
 * 结构与 `/works/[slug]` 完全一致，只替换语言与文案。§43 是塑造这个页面的约束：
 * 作品**不是**项目案例。这里没有「它是什么 / 为什么重要 / 当前公开状态」那套骨架，
 * 没有证据矩阵，也没有实现状态词汇——那些属于系统线，套到这里会把一件作品变成
 * 一份构建报告。
 *
 * §44 的结构与顺序：
 *
 *   标题 · 类型 · 年份 · 时长      识别信息
 *   海报                          作品本身，给到最大
 *   一句描述                      它是什么
 *   角色 / 工具                   可选，且只在真实存在时显示（§45–§46）
 *   观看作品 ↗                    §26 —— 是一个链接，不是挂载的播放器
 *
 * §24–§26：本页不加载任何视频。schema 里预留了 `videoProvider: 'self-hosted'`
 * （§27），但今天没有任何页面据它渲染 `<video>`。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkPoster from '../../../components/WorkPoster.astro';
import WorkMeta from '../../../components/WorkMeta.astro';
import { SITE } from '../../../config/site';
import { useT } from '../../../i18n/ui';
import { getWorks, watchUrl, workMetaLine, WORK_TYPE_LABELS } from '../../../lib/works';
import { DETAIL_LANDSCAPE_SIZES, DETAIL_PORTRAIT_SIZES } from '../../../data/worksLayout';

export async function getStaticPaths() {
  /* `getWorks` 是 draft 规则的唯一实现处（§69），因此草稿不可能获得路由——
     这里没有第二个可能被遗忘的过滤器。 */
  const entries = await getWorks('zh');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { slug: entry.data.slug },
  }));
}

const { slug } = Astro.props;

const lang = 'zh' as const;
const t = useT(lang);

const all = await getWorks(lang);
const entry = all.find((e) => e.data.slug === slug);
if (!entry) throw new Error(`Unknown work: ${slug}`);

const d = entry.data;

const path = `/zh/works/${d.slug}/`;
const enPath = `/works/${d.slug}/`;
const zhPath = `/zh/works/${d.slug}/`;

const watch = watchUrl(d);

/* §60–§63：详情页的画框同样跟随作品本身。横屏作品可以占满整栏（§65）；竖屏作品
   由宽度封顶，因此不会变成三屏高的图片柱（§63–§64）。 */
const [ratioW, ratioH] = d.aspectRatio.split('/').map(Number);
const portrait = ratioH > ratioW;
const sizes = portrait ? DETAIL_PORTRAIT_SIZES : DETAIL_LANDSCAPE_SIZES;

/* §49：海报即 Open Graph 图，且声明的是作品自己的尺寸，而不是站点的 1200×630
   ——把一张竖版海报声明成 1200×630 是在向爬虫说假话。 */
const ogWidth = 1440;
const ogHeight = Math.round((ogWidth * ratioH) / ratioW);

const alt = d.posterAlt ?? `${d.title} — ${WORK_TYPE_LABELS[d.type][lang]}`;

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    description: d.description,
    url: new URL(path, SITE.url).href,
    inLanguage: 'zh-Hans',
    datePublished: String(d.year),
    creator: { '@type': 'Person', name: SITE.nameZh, url: SITE.url },
    ...(d.tools.length ? { keywords: d.tools.join(', ') } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '作品', item: new URL('/zh/works/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout
  title={d.title}
  description={d.description}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage={`${d.poster}-1440.webp`}
  ogImageWidth={ogWidth}
  ogImageHeight={ogHeight}
  backgroundMode="works"
  jsonLd={ld}
>
  <article class="shell work-detail">
    <nav class="work-detail-back" aria-label="面包屑">
      <a href="/zh/works/" class="link-arrow">
        <span class="arrow" aria-hidden="true">←</span>
        {t('works.back')}
      </a>
    </nav>

    <header class="work-detail-head">
      <h1 class="h1 work-detail-title">{d.title}</h1>
      <WorkMeta line={workMetaLine(d, lang)} status={d.status} lang={lang} size="md" />
    </header>

    <div class:list={['work-detail-poster', portrait && 'work-detail-poster--portrait']}>
      <WorkPoster
        poster={d.poster}
        aspectRatio={d.aspectRatio}
        alt={alt}
        sizes={sizes}
        loading="eager"
        priority
      />
    </div>

    <p class="work-detail-desc">{d.description}</p>

    {
      (d.role || d.tools.length > 0 || d.credits.length > 0) && (
        <dl class="work-facts">
          {d.role && (
            <div class="work-fact">
              <dt>{t('works.role')}</dt>
              <dd>{d.role}</dd>
            </div>
          )}
          {d.tools.length > 0 && (
            <div class="work-fact">
              <dt>{t('works.tools')}</dt>
              <dd>{d.tools.join(' · ')}</dd>
            </div>
          )}
          {/* §44：只有作品确实有合作者时才渲染。 */}
          {d.credits.length > 0 && (
            <div class="work-fact">
              <dt>{t('works.credits')}</dt>
              <dd>{d.credits.join(' · ')}</dd>
            </div>
          )}
        </dl>
      )
    }

    {
      watch && (
        <p class="work-watch">
          {/* §84：只允许 https，且每个外链都带 noopener noreferrer。
              §52：链接就是链接——键盘可达，并说明会离开本站。
              §26：此处不挂载 iframe，点击后也不挂载。 */}
          <a class="btn btn-outline" href={watch} target="_blank" rel="noopener noreferrer">
            {t('works.watch')}
            <span aria-hidden="true">↗</span>
            <span class="sr-only"> ({t('a11y.external')})</span>
          </a>
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .work-detail {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .work-detail-back {
    padding-block: 1rem 2rem;
  }

  .work-detail-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 60ch;
  }

  .work-detail-title {
    margin: 0;
  }

  /* §65：全站最宽的视觉，也是唯一一处「宽幅就是重点」的地方。 */
  .work-detail-poster {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* §63–§64：竖屏作品按**宽度**封顶，把余下的宽度留白，而不是让一幅 9:16
     变成三屏高的图。没有这条规则时，1440 下的竖屏海报宽 1088、高 1934。
     `sizes` 做不到这件事 —— 它只决定浏览器取哪一档文件，不影响布局 ——
     所以这里的上限与 `worksLayout.ts` 里的 `DETAIL_PORTRAIT_SIZES` 取同一组数字。

     注意：这个文件与 `/works/[slug]` 是两份独立源码。本轮的竖屏封顶最初只落在
     英文页上，中文页漏了，而按路径推断语言的测试恰好只测到英文页 ——
     是 QA 采集（固定中文）把两边的差异暴露出来的。改版式时两个文件都要改。 */
  .work-detail-poster--portrait {
    max-width: 520px;
  }

  @media (max-width: 1279px) {
    .work-detail-poster--portrait {
      max-width: 72%;
    }
  }

  .work-detail-desc {
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    letter-spacing: -0.014em;
    max-width: 46ch;
  }

  .work-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .work-fact {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
  }

  .work-fact dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .work-fact dd {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .work-watch {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
  }

  @media print {
    .work-detail-back,
    .work-watch {
      display: none;
    }
  }
</style>
