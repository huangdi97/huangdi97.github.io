---
/**
 * Research (Chinese) — v2.2.1，编辑式首屏，不再是「一张横幅图」。
 *
 * 本轮改了什么。v2.1 保留了页面主视觉横幅并把它放在文案之上，于是产出了 Owner
 * 否掉的那个页面：标题在左、中间一张完整的图、大片空白、科学记号几乎看不出来。
 *
 * §14 把它换成一个编辑式构图：文案占左侧 46%，右侧 54% 是一片科学场域。
 * §19–§21 把位图从「页面的插画」降级为侧向背景强调：局部裁切、低不透明度、
 * 加蒙版——右侧保持清楚，向左自然消失，不出现矩形边界。
 * §22 把首屏收紧到 520–680px，让五个方向更早进入视野。
 *
 * 信息架构没有动：五个方向仍分两层，后面仍是研究札记。§23 要求每个方向只保留
 * 标题、一到两句，以及可选的项目引用；§24 要求札记保持首页式列表化，不要变回
 * 长博客归档。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ResearchArea from '../../components/ResearchArea.astro';
import LabNotes from '../../components/LabNotes.astro';
import Artwork from '../../components/Artwork.astro';
import { ARTWORK_LABELS, ART_ALT } from '../../data/artwork';
import { getResearch } from '../../data/research';
import { useT } from '../../i18n/ui';

const lang = 'zh' as const;
const t = useT(lang);
const areas = getResearch(lang);

/**
 * 层级划分随列表一起保留。它是事实判断而非样式选择：有可检视代码的方向，
 * 不会被渲染成与书面概念同等完成度。active 指可以打开代码的方向；
 * concept 指目标系统尚不存在的方向（太一·灵境始终属于后者，且始终标注为
 * 「概念 · 尚未开始」）。
 */
const activeAreas = areas.filter((area) => area.tier === 'active');
const conceptAreas = areas.filter((area) => area.tier === 'concept');

const path = '/zh/research/';
const enPath = '/research/';
const zhPath = '/zh/research/';
---

<BaseLayout
  title="研究方向"
  description="横跨生命系统、计算模型与智能系统的长期问题：AI 驱动的科学发现、智能体系统、AI 与健康、仿真与数字孪生，以及本地优先的个人智能。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/research.png"
  backgroundMode="research"
  preloadArtwork="research"
>
  <!-- §14：首屏是构图，不是堆叠。左侧文案，右侧科学场域；窄屏下两样东西落在
       同一列，图片跟在导语之后。 -->
  <section class="shell research-hero">
    <div class="rh-copy">
      <SectionHeading
        as="h1"
        eyebrow={t('research.eyebrow')}
        title="研究方向"
        lead={t('research.lead')}
      />
    </div>

    <div class="rh-visual">
      <div class="research-accent">
        <Artwork
          name="research"
          label={ARTWORK_LABELS.research[lang]}
          alt={ART_ALT.research[lang]}
        />
      </div>
    </div>
  </section>

  <section class="shell section-compact">
    <div class="research-body">
      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.active')}</p>
        <div class="research-group">
          {activeAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>

      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.concepts')}</p>
        <div class="research-group">
          {conceptAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>
    </div>
  </section>

  <LabNotes lang={lang} />
</BaseLayout>

<style>
  /* §22：收紧。v2.1 的横幅把第一个方向推到首屏之外，并在标题与列表之间留下
     一整屏空白。 */
  .research-hero {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* §14：左 46% / 右 54%。`align-items: center` 让文案与场域视觉居中，而不是
     顶到上边缘。 */
  @media (min-width: 1024px) {
    .research-hero {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
      min-height: clamp(520px, 58vh, 680px);
      padding-top: clamp(2.5rem, 5vw, 4rem);
    }
  }

  .rh-copy {
    max-width: 30rem;
  }

  /* §59：内页 h1 比 `.h1` 降约 15%，让首页继续保持全站最大的字（§60）。
     3.4rem 对首页的 5.5rem。 */
  .rh-copy :global(.head-title) {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    max-width: 14ch;
  }

  .rh-visual {
    position: relative;
    min-width: 0;
  }

  /* §19：图片是强调，所以允许它略大于所在列、向页面右缘溢出——和背景记号
     一样是「片段」而不是「一块板」。§68 要求不出现横向滚动，所以由父级网格
     列负责裁掉，而不是让文档溢出。 */
  .research-accent {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .research-accent {
      margin-right: calc(-1 * clamp(1rem, 3vw, 3.5rem));
    }
  }

  .research-body {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .research-tier + .research-tier {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .research-tier-label {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--faint);
  }

  .research-group {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
</style>
