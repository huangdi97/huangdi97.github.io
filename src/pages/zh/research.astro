---
/**
 * Research (Chinese) — v2.1, a page of questions rather than a method statement.
 *
 * What changed. v1.6 treated this route as the full record of a research
 * programme: the five directions (each a core question plus four bulleted
 * current interests), then a complete mathematical-biology figure set — a cell
 * landscape, an expression matrix, a bio network and a phase portrait — then a
 * standalone conceptual equation, then the dated lab-note log. Every part was
 * honest and every part was internal design: it answered "how would you build
 * this" for a reader who came to find out what the questions are (§22–§28).
 *
 * v2.1 keeps four things and stops:
 *
 *   · a page artwork band — the research field, the same paper and ink as the
 *     homepage, with neither the hero's profile nor a project's composition
 *     (§23);
 *   · five directions, each one to three sentences, stated as a problem rather
 *     than as a method (§24);
 *   · the two tiers, because "tied to code you can open" and "a written
 *     direction whose system does not exist" are different claims and are never
 *     rendered as equally finished (§28);
 *   · the lab notes, which are a short record of what changed in public — no
 *     roadmap, no internal design (§36–§38).
 *
 * Removed: the figure set, the equation, the interest lists, the framework
 * vocabulary and the speculative system design.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ResearchArea from '../../components/ResearchArea.astro';
import LabNotes from '../../components/LabNotes.astro';
import Artwork from '../../components/Artwork.astro';
import { ARTWORK_LABELS, ART_ALT } from '../../data/artwork';
import { getResearch } from '../../data/research';
import { useT } from '../../i18n/ui';

const lang = 'zh' as const;
const t = useT(lang);
const areas = getResearch(lang);

/**
 * 层级划分随列表一起保留。它是事实判断而非样式选择：有可检视代码的方向，
 * 不会被渲染成与书面概念同等完成度。active 指可以打开代码的方向；
 * concept 指目标系统尚不存在的方向（太一·灵境始终属于后者，且始终标注为
 * 「概念 · 尚未开始」）。
 */
const activeAreas = areas.filter((area) => area.tier === 'active');
const conceptAreas = areas.filter((area) => area.tier === 'concept');

const path = '/zh/research/';
const enPath = '/research/';
const zhPath = '/zh/research/';
---

<BaseLayout
  title="研究方向"
  description="五个研究方向：AI 驱动的科学发现、智能体系统、AI 与健康及计算生物学、仿真与数字孪生，以及本地优先的个人智能。"
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/research.png"
>
  <section class="shell section">
    <SectionHeading
      as="h1"
      eyebrow={t('research.eyebrow')}
      title="研究方向"
      lead={t('research.lead')}
    />

    <!-- 页面主视觉：与首页同一张纸、同一种墨，但不重复首页的人物侧脸，
         也不重复任何项目的构图。 -->
    <div class="research-band">
      <Artwork
        name="research"
        label={ARTWORK_LABELS.research[lang]}
        alt={ART_ALT.research[lang]}
      />
    </div>
  </section>

  <section class="shell section-compact">
    <div class="research-body">
      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.active')}</p>
        <div class="research-group">
          {activeAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>

      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.concepts')}</p>
        <div class="research-group">
          {conceptAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>
    </div>
  </section>

  <LabNotes lang={lang} />
</BaseLayout>

<style>
  .research-band {
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .research-body {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .research-tier + .research-tier {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .research-tier-label {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--faint);
  }

  .research-group {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
</style>
