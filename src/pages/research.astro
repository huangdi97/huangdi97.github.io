---
/**
 * Research (English) — v2.2.1, an editorial hero rather than a band.
 *
 * See the Chinese mirror for the full argument. In short, v2.1 kept the
 * artwork band and put it above the copy, which produced the page the owner
 * rejected: a title on the left, one complete drawing in the middle, a lot of
 * empty paper, and scientific marks that could not be seen.
 *
 * §14 replaces that with an editorial composition — the copy in the left 46%,
 * a scientific field in the right 54% — and §19–§21 demote the raster from "the
 * page's picture" to a side accent: partial crop, low opacity, masked so the
 * right stays clear and the drawing dissolves towards the copy. §22 tightens
 * the hero to 520–680px so the five directions enter the first screen.
 *
 * The page's information architecture is unchanged: five directions in two
 * tiers, then the lab notes. §23 keeps each direction to a title, one or two
 * sentences and an optional project reference.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchArea from '../components/ResearchArea.astro';
import LabNotes from '../components/LabNotes.astro';
import Artwork from '../components/Artwork.astro';
import { ARTWORK_LABELS, ART_ALT } from '../data/artwork';
import { getResearch } from '../data/research';
import { useT } from '../i18n/ui';

const lang = 'en' as const;
const t = useT(lang);
const areas = getResearch(lang);

/**
 * The tier split travels with the list. It is a truth claim, not a style
 * choice: a direction tied to inspectable code is never rendered as the twin of
 * a written concept. `active` is code you can open; `concept` is a direction
 * whose target system does not exist yet — TaiYi Lingjing stays in the concept
 * tier and stays "Concept · Not Started".
 */
const activeAreas = areas.filter((area) => area.tier === 'active');
const conceptAreas = areas.filter((area) => area.tier === 'concept');

const path = '/research/';
const enPath = '/research/';
const zhPath = '/zh/research/';
---

<BaseLayout
  title="Research"
  description="Long-term questions across biological systems, computational models and intelligent systems — AI for scientific discovery, agentic systems, AI for health, simulation, and local-first personal intelligence."
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/research.png"
  backgroundMode="research"
  preloadArtwork="research"
>
  <!-- §14: the hero is a composition, not a stack. Copy left, scientific field
       right; on a phone it is the same two things in one column, with the
       drawing under the lead. -->
  <section class="shell research-hero">
    <div class="rh-copy">
      <SectionHeading as="h1" eyebrow={t('research.eyebrow')} title="Research" lead={t('research.lead')} />
    </div>

    <div class="rh-visual">
      <div class="research-accent">
        <Artwork
          name="research"
          label={ARTWORK_LABELS.research[lang]}
          alt={ART_ALT.research[lang]}
        />
      </div>
    </div>
  </section>

  <section class="shell section-compact">
    <div class="research-body">
      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.active')}</p>
        <div class="research-group">
          {activeAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>

      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.concepts')}</p>
        <div class="research-group">
          {conceptAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>
    </div>
  </section>

  <LabNotes lang={lang} />
</BaseLayout>

<style>
  /* §22: tightened. v2.1's band pushed the first direction below the fold and
     left a screen of empty paper between the title and the list. */
  .research-hero {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  /* §14: left 46% / right 54%. `align-items: center` is what keeps the copy
     optically centred against the field rather than pinned to its top edge. */
  @media (min-width: 1024px) {
    .research-hero {
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
      min-height: clamp(520px, 58vh, 680px);
      padding-top: clamp(2.5rem, 5vw, 4rem);
    }
  }

  .rh-copy {
    max-width: 30rem;
  }

  /* §59: the inner-page h1 steps down ~15% from `.h1` so the homepage keeps the
     largest type on the site (§60). 3.4rem against the homepage's 5.5rem. */
  .rh-copy :global(.head-title) {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    max-width: 14ch;
  }

  .rh-visual {
    position: relative;
    min-width: 0;
  }

  /* §19: the drawing is an accent, so the frame is allowed to sit slightly
     larger than its column and run off the right edge of the page — the same
     "fragment rather than plate" argument the background marks use. The
     document must not gain a horizontal scrollbar (§68), so the parent grid
     column clips it instead. */
  .research-accent {
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .research-accent {
      margin-right: calc(-1 * clamp(1rem, 3vw, 3.5rem));
    }
  }

  .research-body {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .research-tier + .research-tier {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .research-tier-label {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--faint);
  }

  .research-group {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
</style>
