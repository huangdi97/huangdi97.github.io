---
/**
 * Research (English) — v2.1, a page of questions rather than a method statement.
 *
 * See the Chinese mirror for the full argument. In short: v1.6 treated this
 * route as the full record of a research programme — five directions with
 * bulleted interest lists, a complete mathematical-biology figure set, a
 * standalone conceptual equation and the dated lab-note log. Every part was
 * honest and every part was internal design (§22–§28).
 *
 * v2.1 keeps the artwork band, five one-to-three-sentence directions, the two
 * tiers and the lab notes, and removes the figure set, the equation and the
 * interest lists.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ResearchArea from '../components/ResearchArea.astro';
import LabNotes from '../components/LabNotes.astro';
import Artwork from '../components/Artwork.astro';
import { ARTWORK_LABELS, ART_ALT } from '../data/artwork';
import { getResearch } from '../data/research';
import { useT } from '../i18n/ui';

const lang = 'en' as const;
const t = useT(lang);
const areas = getResearch(lang);

/**
 * The tier split travels with the list. It is a truth claim, not a style
 * choice: a direction tied to inspectable code is never rendered as the twin of
 * a written concept. `active` is code you can open; `concept` is a direction
 * whose target system does not exist yet — TaiYi Lingjing stays in the concept
 * tier and stays "Concept · Not Started".
 */
const activeAreas = areas.filter((area) => area.tier === 'active');
const conceptAreas = areas.filter((area) => area.tier === 'concept');

const path = '/research/';
const enPath = '/research/';
const zhPath = '/zh/research/';
---

<BaseLayout
  title="Research"
  description="Five research directions: AI for scientific discovery, agentic systems, AI for health and computational biology, simulation and digital twins, and local-first personal intelligence."
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/research.png"
  backgroundMode="research"
  preloadArtwork="research"
>
  <section class="shell section">
    <SectionHeading
      as="h1"
      eyebrow={t('research.eyebrow')}
      title="Research"
      lead={t('research.lead')}
    />

    <!-- Page artwork: the same paper and ink as the homepage, without the
         hero's profile and without any project's composition. -->
    <div class="research-band">
      <Artwork
        name="research"
        label={ARTWORK_LABELS.research[lang]}
        alt={ART_ALT.research[lang]}
      />
    </div>
  </section>

  <section class="shell section-compact">
    <div class="research-body">
      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.active')}</p>
        <div class="research-group">
          {activeAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>

      <div class="research-tier">
        <p class="research-tier-label mono">{t('research.concepts')}</p>
        <div class="research-group">
          {conceptAreas.map((area) => <ResearchArea area={area} lang={lang} headingLevel="h2" />)}
        </div>
      </div>
    </div>
  </section>

  <LabNotes lang={lang} />
</BaseLayout>

<style>
  /* §28: the page artwork stops being a banner the page has to be read around.
     It is capped at 56rem and pushed to the right edge of the column, so the
     left margin it gives up is paper the background system can use — which is
     the whole point of §13's sparse composition.

     Only the width changes. The frame keeps its 8:5 ratio and its 100% object
     position, so the visible *fraction* of the source is untouched: `cover` on
     a fixed-ratio frame always shows 1.6/2 = 80% of a 2:1 source, at any
     rendered size. Nothing about the crop needed re-verifying because nothing
     about the crop changed — the drawing is simply smaller. */
  .research-band {
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
    max-width: 56rem;
    margin-left: auto;
  }

  .research-body {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .research-tier + .research-tier {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .research-tier-label {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    color: var(--faint);
  }

  .research-group {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
</style>
