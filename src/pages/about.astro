---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { SITE } from '../config/site';
import { useT } from '../i18n/ui';
import { getAbout } from '../data/about';
import { getHow } from '../data/how';
import { profilePageJsonLd } from '../data/profile';

const lang = 'en' as const;
const t = useT(lang);
const about = getAbout(lang);
const how = getHow(lang);

const path = '/about/';
const enPath = '/about/';
const zhPath = '/zh/about/';

const profileLd = profilePageJsonLd(lang, path, `${SITE.nameEn} — About`);
---

<BaseLayout
  title="About"
  seoTitle="Hao Lei — About | AI Systems, Agents & Life Science"
  description="Hao Lei — AI systems engineering grounded in life-science experimental research, computational biology and IVD / vaccine industry experience."
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/about.png"
  type="profile"
  jsonLd={profileLd}
>
  <article class="shell section">
    <div class:list={['about-top', SITE.portrait && 'about-top-with-portrait']}>
      <header class="about-head">
        <p class="eyebrow">About</p>
        <h1 class="display about-name">HAO LEI</h1>
        <p class="about-headline">{about.headline}</p>
      </header>

      {
        /*
         * Portrait slot. Rendered only when SITE.portrait points at a real
         * image. With no photograph the page keeps its text-only layout —
         * nothing here invents a face.
         */
        SITE.portrait && (
          <figure class="about-portrait">
            <img
              src={SITE.portrait}
              width="480"
              height="600"
              alt={t('about.portraitAlt')}
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }
    </div>

    <div class="about-intro">
      {about.intro.map((p) => <p>{p}</p>)}
    </div>

    <section class="about-section">
      <h2 class="h2">{about.focusTitle}</h2>
      <ul class="focus-grid">
        {
          about.focus.map((item) => (
            <li class="focus-item">
              <h3 class="focus-title">{item.title}</h3>
              <p class="focus-body">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.backgroundTitle}</h2>
      <p class="lead about-section-lead">{about.backgroundIntro}</p>
      <ol class="background-chain">
        {
          about.background.map((step) => (
            <li class="background-step">
              <p class="background-step-title">{step.title}</p>
              <p class="background-step-body">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.approachTitle}</h2>
      <p class="lead about-section-lead">{about.approachIntro}</p>
      <div class="about-timeline">
        <Timeline steps={how} />
      </div>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.scopeTitle}</h2>
      <ul class="scope-list">
        {about.scope.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.contactTitle}</h2>
      <p class="lead about-section-lead">{about.contactIntro}</p>
      <div class="about-actions">
        <ContactLinks lang={lang} variant="buttons" />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-top {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: end;
  }

  @media (min-width: 900px) {
    .about-top-with-portrait {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 3rem;
    }
  }

  .about-portrait {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
    overflow: hidden;
    background: var(--card);
  }

  .about-portrait img {
    display: block;
    width: 100%;
    height: auto;
  }

  .about-head {
    max-width: 44ch;
  }

  .about-name {
    margin-top: 1.25rem;
  }

  .about-headline {
    margin-top: 1.75rem;
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    line-height: 1.32;
    letter-spacing: -0.026em;
    max-width: 28ch;
  }

  .about-intro {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-intro p {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--muted);
  }

  .about-section {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .about-section-lead {
    margin-top: 1rem;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem 3rem;
    list-style: none;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 0;
  }

  @media (min-width: 700px) {
    .focus-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .focus-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .focus-item {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .focus-title {
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
  }

  .focus-body {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .about-timeline {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .scope-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 68ch;
  }

  .scope-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .scope-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--ink);
  }

  .background-chain {
    list-style: none;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 2.5rem;
  }

  @media (min-width: 700px) {
    .background-chain {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .background-chain {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .background-step {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
  }

  .background-step-title {
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .background-step-body {
    margin-top: 0.4rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
