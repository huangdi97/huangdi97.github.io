---
/**
 * About (English) — v2.1, an introduction rather than a method statement.
 *
 * See the Chinese mirror for the full argument. v1.6 ran this page as a
 * statement of working method — a six-card technique grid, a "How I work"
 * section rendering the six-stage process rail, and an expanded background
 * chain (§29–§33).
 *
 * v2.1 keeps: who this is, a page artwork band, five one-line directions, a
 * single lead sentence and the five-node path rail, scope, and contact.
 * Removed: the method grid, the "How I work" stages and their process rail,
 * the design-philosophy paragraph, and the portrait branch (`SITE.portrait` is
 * still null, so it rendered nothing, and the page now has a visual of its own).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BackgroundTimeline from '../components/BackgroundTimeline.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Artwork from '../components/Artwork.astro';
import { ARTWORK_LABELS, ART_ALT } from '../data/artwork';
import { SITE } from '../config/site';
import { getAbout } from '../data/about';
import { profilePageJsonLd } from '../data/profile';

const lang = 'en' as const;
const about = getAbout(lang);

const path = '/about/';
const enPath = '/about/';
const zhPath = '/zh/about/';

const profileLd = profilePageJsonLd(lang, path, `${SITE.nameEn} — About`);
---

<BaseLayout
  title="About"
  seoTitle="Hao Lei — About | AI Systems, Agents & Life Science"
  description="Hao Lei — AI systems engineering grounded in life-science experimental research, computational biology and IVD / vaccine industry experience."
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/about.png"
  type="profile"
  jsonLd={profileLd}
>
  <article class="shell section">
    <header class="about-head">
      <p class="eyebrow">About</p>
      <h1 class="display about-name">HAO LEI</h1>
      <p class="about-headline">{about.headline}</p>
    </header>

    <!-- Page artwork: the same paper and ink as the homepage, without the
         hero's profile and without a product screen. -->
    <div class="about-band">
      <Artwork name="about" label={ARTWORK_LABELS.about[lang]} alt={ART_ALT.about[lang]} />
    </div>

    <div class="about-intro">
      {about.intro.map((p) => <p>{p}</p>)}
    </div>

    <section class="about-section">
      <h2 class="h2">{about.focusTitle}</h2>
      <ul class="focus-list">
        {about.focus.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.backgroundTitle}</h2>
      <p class="lead about-section-lead">{about.backgroundIntro}</p>

      <div class="about-path">
        <BackgroundTimeline lang={lang} />
      </div>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.scopeTitle}</h2>
      <ul class="scope-list">
        {about.scope.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="about-section">
      <h2 class="h2">{about.contactTitle}</h2>
      <p class="lead about-section-lead">{about.contactIntro}</p>
      <div class="about-actions">
        <ContactLinks lang={lang} variant="buttons" />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about-head {
    max-width: 44ch;
  }

  .about-name {
    margin-top: 1.25rem;
  }

  .about-headline {
    margin-top: 1.75rem;
    font-size: clamp(1.25rem, 2.6vw, 1.875rem);
    line-height: 1.32;
    letter-spacing: -0.026em;
    max-width: 28ch;
  }

  .about-band {
    margin-top: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .about-intro {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-intro p {
    font-size: 1.0625rem;
    line-height: 1.72;
    color: var(--muted);
  }

  .about-section {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }

  .about-section-lead {
    margin-top: 1rem;
  }

  /* Five one-line directions, not six method cards. */
  .focus-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    max-width: 68ch;
  }

  .focus-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .focus-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--ink);
  }

  /* The five-node path rail. */
  .about-path {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .scope-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 68ch;
  }

  .scope-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .scope-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--ink);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
