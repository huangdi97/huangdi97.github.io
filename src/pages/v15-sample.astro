---
/**
 * v1.5 visual sample — homepage direction only (English route mirror).
 *
 * This page exists only so the Chinese-first sample has a valid alternate
 * language link. It is not meant to be indexed or linked from the site.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ScientificCanvas from '../components/ScientificCanvas.astro';
import ProjectPoster from '../components/ProjectPoster.astro';
import { SITE } from '../config/site';
import { useT, localizedPath } from '../i18n/ui';
import { getFeaturedProjects, projectHref } from '../lib/projects';
import { getProjectEvidence } from '../data/evidence';
import { posterFor } from '../data/projectPosters';

const lang = 'en' as const;
const t = useT(lang);

const featured = await getFeaturedProjects(lang, 5);
const SAMPLE_SLUGS = ['wennian', 'hycell'];
const picks = SAMPLE_SLUGS.flatMap((slug) => featured.filter((p) => p.data.slug === slug));
---

<BaseLayout
  title="v1.5 Visual Sample — Homepage Direction"
  description="v1.5 homepage visual sample: scientific canvas background + minimal project posters."
  lang={lang}
  path="/v15-sample/"
  enPath="/v15-sample/"
  zhPath="/zh/v15-sample/"
  noindex={true}
>
  <!-- ─────────────────────────── HERO ─────────────────────────── -->
  <section class="shell sample-hero canvas-host">
    <ScientificCanvas zone="hero" />

    <p class="eyebrow">{t('hero.eyebrow')}</p>
    <h1 class="display sample-hero-title">{t('hero.title')}</h1>
    <p class="sample-hero-sub">{t('hero.subtitle')}</p>
    <p class="sample-hero-statement">{t('hero.statement')}</p>
    <p class="lead sample-hero-support">{t('hero.support')}</p>

    <div class="hero-actions">
      <a href="/projects/" class="btn btn-primary">{t('hero.cta.work')}</a>
      <a href={SITE.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
        {t('hero.cta.github')}
      </a>
      <a href={localizedPath(lang, '/resume')} class="btn btn-outline">{t('hero.cta.resume')}</a>
    </div>

    <div class="hero-capabilities">
      <p class="mono">{t('hero.capabilities')}</p>
      <ul>
        {SITE.focusAreas.map((area) => <li>{area.en}</li>)}
      </ul>
    </div>
  </section>

  <!-- ─────────────────── SELECTED WORK (sample) ───────────────── -->
  <section class="shell section canvas-host" id="work">
    <ScientificCanvas zone="work" />

    <div class="sample-head">
      <p class="eyebrow">{t('work.eyebrow')}</p>
      <h2 class="h2 sample-title">{t('work.title')}</h2>
    </div>

    <div class="sample-list">
      {
        picks.map((project, i) => {
          const d = project.data;
          const poster = posterFor(d.slug);
          const evidence = getProjectEvidence(d.slug);
          const href = projectHref(lang, d.slug);
          const statusKey = `status.${d.status.toLowerCase()}`;
          const isConcept = /concept|尚未开始|概念/i.test(d.coverStatus);
          return (
            <article class="sample-block" data-sample-block={d.slug}>
              <div class="sample-figure">
                {poster && (
                  <ProjectPoster
                    variant={poster.variant}
                    caption={poster.caption[lang]}
                    status={d.coverStatus}
                    concept={isConcept}
                    label={`${d.title} — ${poster.caption[lang]}`}
                    href={href}
                  />
                )}
              </div>

              <div class="sample-body">
                <p class="sample-cat mono">
                  <span class="sample-index">{String(i + 1).padStart(2, '0')}</span>
                  <span>{d.category}</span>
                </p>

                <h3 class="sample-name">
                  <a href={href}>{d.title}</a>
                </h3>

                <p class="sample-summary">{d.summary}</p>
                <p class="body-muted sample-desc">{d.description}</p>

                {evidence && (
                  <p class="sample-reality">
                    <span class="reality-pill" data-code={evidence.publicCode}>
                      {evidence.headline[lang]}
                    </span>
                  </p>
                )}

                <div class="sample-actions">
                  <a href={href} class="link-arrow">
                    {t('work.case')}
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                  {d.repo && (
                    <a href={d.repo} class="link-arrow" target="_blank" rel="noopener noreferrer">
                      {t('work.repo')}
                      <span class="arrow" aria-hidden="true">↗</span>
                    </a>
                  )}
                  <span class="sample-status">{t(statusKey)}</span>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <p class="shell sample-note mono">
    Sample scope: Hero + scientific canvas, ZhiShen · WenNian, HyCell. For
    directional review only; not wired to the real homepage yet.
  </p>
</BaseLayout>

<style>
  .canvas-host {
    position: relative;
    isolation: isolate;
  }

  .sample-hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .sample-hero-title {
    margin-top: 1.25rem;
  }

  .sample-hero-sub {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sample-hero-statement {
    margin-top: 1.75rem;
    font-size: clamp(1.375rem, 2.8vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.024em;
    max-width: 26ch;
  }

  .sample-hero-support {
    margin-top: 1.25rem;
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-capabilities {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero-capabilities ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .hero-capabilities li {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .sample-head {
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .sample-title {
    margin-top: 0.75rem;
  }

  .sample-list {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 8vw, 7rem);
  }

  .sample-block {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .sample-block {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
    }

    .sample-block[data-sample-block='hycell'] .sample-figure {
      order: 2;
    }
  }

  .sample-figure {
    min-width: 0;
  }

  .sample-body {
    min-width: 0;
    max-width: 62ch;
  }

  .sample-cat {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .sample-index {
    color: var(--ink);
  }

  .sample-name {
    margin-top: 0.75rem;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.024em;
  }

  .sample-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .sample-summary {
    margin-top: 0.875rem;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.45;
    letter-spacing: -0.018em;
    color: var(--ink);
    max-width: 42ch;
  }

  .sample-desc {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
  }

  .sample-reality {
    margin: 1.25rem 0 0;
  }

  .reality-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 2px;
    border: 1px solid var(--line-strong);
    background: rgba(0, 0, 0, 0.035);
    color: var(--ink);
  }

  .reality-pill[data-code='none'] {
    border-style: dashed;
    background: transparent;
    color: var(--muted);
  }

  .sample-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .sample-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--faint);
    margin-left: auto;
  }

  .sample-note {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
</style>
