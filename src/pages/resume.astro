---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeDocument from '../components/ResumeDocument.astro';
import { SITE } from '../config/site';
import { profilePageJsonLd } from '../data/profile';

const lang = 'en' as const;

const path = '/resume/';
const enPath = '/resume/';
const zhPath = '/zh/resume/';

const profileLd = profilePageJsonLd(lang, path, `${SITE.nameEn} — Resume`);
---

<BaseLayout
  title="Resume"
  seoTitle="Hao Lei — Resume | AI Systems, Agents & Life Science"
  description="Resume — Hao Lei. AI systems, agentic systems, computational biology, digital health and simulation, grounded in life-science research and IVD / vaccine industry experience. Printable from the browser as PDF."
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/resume.png"
  type="profile"
  jsonLd={profileLd}
  backgroundMode="resume"
>
  <ResumeDocument lang={lang} />
</BaseLayout>
