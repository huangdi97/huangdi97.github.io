---
/**
 * Projects index (English) — v2.2.1.
 *
 * The locale mirror of /zh/projects. English is not the reviewed locale, but it
 * must build and must not diverge structurally: a visitor who switches language
 * should not land in a different information architecture.
 *
 * See `src/pages/zh/projects/index.astro` for the full argument. In short, v2.2
 * had re-grown two things the owner asked to be rid of: an "other work" index
 * that published three unfinished projects, and a full-width inverted artifact
 * room that read as a different website bolted onto this one. Both are gone
 * from the public page. What is left is four entries — name, one line, status,
 * one link — the open-source list, and a single text link out.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import OpenSourceList from '../../components/OpenSourceList.astro';
import { SITE } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getProjects } from '../../lib/projects';

const lang = 'en' as const;
const t = useT(lang);

const all = await getProjects(lang);
const featured = all.filter((project) => project.data.featured);

const path = '/projects/';
const enPath = '/projects/';
const zhPath = '/zh/projects/';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Projects — ${SITE.nameEn}`,
  url: new URL(path, SITE.url).href,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: featured.length,
    itemListElement: featured.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.data.title,
      url: new URL(`/projects/${p.data.slug}/`, SITE.url).href,
    })),
  },
};
---

<BaseLayout
  title="Projects"
  description="Curated projects in AI health, computational biology, agent systems and local-first infrastructure. Each entry says what it is and how much is public today."
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/projects.png"
  backgroundMode="projects"
  jsonLd={collectionLd}
>
  <section class="shell section">
    <SectionHeading
      as="h1"
      eyebrow={t('work.eyebrow')}
      title="Projects"
      lead={t('work.public.lead')}
    />

    <div class="entry-grid">
      {featured.map((project) => <ProjectEntry project={project} lang={lang} />)}
    </div>
  </section>

  <section class="shell section">
    <SectionHeading
      eyebrow={t('oss.eyebrow')}
      title={t('oss.title')}
      lead={t('oss.lead')}
      href={SITE.github}
      linkLabel={t('oss.all')}
    />

    <OpenSourceList lang={lang} />
  </section>

  <!-- §43–§44: the page's one exit, and it is a line rather than a block.
       Nothing was deleted — `src/data/artifacts.ts` is untouched and still
       exports the three artifacts, and `SelectedArtifacts.astro` still exists
       in the tree. What is gone is the *mount*: a full-width inverted room on a
       directory page. It currently renders nowhere, which the artifact gate
       asserts rather than assumes. -->
  <p class="shell work-exit">
    <a class="link-arrow" href={SITE.github} target="_blank" rel="noopener noreferrer">
      {t('artifacts.title')}
      <span class="arrow" aria-hidden="true">→</span>
      <span class="sr-only"> ({t('a11y.external')})</span>
    </a>
  </p>
</BaseLayout>

<style>
  .entry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 760px) {
    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2.5rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem);
    }
  }

  .work-exit {
    margin: 0 auto clamp(3rem, 6vw, 5rem);
  }
</style>
