---
/**
 * Projects index (English) — v2.1.
 *
 * The locale mirror of /zh/projects. English is not the reviewed locale, but it
 * must build and must not diverge structurally: a visitor who switches language
 * should not land in a different information architecture.
 *
 * See `src/pages/zh/projects/index.astro` for what changed and why: a curated
 * directory of public entries with the project's own artwork, a light "other
 * work" index, and one reduced evidence list — three rows, each quoting a public
 * repository, in place of the five-tile room that used to take 44% of the page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectEntry from '../../components/ProjectEntry.astro';
import SelectedArtifacts from '../../components/SelectedArtifacts.astro';
import OpenSourceList from '../../components/OpenSourceList.astro';
import { SITE } from '../../config/site';
import { useT } from '../../i18n/ui';
import { getProjects, projectHref } from '../../lib/projects';
import { projectStatus } from '../../lib/projectStatus';

const lang = 'en' as const;
const t = useT(lang);

const all = await getProjects(lang);
const featured = all.filter((project) => project.data.featured);
const others = all.filter((project) => !project.data.featured);

const path = '/projects/';
const enPath = '/projects/';
const zhPath = '/zh/projects/';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Projects — ${SITE.nameEn}`,
  url: new URL(path, SITE.url).href,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: all.length,
    itemListElement: all.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.data.title,
      url: new URL(`/projects/${p.data.slug}/`, SITE.url).href,
    })),
  },
};
---

<BaseLayout
  title="Projects"
  description="Curated projects in AI health, computational biology, agent systems and local-first infrastructure. Each entry says what it is, what it is for, and how much is public today."
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/projects.png"
  jsonLd={collectionLd}
>
  <section class="shell section">
    <SectionHeading
      as="h1"
      eyebrow={t('work.eyebrow')}
      title="Projects"
      lead={t('work.public.lead')}
    />

    <div class="entry-grid">
      {featured.map((project) => <ProjectEntry project={project} lang={lang} />)}
    </div>
  </section>

  <!-- Other work: no public repository and no official artwork, so a light index
       rather than a second grid of cards. -->
  <section class="shell section-tight">
    <h2 class="other-title">{t('work.other')}</h2>
    <p class="other-lead">{t('work.other.lead')}</p>

    <ul class="other-list">
      {
        others.map((project) => {
          const status = projectStatus(project.data.slug, lang, t);
          return (
            <li class="other-item">
              <a class="other-name" href={projectHref(lang, project.data.slug)}>
                {project.data.title}
              </a>
              <span class="other-line">{project.data.publicLine}</span>
              {status && <span class="other-status">{status}</span>}
            </li>
          );
        })
      }
    </ul>
  </section>

  <!-- Selected public work: three rows, each quoted from a public repository,
       each with the file it was read from. The repository trees, terminal
       transcripts and metric dumps are no longer printed here. -->
  <SelectedArtifacts lang={lang} />

  <section class="shell section">
    <SectionHeading
      eyebrow={t('oss.eyebrow')}
      title={t('oss.title')}
      lead={t('oss.lead')}
      href={SITE.github}
      linkLabel={t('oss.all')}
    />

    <OpenSourceList lang={lang} />
  </section>
</BaseLayout>

<style>
  .entry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 3.5rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  @media (min-width: 760px) {
    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2.5rem, 4vw, 3.5rem) clamp(2rem, 4vw, 3rem);
    }
  }

  .other-title {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.022em;
    font-weight: 500;
    margin: 0;
  }

  .other-lead {
    margin: 0.625rem 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 62ch;
  }

  .other-list {
    list-style: none;
    margin: clamp(1.5rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  /* A light index, not a second grid of cards: one hairline per row, the name
     in ink, the line muted, the status quiet in the mono face. */
  .other-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .other-item {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) auto;
      gap: 0.25rem 1.5rem;
      align-items: baseline;
    }
  }

  .other-name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
  }

  .other-name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .other-line {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .other-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--faint);
    white-space: nowrap;
  }
</style>
