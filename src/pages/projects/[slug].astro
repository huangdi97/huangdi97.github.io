---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import ArchitectureDiagram from '../../components/ArchitectureDiagram.astro';
import ProjectReality from '../../components/ProjectReality.astro';
import Tag from '../../components/Tag.astro';
import { SITE } from '../../config/site';
import { useT } from '../../i18n/ui';
import { projectsHref, projectHref, nextProject, getProjects } from '../../lib/projects';
import { getArchitecture } from '../../data/architecture';
import { getProjectEvidence } from '../../data/evidence';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { slug: entry.data.slug },
  }));
}

const { slug } = Astro.props;

const lang = 'en' as const;
const t = useT(lang);

const all = await getProjects(lang);
const entry = all.find((e) => e.data.slug === slug);
if (!entry) throw new Error(`Unknown project: ${slug}`);

const { Content } = await render(entry);
const d = entry.data;
const upNext = nextProject(all, d.slug);

const path = `/projects/${d.slug}/`;
const enPath = path;
const zhPath = `/zh/projects/${d.slug}/`;

const steps = getArchitecture(d.slug, lang);
const evidence = getProjectEvidence(d.slug);

const ld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': d.repo ? 'SoftwareSourceCode' : 'CreativeWork',
    name: d.title,
    headline: d.summary,
    description: d.description,
    url: new URL(path, SITE.url).href,
    inLanguage: 'en',
    datePublished: String(d.year),
    keywords: d.tags.join(', '),
    author: { '@type': 'Person', name: SITE.nameEn, url: SITE.url },
    ...(d.repo ? { codeRepository: d.repo, programmingLanguage: d.stack } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/projects/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: new URL(path, SITE.url).href },
    ],
  },
];
---

<BaseLayout
  title={d.title}
  seoTitle={d.seoTitle}
  description={d.summary}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage={`/og/${d.slug}.png`}
  type="article"
  jsonLd={ld}
>
  <article class="shell case">
    <nav class="case-back" aria-label="Breadcrumb">
      <a href={projectsHref(lang)} class="link-arrow">
        <span class="arrow" aria-hidden="true">←</span>
        {t('project.back')}
      </a>
    </nav>

    <header class="case-head">
      <p class="eyebrow">{d.category}</p>
      <h1 class="h1 case-title">{d.title}</h1>
      {d.subtitle && <p class="case-subtitle">{d.subtitle}</p>}
      <p class="case-thesis">{d.summary}</p>

      <div class="case-meta">
        <ProjectMeta
          lang={lang}
          year={d.year}
          status={d.status}
          role={d.role}
          category={d.category}
          stack={d.stack}
          publicCode={evidence?.publicCode}
          reality={evidence ? evidence.reality[lang] : undefined}
          snapshotDate={evidence?.snapshot?.date}
        />
      </div>

      {
        d.statusNote && (
          <p class="case-note">
            <span class="mono">{t('meta.status')}</span>
            {d.statusNote}
          </p>
        )
      }

      <div class="case-actions">
        {
          d.repo && (
            <a href={d.repo} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              {t('work.repo')}
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          d.demo && (
            <a href={d.demo} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              Demo
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
        {
          evidence && (
            <a href="#reality" class="btn btn-outline">
              {t('evidence.title')}
              <span aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
    </header>

    <div class="case-visual">
      <ProjectVisual variant={d.visual} label={`${d.title} — ${d.category}`} />
    </div>

    <div class="case-grid">
      <div class="prose-editorial case-prose">
        <Content />
      </div>

      <aside class="case-aside">
        {
          steps.length > 0 && (
            <section class="aside-block">
              <ArchitectureDiagram steps={steps} title="Architecture" />
            </section>
          )
        }

        <section class="aside-block">
          <p class="eyebrow">{t('project.links')}</p>
          <ul class="aside-links">
            {
              d.repo && (
                <li>
                  <a href={d.repo} class="link-arrow" target="_blank" rel="noopener noreferrer">
                    {t('work.repo')}
                    <span class="arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              )
            }
            {
              !d.repo && (
                <li class="aside-muted">
                  {t('work.repo')} — {t('project.noRepo')}
                </li>
              )
            }
            {
              d.demo && (
                <li>
                  <a href={d.demo} class="link-arrow" target="_blank" rel="noopener noreferrer">
                    Demo
                    <span class="arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                </li>
              )
            }
          </ul>
        </section>

        {
          d.tags.length > 0 && (
            <section class="aside-block">
              <p class="eyebrow">Tags</p>
              <ul class="aside-tags">
                {d.tags.map((tag) => (
                  <li>
                    <Tag text={tag} />
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>
    </div>

    {
      evidence && <ProjectReality evidence={evidence} lang={lang} idPrefix={d.slug} />
    }

    {
      upNext && (
        <nav class="case-next" aria-label={t('project.next')}>
          <hr class="rule" />
          <a href={projectHref(lang, upNext.data.slug)} class="next-link">
            <span class="mono">{t('project.next')}</span>
            <span class="next-title">{upNext.data.title}</span>
            <span class="next-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  .case {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .case-back {
    padding-block: 1rem 2rem;
  }

  .case-head {
    max-width: 60ch;
  }

  .case-title {
    margin-top: 1rem;
  }

  .case-subtitle {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .case-thesis {
    margin-top: 1.25rem;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .case-meta {
    margin-top: 2.5rem;
  }

  .case-note {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .case-visual {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }

  .case-grid {
    display: grid;
    gap: 3rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 1024px) {
    .case-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: 5rem;
      align-items: start;
    }

    .case-aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .case-aside {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .aside-block {
    border-top: 1px solid var(--line);
    padding-top: 1.25rem;
  }

  .aside-links {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .aside-muted {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--faint);
  }

  .aside-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  .case-next {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .next-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1rem;
    padding-top: 1.5rem;
    align-items: baseline;
  }

  .next-title {
    grid-column: 1;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    letter-spacing: -0.024em;
  }

  .next-arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: 1.25rem;
    color: var(--faint);
    transition: transform var(--dur-base) var(--ease);
  }

  .next-link:hover .next-arrow {
    transform: translateX(5px);
    color: var(--ink);
  }

  /* Markdown body typography */
  .case-prose :global(h2) {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    letter-spacing: -0.022em;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    color: var(--ink);
  }

  .case-prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  .case-prose :global(h3) {
    font-size: 1.0625rem;
    margin-top: 2rem;
    margin-bottom: 0.25rem;
    color: var(--ink);
  }

  .case-prose :global(pre) {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    margin-block: 1.5rem;
  }

  .case-prose :global(p code),
  .case-prose :global(li code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: rgba(0, 0, 0, 0.045);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  .case-prose :global(ol) {
    margin-block: 1rem;
    padding-left: 1.35rem;
  }

  .case-prose :global(ol li) {
    margin-bottom: 0.5rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .case-prose :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }

  .case-prose :global(p) {
    margin-block: 1rem;
    color: var(--muted);
    line-height: 1.72;
  }
</style>
