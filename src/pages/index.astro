---
/**
 * Homepage (English) — v1.7-P0 visual prototype.
 *
 * The locale mirror of /zh/. English is not the reviewed locale this round, but
 * it must build and must not diverge structurally: a visitor who switches
 * language should not land in a different information architecture.
 *
 * See `src/pages/zh/index.astro` for what changed and why, and
 * V1_7_P0_VISUAL_PROTOTYPE_REPORT.md for what is deliberately unfinished.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectMosaic from '../components/ProjectMosaic.astro';
import MathematicsBiologyAI from '../components/MathematicsBiologyAI.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { SITE } from '../config/site';
import { useT, localizedPath } from '../i18n/ui';
import { getFeaturedProjects, projectsHref } from '../lib/projects';
import { personSchema } from '../data/profile';

const lang = 'en' as const;
const t = useT(lang);

/** Four, not five. PDIG and TaiYi keep full pages under /projects. */
const featured = await getFeaturedProjects(lang, 4);

const path = '/';
const enPath = '/';
const zhPath = '/zh/';

const personLd = personSchema(lang);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.nameEn} — Personal AI Lab`,
  url: SITE.url,
  inLanguage: 'en',
  description: SITE.description.en,
  author: { '@type': 'Person', name: SITE.nameEn },
};
---

<BaseLayout
  title={`${SITE.nameEn} — Personal AI Lab`}
  description={SITE.description.en}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/home.png"
  type="profile"
  jsonLd={[personLd, websiteLd]}
  minimalFooter={true}
>
  <!-- ───────────────────────────── HERO ──────────────────────────────── -->
  <section class="shell hero">
    <div class="hero-copy">
      <p class="eyebrow">{t('hero.eyebrow')}</p>
      <h1 class="display hero-title">{t('hero.title')}</h1>
      <p class="hero-sub">{t('hero.subtitle')}</p>
      <p class="hero-statement">{t('hero.statement')}</p>
      <p class="lead hero-support">{t('hero.support')}</p>

      <div class="hero-actions">
        <a href={projectsHref(lang)} class="btn btn-primary">{t('hero.cta.work')}</a>
        <a href={SITE.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
          {t('hero.cta.github')}
        </a>
        <a href={localizedPath(lang, '/resume')} class="btn btn-outline">
          {t('hero.cta.resume')}
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── SELECTED WORK ─────────────────────────── -->
  <section class="shell section" id="work">
    <SectionHeading
      eyebrow={t('work.eyebrow')}
      title={t('work.title')}
      lead={t('work.lead')}
      href={projectsHref(lang)}
      linkLabel={t('work.all')}
    />

    <ProjectMosaic projects={featured} lang={lang} />
  </section>

  <!-- ──────────────────── MATHEMATICS × BIOLOGY × AI ─────────────────── -->
  <MathematicsBiologyAI lang={lang} />

  <!-- ───────────────────────── ABOUT / CONTACT ───────────────────────── -->
  <section class="shell section-tight" id="contact">
    <div class="contact-band">
      <div class="contact-copy">
        <p class="eyebrow">{t('home.contact.eyebrow')}</p>
        <h2 class="h2 contact-name">{SITE.nameEn}</h2>
        <p class="lead contact-line">{t('home.contact.line')}</p>
        <a href={localizedPath(lang, '/about')} class="link-arrow contact-more">
          {t('home.contact.more')}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="contact-links">
        <ContactLinks lang={lang} variant="inline" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 82vh, not 100vh: the first screen should hand the eye on to the work rather
     than insisting on filling itself. The copy sits in the left 46%; the rest
     belongs to the canvas. */
  .hero {
    min-height: 82vh;
    display: flex;
    align-items: center;
    padding-block: clamp(2.5rem, 6vh, 5rem);
  }

  .hero-copy {
    width: min(100%, 46%);
    max-width: 38rem;
  }

  @media (max-width: 900px) {
    .hero-copy {
      width: 100%;
      max-width: 34rem;
    }
  }

  .hero-title {
    margin-top: 1rem;
  }

  .hero-sub {
    margin-top: 0.875rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .hero-statement {
    margin-top: 1.5rem;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.38;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }

  .hero-support {
    margin-top: 1.125rem;
    max-width: 42ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* No surface, no border, no card: the closing band is part of the page, and a
     large box here would cut the scientific canvas in half. */
  .contact-band {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .contact-band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .contact-name {
    margin-top: 0.75rem;
  }

  .contact-line {
    margin-top: 0.5rem;
    max-width: 40ch;
  }

  .contact-more {
    display: inline-flex;
    margin-top: 1.25rem;
  }

  .contact-links {
    padding-top: 0.25rem;
  }
</style>
