---
/**
 * Homepage (English) — v1.6: reduction.
 *
 * The locale mirror of /zh/. Six blocks, each answering a different question:
 * who are you, what have you built, how do you read a problem, what are you
 * thinking about now, how do I find out more — then the footer.
 *
 * See `src/pages/zh/index.astro` for the full list of what was removed and
 * where each piece moved. Both locales carry the same structure on purpose: a
 * visitor who switches language must not land in a different information
 * architecture.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import HeroSystem from '../components/HeroSystem.astro';
import MathematicsBiologyAI from '../components/MathematicsBiologyAI.astro';
import ResearchNotesPreview from '../components/ResearchNotesPreview.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { SITE } from '../config/site';
import { useT, localizedPath } from '../i18n/ui';
import { getFeaturedProjects, projectsHref } from '../lib/projects';
import { personSchema } from '../data/profile';

const lang = 'en' as const;
const t = useT(lang);

/** Four, not five. PDIG and TaiYi keep full pages under /projects. */
const featured = await getFeaturedProjects(lang, 4);

const path = '/';
const enPath = '/';
const zhPath = '/zh/';

const personLd = personSchema(lang);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${SITE.nameEn} — Personal AI Lab`,
  url: SITE.url,
  inLanguage: 'en',
  description: SITE.description.en,
  author: { '@type': 'Person', name: SITE.nameEn },
};
---

<BaseLayout
  title={`${SITE.nameEn} — Personal AI Lab`}
  description={SITE.description.en}
  lang={lang}
  path={path}
  enPath={enPath}
  zhPath={zhPath}
  ogImage="/og/home.png"
  type="profile"
  jsonLd={[personLd, websiteLd]}
>
  <!-- ───────────────────────────── HERO ──────────────────────────────── -->
  <section class="shell hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t('hero.eyebrow')}</p>
        <h1 class="display hero-title">{t('hero.title')}</h1>
        <p class="hero-sub">{t('hero.subtitle')}</p>
        <p class="hero-statement">{t('hero.statement')}</p>
        <p class="lead hero-support">{t('hero.support')}</p>

        <div class="hero-actions">
          <a href={projectsHref(lang)} class="btn btn-primary">{t('hero.cta.work')}</a>
          <a href={SITE.github} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
            {t('hero.cta.github')}
          </a>
          <a href={localizedPath(lang, '/resume')} class="btn btn-outline">
            {t('hero.cta.resume')}
          </a>
        </div>
      </div>

      <div class="hero-figure">
        <div class="hero-field field-grid">
          <HeroSystem label={t('a11y.heroField')} />
        </div>
      </div>
    </div>

    <div class="hero-capabilities">
      <p class="mono">{t('hero.capabilities')}</p>
      <ul>
        {SITE.focusAreas.map((area) => <li>{area.en}</li>)}
      </ul>
    </div>
  </section>

  <!-- ───────────────────────── SELECTED WORK ─────────────────────────── -->
  <section class="shell section" id="work">
    <SectionHeading
      eyebrow={t('work.eyebrow')}
      title={t('work.title')}
      lead={t('work.lead')}
      href={projectsHref(lang)}
      linkLabel={t('work.all')}
    />

    <div class="showcase-list">
      {featured.map((project, i) => <ProjectShowcase project={project} lang={lang} index={i} />)}
    </div>
  </section>

  <!-- ──────────────────── MATHEMATICS × BIOLOGY × AI ─────────────────── -->
  <MathematicsBiologyAI lang={lang} />

  <!-- ───────────────────────── RESEARCH & NOTES ──────────────────────── -->
  <ResearchNotesPreview lang={lang} />

  <!-- ───────────────────────── ABOUT / CONTACT ───────────────────────── -->
  <section class="shell section-tight" id="contact">
    <div class="contact-band">
      <div class="contact-copy">
        <p class="eyebrow">{t('home.contact.eyebrow')}</p>
        <h2 class="h2 contact-name">{SITE.nameEn}</h2>
        <p class="lead contact-line">{t('home.contact.line')}</p>
        <a href={localizedPath(lang, '/about')} class="link-arrow contact-more">
          {t('home.contact.more')}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="contact-links">
        <ContactLinks lang={lang} variant="inline" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
    }
  }

  .hero-title {
    margin-top: 1.25rem;
  }

  .hero-sub {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.4vw, 0.9375rem);
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .hero-statement {
    margin-top: 1.75rem;
    font-size: clamp(1.25rem, 2.4vw, 1.75rem);
    line-height: 1.38;
    letter-spacing: -0.02em;
    max-width: 26ch;
  }

  .hero-support {
    margin-top: 1.25rem;
    max-width: 44ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .hero-figure {
    display: none;
  }

  .hero-field {
    padding: clamp(0.75rem, 2vw, 1.5rem);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  @media (min-width: 900px) {
    .hero-figure {
      display: block;
    }
  }

  .hero-capabilities {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero-capabilities ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.5rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .hero-capabilities li {
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .showcase-list {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 6rem);
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* No surface, no border, no card: the closing band is part of the page, and
     a large white box here would cut the scientific canvas in half — which is
     the same mistake the old footer made in black. */
  .contact-band {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .contact-band {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
    }
  }

  .contact-name {
    margin-top: 0.75rem;
  }

  .contact-line {
    margin-top: 0.5rem;
    max-width: 40ch;
  }

  .contact-more {
    display: inline-flex;
    margin-top: 1.25rem;
  }

  .contact-links {
    padding-top: 0.25rem;
  }
</style>
